function SpeedA(p: player, getFrom: location, getTo: location):
	#{_P} = "contribe" or "Mauryzio"
	difference between {lastteleport::%{_p}%} and now >= 1 second
	set {_x} to x coord of {_getto} - x coord of {_getfrom}
	set {_z} to z coord of {_getto} - z coord of {_getfrom}
	set {_gt} to true if Ground({_p}) is true
	set {_gt} to false if Ground({_p}) is false
	set {_groundtest} to true if {_gt} = {Ground::%{_p}%}
	set {_groundtest} to false if {_gt} != {Ground::%{_p}%}
	set {Ground::%{_p}%} to true if Ground({_p}) is true
	set {Ground::%{_p}%} to false if Ground({_p}) is false
	set {_offset} to hypot2({_x}, {_z})
	set {_diff} to difference between {_offset} and {PreviousSpeed::%{_p}%} * 0.91
	set {_diff} to abs({_diff})
	stop if onStairs({_p}) is true
	stop if NearHalf({_p}) is true
	set {vartest2::%{_p}%} to 0 if {vartest2::%{_p}%} is not set
	set {vartest2::%{_p}%} to {_diff} if {_diff} > {vartest2::%{_p}%}
	#broadcast "&c&lDEBUG &8--> &a%{_p}% &7/ &a%{_offset}% &7/ &a%{vartest2::%{_p}%}% &7/ &a%{_diff}% &7/ &a%{_groundtest}%"
	set {PreviousSpeed::%{_p}%} to {_offset}
	if {_diff} is between 0.188 and 0.199:
		# terrible way to change sprint jump falses
		#removeThreshold({_p}, "Speed (friction)", 4)
	if {_diff} >= 0.29:
		{_groundtest} = true
		alert({_p}, "Speed", "Experimental-A", "Larkus") if addThreshold({_p}, "Speed (friction)", 1, 2, true) is true


function SpeedB(p: player, getFrom: location, getTo: location):
	set {_debug} to distance between {_getfrom} and {_getto}
	set {_X} to x coord of {_getTo} - x coord of {_getFrom}
	set {_Z} to z coord of {_getTo} - z coord of {_getFrom}
	set {_y} to y coord of {_getTo} - y coord of {_getFrom}
	set {_offset} to hypot2({_x}, {_z})
	set {_value} to 0.38
	set {vartest::%{_p}%} to 0 if {vartest::%{_p}%} is not set
	set {vartest::%{_p}%} to {_offset} if {_offset} > {vartest::%{_p}%}
	if {_p} is on ground:
		stop if onStairs({_p}) is true
		stop if NearHalf({_p}) is true
		set {_value} to 0.18
		stop if difference between {L2P::SpeedA::LastUnderBlock::%{_p}%} and now <= 2 seconds
	add 0.12 to {_value} if difference between {L2P::SpeedA::LastUnderBlock::%{_p}%} and now <= 2 seconds
	if {debugv::*} contains {_p}:
		send "&c&lDEBUG &8--> &a%{_p}% &7/ &a%{_offset}% &7/ &a%{vartest::%{_p}%}% &7/&a %{_y}% &7/ &a%{_value}%" to {debugv::*}
	if {_offset} > {_value}:
		alert({_p}, "Speed", "B &7(%{_offset}%/%{_value}%) (%difference between {L2P::SpeedA::LastUnderBlock::%{_p}%} and now%)", "Larkus") if addThreshold({_p}, "Speed (speedlimit)", 1, 2, true) is true	

function SpeedBB(p: player, getFrom: location, getTo: location):
	stop
	if "%{_packet}%" contains "PacketPlayInEntityAction":
		if "%{_packet}.animation%" contains "STOP_SPRINTING":
			set {SprintState::%{_p}%} to 1
		else if "%{_packet}.animation%" contains "START_SPRINTING":
			set {SprintState::%{_p}%} to 2
	set {_debug} to distance between {_getfrom} and {_getto}
	set {_X} to x coord of {_getTo} - x coord of {_getFrom}
	set {_Z} to z coord of {_getTo} - z coord of {_getFrom}
	set {_y} to y coord of {_getTo} - y coord of {_getFrom}
	set {_offset} to hypot2({_x}, {_z})
	set {_value} to 0.38
	set {vartest::%{_p}%} to 0 if {vartest::%{_p}%} is not set
	set {vartest::%{_p}%} to {_offset} if {_offset} > {vartest::%{_p}%}
	if {_p} is on ground:
		stop if onStairs({_p}) is true
		stop if NearHalf({_p}) is true
		set {_value} to 0.18
		stop if difference between {L2P::SpeedA::LastUnderBlock::%{_p}%} and now <= 2 seconds
	add 0.12 to {_value} if difference between {L2P::SpeedA::LastUnderBlock::%{_p}%} and now <= 2 seconds
	if {debugv::*} contains {_p}:
		send "&c&lDEBUG &8--> &a%{_p}% &7/ &a%{_offset}% &7/ &a%{vartest::%{_p}%}% &7/&a %{_y}% &7/ &a%{_value}%" to {debugv::*}
	if {_offset} > {_value}:
		alert({_p}, "Speed", "B &7(%{_offset}%/%{_value}%) (%difference between {L2P::SpeedA::LastUnderBlock::%{_p}%} and now%)", "Larkus") if addThreshold({_p}, "Speed (speedlimit)", 1, 2, true) is true	

on any move:
	set {_p} to player
	block at player is not water
	block below player is not water
	if {_p}'s gamemode is spectator:
		stop
	if {_p}'s gamemode is creative:
		stop
	if {_p}'s gamemode is survival:
		if {_p} is flying:
			stop
	IsNormal({_p}) is true
	difference between {lasttogglefly::%{_p}%} and now >= 10 seconds
	set {_x} to x coord of {L2P.getTo::%{_p}%} - x coord of {L2P.getFrom::%{_p}%}
	set {_z} to z coord of {L2P.getTo::%{_p}%} - z coord of {L2P.getFrom::%{_p}%}
	hypot({_x}, {_z})
	set {_LastDistY} to {Lite.FlightAA.DistY::%{_p}%}
	set {Lite.FlightAA.DistY::%{_p}%} to y coord of {L2P.getFrom::%{_p}%} - y coord of {L2P.getTo::%{_p}%}
	set {_diff} to -0.07840000152587 + difference between {_LastDistY} * 0.9800000190734863 and {Lite.FlightAA.DistY::%{_p}%}
	if abs({_diff}) > 0.00000001:
		if addThreshold({_p}, "Motion (Test)", 1, 20, true) is true:
			alert(player, "Motion", "Test", "Larkus")
	resetThreshold({_p}, "Motion (Test)") if player is on ground
	resetThreshold({_p}, "Motion (Test)") if abs({_diff}) <= 0.00000001 
	
function SpeedAL2P(p: player, getFrom: location, getTo: location):
	send "test2" to {debu::*}
	if {_p} is on ground:
		{L2P::SpeedA::groundTime::%{_p}%} is not set
		delete {L2P::SpeedA::airTime::%{_p}%}
		set {L2P::SpeedA::groundTime::%{_p}%} to now
	if {_p} is not on ground:
		{L2P::SpeedA::airTime::%{_p}%} is not set
		delete {L2P::SpeedA::groundTime::%{_p}%}
		set {L2P::SpeedA::airTime::%{_p}%} to now
	if underBlock({_p}) is true:
		set {L2P::SpeedA::LastUnderBlock::%{_p}%} to now
	if onIce({_p}) is true:
		set {L2P::SpeedA::LastOnIce::%{_p}%} to now
	#set {_offset} to hypot(x coord of {_getTo} - x coord of {_getFrom}, z coord of {_getTo} - z coord of {_getFrom})
	set {_x} to x coord of {_getto} - x coord of {_getfrom}
	set {_z} to z coord of {_getto} - z coord of {_getfrom}
	#broadcast "%{_x}% %{_z}% %x coord of {_getTo}% %x coord of {_getFrom}% %{_p}%"
	set {_offset} to hypot({_x}, {_z})
	set {_limit} to 0.55
	set {_limit} to 0.36 if difference between {L2P::SpeedA::airTime::%{_p}%} and now > 0.05 seconds
	set {_limit} to 0.30 if difference between {L2P::SpeedA::groundTime::%{_p}%} and now > 0.2 seconds
	set {_speedx} to 0.02
	set {_speedx} to 0.06 if difference between {L2P::SpeedA::groundTime::%{_p}%} and now > 0.2 seconds
	set {_limit} to 0.65 if onStairs({_p}) is true
	set {_limit} to 0.9 if difference between {L2P::SpeedA::LastUnderBlock::%{_p}%} and now < 0.7 seconds
	if difference between {L2P::SpeedA::LastOnIce::%{_p}%} and now < 1 seconds:
		set {_limit} to 0.35 if difference between {L2P::SpeedA::groundTime::%{_p}%} and now > 0.2 seconds
		set {_limit} to 0.65 if difference between {L2P::SpeedA::airTime::%{_p}%} and now > 0.05 seconds
		set {_limit} to 1.3 if difference between {L2P::SpeedA::LastUnderBlock::%{_p}%} and now < 0.7 seconds
	set {_limit} to 1.3 if difference between now and {Lite.LastDamage::%{_p}%} < 0.75 seconds
	set {_speed} to getTier({_p}, "SPEED")
	set {_walk} to (round(walk speed of {_p} * 100)) / 100
	set {_limit} to {_limit} + ({_walk} * 10 * 0.33) if {_walk} > 0.2
	set {_limit} to {_limit} + {_speed} * {_speedx}
	if {_offset} > {_limit} * 1.75:
		alert({_p}, "Speed", "L2P-A", "Larkus") if addThreshold({_p}, "Speed (A)", 10, 100, true) is true
	if {_offset} > {_limit}:
		alert({_p}, "Speed", "L2P-A", "Larkus") if addThreshold({_p}, "Speed (A)", 10, 130, true) is true
	if {_offset} <= {_limit}:
		removeThreshold({_p}, "Speed (A)", 1)
	if {_limit} = 0.45:
		removeThreshold({_p}, "Speed (A)", 1)

function SpeedBL2P(p: player, getFrom: location, getTo: location):
	difference between {Lite.LastDamage::%{_p}%} and now > 0.7 seconds
	set {L2P::SpeedB::lastdeltaX::%{_p}%} to {L2P::SpeedB::deltaX::%{_p}%}
	set {L2P::SpeedB::lastdeltaZ::%{_p}%} to {L2P::SpeedB::deltaZ::%{_p}%}
	set {L2P::SpeedB::lastdeltaY::%{_p}%} to {L2P::SpeedB::deltaY::%{_p}%}
	if {L2P::SpeedB::lastdeltaY::%{_p}%} > 0:
		if {L2P::SpeedB::lastdeltaY::%{_p}%} < 0.002357499729924939:
			block at {_p} is not water
			block below {_p} is not water
			alert({_p}, "Motion", "C", "Larkus")
	set {L2P::SpeedB::deltaX::%{_p}%} to x coord of {_getFrom} - x coord of {_getTo}
	set {L2P::SpeedB::deltaZ::%{_p}%} to z coord of {_getFrom} - z coord of {_getTo}
	set {L2P::SpeedB::deltaY::%{_p}%} to y coord of {_getFrom} - y coord of {_getTo}
	if Ground({_p}) is false:
		if {L2P::SpeedB::lastdeltaX::%{_p}%} > 0.03:
			set {_flagged} to true if {L2P::SpeedB::deltaX::%{_p}%} < -0.03
		if {L2P::SpeedB::lastdeltaX::%{_p}%} < -0.03:
			set {_flagged} to true if {L2P::SpeedB::deltaX::%{_p}%} > 0.03
		if {L2P::SpeedB::lastdeltaZ::%{_p}%} > 0.03:
			set {_flagged} to true if {L2P::SpeedB::deltaZ::%{_p}%} < -0.03
		if {L2P::SpeedB::lastdeltaZ::%{_p}%} < -0.03:
			set {_flagged} to true if {L2P::SpeedB::deltaZ::%{_p}%} > 0.03
	if underBlock({_p}) is false:
		if {L2P::SpeedB::lastdeltaY::%{_p}%} > 0.015:
			set {_flagged} to true if {L2P::SpeedB::deltaY::%{_p}%} < -0.015
		if {L2P::SpeedB::lastdeltaY::%{_p}%} < -0.015:
			set {_flagged} to true if {L2P::SpeedB::deltaY::%{_p}%} > 0.015
	if block at {_p} = ladder:
		stop
	if block below {_p} = ladder:
		stop
	if {_flagged} is true:
		alert({_p}, "Speed", "A", "Larkus") if addThreshold({_p}, "Speed (B)", 10, 30, true) is true
		stop
	removeThreshold({_p}, "Speed (B)", 4)
on damage:
	damage cause is attack
	set {L2P::LastDamaged::%victim%} to now
function SpeedTestL2P(p: player, getFrom: location, getTo: location):
	difference between {L2P::LastDamaged::%{_p}%} and now > 0.7 seconds
	set {_distX} to x coord of {_getTo} - x coord of {_getFrom}
	set {_distZ} to z coord of {_getTo} - z coord of {_getFrom}
	set {L2P::SpeedC::LastDist::%{_p}%} to {L2P::SpeedC::Dist::%{_p}%}
	set {L2P::SpeedC::Dist::%{_p}%} to ({_distX} * {_distX}) + ({_distZ} * {_distZ})
	set {L2P::SpeedC::Dist::%{_p}%} to {L2P::SpeedC::Dist::%{_p}%}
	set {_shifted} to {L2P::SpeedC::LastDist::%{_p}%} * 0.91
	set {_equalness} to ({L2P::SpeedC::Dist::%{_p}%} - {_shifted}) * 137
	Ground({_p}) is false
	set {_diff} to angleDiff(yaw of {_getFrom}, yaw of {_getTo})
	set {_max} to 1.01
	if abs({_diff}) > 0.5:
		abs({_diff}) < 7
		set {_max} to 1.03
	if {_equalness} >= {_max}:
		alert({_p}, "Motion", "B", "Larkus") if addThreshold({_p}, "Speed (C)", 2, 16, true) is true
		stop
	removeThreshold({_p}, "Speed (C)", 5)
	


function SpeedCL2P(p: player, getFrom: location, getTo: location):
	difference between {L2P::LastDamaged::%{_p}%} and now > 1 seconds
	set {L2P.Speed.lastdeltaX::%{_p}%} to {L2P.Speed.deltaX::%{_p}%}
	set {L2P.Speed.lastdeltaZ::%{_p}%} to {L2P.Speed.deltaZ::%{_p}%}
	set {L2P.Speed.deltaX::%{_p}%} to x coord of {_getFrom} - x coord of {_getTo}
	set {L2P.Speed.deltaZ::%{_p}%} to z coord of {_getFrom} - z coord of {_getTo}
	atBlock({_p}) is false
	Ground({_p}) is false
	if {L2P.Speed.lastdeltaX::%{_p}%} > 0.03:
		set {_flagged} to true if {L2P.Speed.deltaX::%{_p}%} < -0.03
	if {L2P.Speed.lastdeltaX::%{_p}%} < -0.03:
		set {_flagged} to true if {L2P.Speed.deltaX::%{_p}%} > 0.03
	if {L2P.Speed.lastdeltaZ::%{_p}%} > 0.03:
		set {_flagged} to true if {L2P.Speed.deltaZ::%{_p}%} < -0.03
	if {L2P.Speed.lastdeltaZ::%{_p}%} < -0.03:
		set {_flagged} to true if {L2P.Speed.deltaZ::%{_p}%} > 0.03
	{_flagged} is true
	alert({_p}, "Speed", "L2P-C", "Larkus") if addThreshold({_p}, "Speed (C)", 5, 15, true) is true

import:
    java.util.HashMap

on join:
    set {BoltData::%player%} to new HashMap()
    {BoltData::%player%}.put("Player", player)
on right click:
	if player's held item is a sword:
#		send "%difference between {testautoblock::%player%} and now%" to player
		set {testautoblock::%player%} to now
		target player is set
		distance between player and target player <= 4
		difference between {Packet::UseEntity::%player%} and now is more than 1 second
		alert(player, "Aura", "C", "Larkus")

on damage:
	attacker is player
	victim is player
	"%damage cause%" != "projectile" or "potion" or "enderpearl"
	attacker's gamemode is not creative
	if difference between now and {testautoblock::%attacker%} is less than 0.04 seconds:
		alert(attacker, "Aura", "A", "Larkus")
		
every 5 ticks:
	set {Liters.Checks::*} to "Motion Freq"
	loop {Liters.Checks::*}:
		delete {L2P.VL.%loop-value%::*}
		delete {L2P.Threshold.%loop-value%::*}
on damage:
	if difference between {testautoblock::%attacker%} and now is less than 1 second:
		send "1 %difference between {Packet::UseEntity::%attacker%} and now%" to attacker
		if difference between {Packet::UseEntity::%attacker%} and now is more than 1 second:
			alert(attacker, "Aura", "B", "Larkus")
			
on damage of player:
	attacker is a player
	projectile doesn't exist
	if {lasttogglefly::%attacker%} is not set:
		set {lasttogglefly::%attacker%} to now
	difference between {lasttogglefly::%attacker%} and now >= 4 seconds
	set {_reach} to distance between attacker and victim
	difference between y coord of victim and y coord of attacker is not above 2
	if attacker doesn't have speed:
		if {_reach} is greater than 3.43:
			{Larkus::PL::%attacker's uuid%} is not attacker's location
			add 1 to {Larkus::PLC::%attacker's uuid%}
			set {Larkus::PL::%attacker's uuid%} to attacker's location
			if {Larkus::PLC::%attacker's uuid%} >= 6:
				alert(attacker, "Reach", "A", "Larkus")
		else:
			delete {Larkus::PLC::%attacker's uuid%}			


on left click:
	if {lastbreak::%player%} is not set:
		set {lastbreak::%player%} to now
	difference between {lastbreak::%player%} and now > 1 second
	if target block is set:
		if distance between target block and player < 5:
			stop
	target block is not wheat
	target block is not sugar cane
	target block is not torch
	target block is not redstone torch
	target block is not grass
	target block is not lily pad
	target block is not flower pot
	target block is not redstone
	add 1 to {cps::%player's uuid%}
on break:
	set {lastbreak::%player%} to now
every 1 second in world "world":
	loop all players:
		{cps::%loop-player's uuid%} is set
		{cps::%loop-player's uuid%} is not 0
		if {cps::%loop-player's uuid%} >= 20:
			difference between {lastbreak::%loop-player%} and now > 1 second
			set {lastcps::%loop-player's uuid%} to {cps::%loop-player's uuid%}
			alert(loop-player, "Autoclicker", "A", "Larkus")
		if {cps::%loop-player's uuid%} = {lastcps::%loop-player's uuid%}:
			add 1 to {clickb::%loop-player%}
		alert(loop-player, "Autoclicker", "B", "Larkus") if {clickb::%loop-player%} = 3
		delete {clickb::%loop-player%} if {clickb::%loop-player%} >= 3
		clear {cps::%loop-player's uuid%}

on packet:
	broadcast "test"
	{CancelCheck::%player%} is 1
	if "%packet%" contains "UseEntity":
		set {Packet::UseEntity::%player%} to now	
	if "%packet%" contains "Flying":
#		add 1 to {PF::%player%} if addThreshold(player, "Motion Freq", 1, 20, true) is true
#		if {PF::%player%} >= 5:
#			delete {PF::%player%}
#			alert(player, "Packet", "A", "Larkus")
		{BoltData::%player%}.put("prevGround", {BoltData::%player%}.get("Ground"))
		{BoltData::%player%}.put("Ground", packet.b())
		broadcast "tru3"
		if "%packet%" contains "Position":
			
			set {_prevX} to {BoltData::%player%}.get("x")
			set {_prevY} to {BoltData::%player%}.get("y")
			set {_prevZ} to {BoltData::%player%}.get("z")
			
			set {_x} to packet.x
			set {_y} to packet.y
			set {_z} to packet.z
			
			set {_prevDeltaX} to {BoltData::%player%}.get("deltaX")
			set {_prevDeltaY} to {BoltData::%player%}.get("deltaY")
			set {_prevDeltaZ} to {BoltData::%player%}.get("deltaZ")
			set {_prevDeltaXZ} to {BoltData::%player%}.get("deltaXZ")
			
			set {_deltaX} to {_x} - {_prevX}
			set {_deltaY} to {_y} - {_prevY}
			set {_deltaZ} to {_z} - {_prevZ}
			set {_deltaXZ} to sqrt({_deltaX}^2 + {_deltaZ}^2)
			
			{BoltData::%player%}.put("prevX", {_prevX})
			{BoltData::%player%}.put("prevY", {_prevY})
			{BoltData::%player%}.put("prevZ", {_prevZ})
			
			{BoltData::%player%}.put("x", {_x})
			{BoltData::%player%}.put("y", {_y})
			{BoltData::%player%}.put("z", {_z})
			
			{BoltData::%player%}.put("prevDeltaX", {_prevDeltaX})
			{BoltData::%player%}.put("prevDeltaY", {_prevDeltaY})
			{BoltData::%player%}.put("prevDeltaZ", {_prevDeltaZ})
			{BoltData::%player%}.put("prevDeltaXZ", {_prevDeltaXZ})
			
			{BoltData::%player%}.put("deltaX", {_deltaX})
			{BoltData::%player%}.put("deltaY", {_deltaY})
			{BoltData::%player%}.put("deltaZ", {_deltaZ})
			{BoltData::%player%}.put("deltaXZ", {_deltaXZ})
		broadcast "true2"
		IsNormal(player) is true
		broadcast "true"
		SpeedC({BoltData::%player%}, packet)
		MotionA({BoltData::%player%}, packet)
		FlightA(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		BadPacketsA(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})

function serverGround(l: location) :: boolean:
    remove 1 / 64 from y coord of {_l}
    if block 0.4 meters north west of {_l} is air:
        block 0.4 meters north east of {_l} is air
        block 0.4 meters south west of {_l} is air
        block 0.4 meters south east of {_l} is air
        if mod((y coord of {_l} + (1 / 64)), 1/2) = 0:
            remove 32 / 64 from y coord of {_l}
            if block 0.4 meters north west of {_l} is air:
                block 0.4 meters north east of {_l} is air
                block 0.4 meters south west of {_l} is air
                block 0.4 meters south east of {_l} is air
                return false
            return true
        return false
    return true

function mathGround(l: location) :: boolean:
    return true if mod(y coord of {_l}, 1 / 64) = 0
    return false

function rayTrace(l: location, ol: location) :: boolean:
	set {_v} to vector from yaw {_l}'s yaw and pitch {_l}'s pitch
	loop 300 times:
		set {_length} to {_length} + 0.01
		set standard length of {_v} to {_length}
		set {_ray} to {_l} ~ {_v}
		if isInHitBox({_ol}, {_ray}) = true:
			return true
	return false

function eyeLocation(l: location) :: location:
	add 1.62 to y coord of {_l}
	return {_l}

function viewedLocation(l: location) :: location:
	if x coord of {_l} < 0:
		set x coord of {_l} to ceil(x coord of {_l} * 32) / 32
	else:
		set x coord of {_l} to floor(x coord of {_l} * 32) / 32
	if y coord of {_l} < 0:
		set y coord of {_l} to ceil(y coord of {_l} * 32) / 32
	else:
		set y coord of {_l} to floor(y coord of {_l} * 32) / 32
	if z coord of {_l} < 0:
		set z coord of {_l} to ceil(z coord of {_l} * 32) / 32
	else:
		set z coord of {_l} to floor(z coord of {_l} * 32) / 32
	return {_l}

function getIdPlayer(n: number) :: player:
	set {_players::*} to (all players where [player input.getEntityId() = {_n}])
	return {_players::1}

function isInHitBox(l: location, ol: location) :: boolean:
	if x coord of {_ol} < x coord of {_l} + 0.405:
		if x coord of {_ol} > x coord of {_l} - 0.405:
			if z coord of {_ol} < z coord of {_l} + 0.405:
				if z coord of {_ol} > z coord of {_l} - 0.405:
					if y coord of {_ol} < y coord of {_l} + 1.905:
						if y coord of {_ol} > y coord of {_l} - 0.105:
							return true
	return false

function MotionA(data: object, packet: object):
	if "%{_packet}%" contains "Flying":
		set {_packet} to "Fly"
	set {_player} to {_data}.get("Player")
	loop blocks in radius 3 of {_player}:
		if loop-block = water or stair or slab or lava:
			set {MotionAStop::%{_player}%} to now
	set {MotionAStop::%{_player}%} to now if {MotionAStop::%{_player}%} is not set
	set {MotionAStop::%{_player}%} to now if block below {_player} is slab or stair or water or lava
	difference between {MotionAStop::%{_player}%} and now > 1.5 seconds
	difference between {L2P::SpeedA::LastUnderBlock::%{_player}%} and now > 1.5 seconds
	difference between {L2P::LastDamaged::%{_player}%} and now > 1.5 seconds
	set {_deltaY1} to {_data}.get("prevDeltaY")
	set {_deltaY2} to {_data}.get("deltaY")
	block at {_player} is not water
	block below {_player} is not water or slab or stair
	if {LCJ::%{_player}%} is not set:
		set {LCJ::%{_player}%} to now
	{_deltaY1} is not 0
	{_deltaY1} is not below 0
	set {DeltaYT::%{_player}%} to 0 if {DeltaYT::%{_player}%} is not set
	set {DeltaYT::%{_player}%} to {_deltaY1} if {_deltaY1} > {DeltaYT::%{_player}%}
	#broadcast "%{_DeltaY1}% %{_player}% DY"
	#broadcast "%{DeltaYT::%{_player}%}% %{_player}% HDY"
	if {_deltaY1} is between 0.41 and 0.43:
		set {LCJ::%{_player}%} to now
	if difference between {LCJ::%{_player}%} and now >= 4 seconds:
		alert({_player}, "Motion", "A", "Larkus") if addThreshold({_player}, "Motion (ATest2)", 1, 3, true) is true
	if {_deltaY1} >= 0.5:
		alert({_player}, "Motion", "AA %{_deltaY1}%", "Larkus") if addThreshold({_player}, "Motion (ATest3)", 1, 3, true) is true

function SpeedC(data: object, packet: object):
	if {_data}.get("prevGround") = true: 
		set {_1} to true
	if {_data}.get("Ground") = true: 
		set {_2} to true
	if {_data}.get("prevGround") = false: 
		set {_1} to false
	if {_data}.get("Ground") = false: 
		set {_2} to false
	set {_player} to {_data}.get("Player")
#	broadcast "%{_player}% %{_1}% %{_2}%"
	if {L2P::LastDamaged::%{_player}%} is not set:
		set {L2P::LastDamaged::%{_player}%} to now
	difference between {L2P::LastDamaged::%{_player}%} and now > 2 seconds
	if "%{_packet}%" contains "Flying":
		if "%{_packet}%" contains "Position" or "Look":
			if {_data}.get("SpeedC-PosssibleFalse") = false:
				if {_data}.get("prevGround") = false:
                    
					set {_prevDeltaXZ} to {_data}.get("prevDeltaXZ")
                    
					set {_deltaXZ} to {_data}.get("deltaXZ")
                    
					set {_predicted} to (({_prevDeltaXZ} * 0.91) + 0.026) - {_deltaXZ}
					if {_predicted} < 0:
						alert({_player}, "Speed", "L2P-C", "Larkus") if addThreshold({_player}, "Speed (TestNew)", 1, 7, true) is true
                
                
			else:
				{_data}.put("SpeedC-PosssibleFalse", false)
		else:
			{_data}.put("SpeedC-PosssibleFalse", true)
    
		
function BadPacketsA(p: player, getFrom: location, getTo: location):
    set {_check} to "Bad Packets (A)"
    set {_description} to "Sent move packet too fast"
    # 1.03 Timer Detection
    removeThreshold({_p}, {_check}, 1)
    
    set {L2P::BadPacketsA::packetDelay::%{_p}%} to difference between now and {L2P::BadPacketsA::lastPacketTime::%{_p}%}
    set {L2P::BadPacketsA::lastPacketTime::%{_p}%} to now
    stop if {L2P::BadPacketsA::packetDelay::%{_p}%} < 0.01 seconds
    add 1 to {L2P::BadPacketsA::delayBalance::%{_p}%} if {L2P::BadPacketsA::packetDelay::%{_p}%} <= 0.048 seconds
    remove 1 from {L2P::BadPacketsA::delayBalance::%{_p}%} if {L2P::BadPacketsA::packetDelay::%{_p}%} >= 0.052 seconds
    set {L2P::BadPacketsA::delayBalance::%{_p}%} to 0 if {L2P::BadPacketsA::delayBalance::%{_p}%} < 0
    set {_r} to 1 or 2
    if {_r} = 1:
        remove 1 from {L2P::BadPacketsA::delayBalance::%{_p}%} if {_p}'s ping >= 200
    {L2P::BadPacketsA::delayBalance::%{_p}%} >= 8
    set {_var} to {L2P::BadPacketsA::delayBalance::%{_p}%}
    set {L2P::BadPacketsA::delayBalance::%{_p}%} to 0
    set {L2P::BadPacketsA::delayFlag::%{_p}%} to difference between now and {L2P::BadPacketsA::lastFlag::%{_p}%}
    set {L2P::BadPacketsA::lastFlag::%{_p}%} to now
    {L2P::BadPacketsA::delayFlag::%{_p}%} < 1.5 seconds
    
    set {_info} to "%{L2P::BadPacketsA::packetDelay::%{_p}%}%"
    replace all " seconds" or " second" in {_info} with ""
    set {_info} to {_info} parsed as a number
    set {_info} to {_info} * 1000
    set {_predictedcheat} to (100 - {_info} * 2) + 1
    set {_info} to "%{_info}%ms/50ms - %{_predictedcheat}%%%"
    
    alert({_p}, "Timer", "L2P-B", "Larkus") if addThreshold({_p}, {_check}, 70, 100, false) is true
    #l2pDebug({_p}, {_check}, {_info})
function angleDiff(a: number, b: number) :: number:
    set {_dist} to abs({_a} - {_b})
    set {_dist} to {_dist} - 360 if {_dist} > 180
    return {_dist}
	
	
on break:
	player is not op
	stop
on place:
	player is not op
	stop
