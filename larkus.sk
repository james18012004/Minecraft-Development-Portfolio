options:
	prefix: &a&lLarkus &7»&a&o
	ver: 1.99
command valuelog [<player>]:
	permission: staff.*
	aliases: lv
	trigger:
		if arg is set:
			wait 5 ticks
			loop 15 times:
				add 1 to {_s}
				set {_y1} to y-coord of arg
				set {_z1} to z-coord of arg
				set {_x1} to x-coord of arg
				wait 1 tick
				set {_y2} to y-coord of arg
				set {_z2} to z-coord of arg
				set {_x2} to x-coord of arg
				send " VALUE SAMPLE %{_s}% %arg% Y: %difference between {_y1} and {_y2}% / Z: %difference between {_z1} and {_z2}% / X: %difference between {_x1} and {_x2}% "
		if arg is not set:
			wait 33 ticks
			loop 15 times:
				add 1 to {_s}
				set {_y1} to y-coord of player
				set {_z1} to z-coord of player
				set {_x1} to x-coord of player
				wait 1 tick
				set {_y2} to y-coord of player
				set {_z2} to z-coord of player
				set {_x2} to x-coord of player
				send " VALUE SAMPLE %{_s}% %arg% Y: %difference between {_y1} and {_y2}% / Z: %difference between {_z1} and {_z2}% / X: %difference between {_x1} and {_x2}% "

	
	
	

on join:
	delete {CancelCheck::%player%}
	wait 5 seconds
	set {CancelCheck::%player%} to 1
on command:
	player is op
	command contains "sk" or "skript" or "larkus" or "reload"
	loop all players:
		delete {CancelCheck::%loop-player%}
		wait 5 seconds
		set {CancelCheck::%loop-player%} to 1

on any move:
	{CancelCheck::%player%} is 1
	loop blocks in radius 2 of player:
		if loop-block is slime block or fence or cobweb or cobblestone wall or trapdoor or vine or ladder:
			set {lasttogglefly::%player%} to now
		if loop-block is water or lava:
			set {_liquid} to true
	set {L2P.getFrom::%player%} to {L2P.getTo::%player%}
	set {L2P.getTo::%player%} to player's location
	set {testmove::%player%} to now
	IsNormal(player) is true
#	broadcast "event is set off"	
	if difference between {Lite.LastDamage::%player%} and now >= 10 ticks:
		SpeedA(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		SpeedB(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		SpeedAL2P(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		SpeedBL2P(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		SpeedCL2P(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		SpeedTestL2P(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		BadPacketsA(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		FlightA(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		FlightL2P(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		FlightB(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%})
		#FlightOld(player, {L2P.getFrom::%player%}, {L2P.getTo::%player%}) if {_liquid} is not set
	NoFallA(player)
	JesusA(player)
	JesusB(player)



every 60 seconds:
	VLReset()

function VLReset():
	set {Lite.Checks::*} to "Speed (A)" and "Motion (ATest3)" and "Speed (test)" and "Speed (B)" and "Timer" and "Flight (A)" and "Flight (B)" and "Flight (C)" and "Speed (C)" and "Speed (D)" and "Bad Packets (A)" and "Speed (speedlimit)" and "Speed (friction)" and "Speed (test)" and "NoFall (B)" and "Speed (TestNew)" and "Motion (ATest2)"
	loop {Lite.Checks::*}:
		delete {L2P.VL.%loop-value%::*}
		delete {L2P.Threshold.%loop-value%::*}
	set {Larkus.Checks::*} to "A" and "AA" and "TA" and "FC" and "FL2P"
	loop {Larkus.Checks::*}:
		delete {L2PLarkus.%loop-value-2%::*}
		delete {Larkus::NoSlow::*}
on join:
	set {Lite.LastDamage::%player%} to now
	set {Lite.Alerts::%player%} to true if player has permission "staff.*"
on damage of player:
	damage cause is attack
	victim is not attacker
	set {Lite.LastDamage::%victim%} to now
every 5 minutes in "world":
	broadcast "&a&oThis server is protected by &a&lLarkusAC." in all worlds
	broadcast "&a&lLarkusAC&a&o &7»&a&o has banned a total of %{acbans}% hackers!" in all worlds
	wait 1 minute
	broadcast "&a&lLarkusAC&a&o &7» &c&oAny Clicking method that exceeds 16 cps is disallowed!"

function atBlock(p: player) :: boolean:
	set {_l} to location of {_p}
	loop 4 times:
		return true if block at {_l} is not air
		return true if block 0.3 meters north of {_l} is not air
		return true if block 0.3 meters south of {_l} is not air
		return true if block 0.3 meters east of {_l} is not air
		return true if block 0.3 meters west of {_l} is not air
		return true if block 0.3 meters north east of {_l} is not air
		return true if block 0.3 meters south west of {_l} is not air
		return true if block 0.3 meters south east of {_l} is not air
		return true if block 0.3 meters north west of {_l} is not air
		add 0.6 to y coord of {_l}
	return false
function Ground(p: player) :: boolean:
	set {_l} to location under {_p}
	return true if block at {_l} is not air
	return true if block 0.3 meters north of {_l} is not air
	return true if block 0.3 meters east of {_l} is not air
	return true if block 0.3 meters west of {_l} is not air
	return true if block 0.3 meters north east of {_l} is not air
	return true if block 0.3 meters south west of {_l} is not air
	return true if block 0.3 meters south east of {_l} is not air
	return true if block 0.3 meters north west of {_l} is not air
	set {_l} to location 0.49 meters under {_p}
	return true if block at {_l} is not air
	return true if block 0.3 meters north of {_l} is not air
	return true if block 0.3 meters south of {_l} is not air
	return true if block 0.3 meters east of {_l} is not air
	return true if block 0.3 meters west of {_l} is not air
	return true if block 0.3 meters north east of {_l} is not air
	return true if block 0.3 meters south west of {_l} is not air
	return true if block 0.3 meters south east of {_l} is not air
	return true if block 0.3 meters north west of {_l} is not air
	return false

function larkusalert(p: player, i: text, t: text, ver: text):
	if {alerts} = true:
		set {player} to {_p}
		set {cheat} to {_i}
		#send "Larkus *%{player}%* has just flagged for **%{cheat}%** Ping: %{player}'s ping%" to channel with id "763609924169105429" with "ElectrokMC Network"
		if {_ver} is "Larkus":
			if {lsalert} = false:
				{larkusalert} is not set
				send "{@prefix}&r &c%{player}% &a&ofailed &c&o%{cheat}% &7Type: &cL2P &7Ping: &c%{_p}'s ping%" to all players where [input has permission "staff.*"]
				send "{@prefix}&r &c%{player}% &a&ofailed &c&o%{cheat}% &7Type: &cL2P &7Ping: &c%{_p}'s ping%" to {lurk::*}
				set {larkusalert} to true
				wait 1 tick
				clear {larkusalert}
			if {lsalert} = true:
				broadcast "{@prefix}&r &c%{_p}% &a&ofailed &c&o%{_i}% &7Type: &c%{_t}% &7Ping: &c%{_p}'s ping%"
		if {_ver} is "LarkusReal":
			if {lsalert} = false:
				{larkusalert} is not set
				send "{@prefix}&r &c%{player}% &a&ofailed &c&o%{cheat}% &7Type: &cC &7Ping: &c%{_p}'s ping%" to all players where [input has permission "staff.*"]
				send "{@prefix}&r &c%{player}% &a&ofailed &c&o%{cheat}% &7Type: &cC &7Ping: &c%{_p}'s ping%" to {lurk::*}
				set {larkusalert} to true
				wait 1 tick
				clear {larkusalert}
			if {lsalert} = true:
				broadcast "{@prefix}&r &c%{_p}% &a&ofailed &c&o%{_i}% &7Type: &c%{_t}% &7Ping: &c%{_p}'s ping%"
