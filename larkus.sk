# Commands #

on damage:
	{larkus::testmode} = true
	heal victim
on connect:
	if {larkuslogs::%player%::*} is not set:
		set {larkuslogs::%player%::*} to "&aNo Logs Found"
# MISC
on flight toggle:
	set {anticheat::%uuid of player%::lastFlight} to now

on join:
	clear {anticheat::%uuid of player%::lastDistY}
	clear {anticheat::%uuid of player%::distY}
	clear {anticheat::%uuid of player%::lastYCoord}
	clear {anticheat::%uuid of player%::yCoord}
	clear {anticheat::%uuid of player%::accel}
	set {anticheat::%uuid of player%::lastFlight} to now
	set {anticheat::%uuid of player%::preventTime} to now
Function NoFallA(p: player):
	IsNormal({_p}) is true
	block under {_p} is air
	block under {_p} is not slime block or fence or cobblestone wall
	loop blocks in radius 2 of {_p}:
		if loop-block is slime block or fence or cobweb or cobblestone wall or trapdoor or vine or ladder:
			stop
	if isAirborne2({_p}):
		{_p} is on ground
		alert({_p}, "NoFall", "A", "Larkus")
		add 1 to {nofall::%{_p}%}
		if {nofall::%{_p}%} >= 5:
			autoban({_p}, "NoFall (A)")
# ANTI RELOAD FALSE ALERTS
on command:
	player is op
	if command contains "sk":
		send "&aLarkus is now disabled! &7(Anti-Reload)"
		set {alerts} to false
		loop 60 times:
			wait 1 tick
			loop all players:
				clearvar(loop-player)
				set {Lite.Checks::*} to "Speed (A)" and "Speed (B)" and "Timer" and "Flight (A)" and "Flight (B)" and "Flight (C)" and "Speed (C)" and "Speed (D)" and "Bad Packets (A)"
			loop {Lite.Checks::*}:
				delete {L2P.VL.%loop-value-2%::*}
				delete {L2P.Threshold.%loop-value-2%::*}
			set {Larkus.Checks::*} to "A" and "AA" and "TA" and "FC" and "FL2P"
			#loop {Larkus.Checks::*}:
				#delete {L2PLarkus.%loop-value%::*}
		wait 5 seconds
		set {alerts} to true
		send "&aLarkus is now enabled! &7(Anti-Reload)"

on damage:
	if projectile is set:
		set {lasttogglefly::%victim%} to now
on join:
	set {cancely::%player%} to now		
on join:
	set {lasttogglefly::%player%} to now
on flight toggle:
	set {lasttogglefly::%player%} to now

on join:
	if player has the permission "staff.*":
		wait 7 ticks
		remove player from {staffmsg::*}
		add player to {staffmsg::*}
		wait 7 ticks
		send "&aAlerts toggled on!"
every 3 minutes:
	loop all players:
		clearvar(loop-player)

function clearvar(p: player):
	loop all players:
		clear {reach::%loop-player's uuid%}
		clear {flightalerts::%loop-player's uuid%}
		clear {4reach::%loop-player's uuid%}
		clear {autoclick::%loop-player's uuid%}
		clear {nofall::%loop-player%}
		clear {reachc::%loop-player%}
		clear {speeda::*}
		clear {speedb::*}
		delete {yport::*}
		delete {nofallb::*}
		delete {nofallc::*}
# FUNCTIONS
function DisToGround(p: player) :: number:
	loop 256 times:
		if block loop-numbers below {_p} is not air:
			set {_A} to loop-numbers
			remove 1 from {_A}
			set {_D} to {_p}'s y-coord - {_A}
			set {_Cw} to abs({_D} - floor({_D}))
			add {_A} to {_Cw}
			return {_Cw}
			exit 1 loop
function isAirborne(p: player) :: boolean:
	loop all blocks in radius 2 around {_p}:
		if loop-block is not air:
			return false
	if block 2 under {_p} is air:
		return true
function blockcheck(p: player) :: boolean:
	set {_loc} to location of {_p}
	if block 1 west 1 north of {_loc} is air:
		if block 1 west 1 south of {_loc} is air:
			if block 1 east 1 north of {_loc} is air:
				if block 1 east 1 south of {_loc} is air:
					return false
	if block 1 west 1 north of {_loc} is not air:
		return true
		if block 1 west 1 south of {_loc} is not air:
			return true
			if block 1 east 1 north of {_loc} is not air:
				return true
				if block 1 east 1 south of {_loc} is not air:
					return true
		
function isAirborne2(p: player) :: boolean:
	loop all blocks in radius 5 around {_p}:
		if loop-block is not air:
			return false
	return true
function isAirborne3(p: player) :: boolean:
	loop all blocks in radius 1 around {_p}:
		if loop-block is not air:
			return false
	return true
function AboveBlock(p: Location, b: Item) :: boolean:
	set {_c} to block 0.1 meter below {_p}
	if block west {_c} is {_b}:
		if block north {_c} is {_b}:
			if block south {_c} is {_b}:
				if block east {_c} is {_b}:
					if block southwest {_c} is {_b}:
						if block northwest {_c} is {_b}:
							if block southeast {_c} is {_b}:
								if block northeast {_c} is {_b}:
									if {_c} is {_b}:
										return true

function isOnLadder(p: player) :: boolean:
	loop all blocks in radius 2 around {_p}:
		if loop-block is ladder:
			return true
	return false
function NearHalf(p: player) :: boolean:
    set {_halfBlocks::*} to any stairs, any slabs and any trapdoor and ladder
    set {_halfBlockY::*} to "19" and ".5"
    set {_playerYHalf} to the last 2 characters of "%y-coordinate of {_p}%"

    if {_halfBlocks::*} contains block at {_p}:
        if {_halfBlockY::*} contains {_playerYHalf}:
            return true
    else:
        loop blocks in radius 2 around location of {_p}:
            if {_halfBlocks::*} contains loop-block:
                if {_halfBlockY::*} contains {_playerYHalf}:
                    return true
    return false
on join:
	if player has the permission "staff.*":
		add player to {staffmsg::*}
on quit:
	loop 5 times:
		remove player from {staffmsg::*}


on join:
	if {lsalert} is not set:
		set {lsalert} to true
	if {autoban} is not set:
		set {autoban} to false
	if {kick} is not set:
		set {kick} to false

function autoban(p: player, hack: text):
	if {autoban} = true:
		if {staffmsg::*} does not contain {_p}:
			set {banr::%{_p}%} to {_hack}
			broadcast "{@prefix}&a i have removed &c%{_p}%&a from the server for Unfair Advantage"
			#broadcast "&aLarkus &fhas removed &a%{_p}% &ffrom the server!"
			add 1 to {acbans}
			set {_r} to 1 or 2 or 3
			if {_r} = 1:
				make console execute command "tempbanip %{_p}% 10d {@prefix} You were caught using a Hacked Client by LarkusAC"
			alert({_p}, "AutoBan", "%{_hack}%", "Larkus")
			make console execute command "tempban %{_p}% 10d {@prefix} You were caught using a Hacked Client by LarkusAC"
			set {player} to {_p}
			set {cheat} to {_hack}
			{player} is online
			set {autoban} to false
			wait 2 seconds
			set {autoban} to true
		if {staffmsg::*} contains {_p}:
			send "{@prefix}&r &ai tried to ban &c%{_p}%&a for %{_hack}%&a but failed!" to all players where [input has permission "staff.*"]
		if {lurk::*} contains {_p}:
			send "{@prefix}&r &ai tried to ban &c%{_p}%&a but they have lurk permissions!" to all players where [input has permission "staff.*"]
function kick(p: player, hack: text):
	if {kick} = true:
		if {staffmsg::*} does not contain {_p}:
			broadcast "{@prefix}&a i have kicked &c%{_p}%&a for cheating!"
			add 1 to {ackicks}
			make console execute command "kick %{_p}% {@prefix} you have been &ckicked&a for cheating"
			set {player} to {_p}
			set {cheat} to {_hack}
			{player} is online
			set {kick} to false
			wait 2 seconds
			set {kick} to true
		if {staffmsg::*} contains {_p}:
			send "{@prefix}&r &ai tried to kick &c%{_p}%&a for %{_hack}%&a but failed!" to all players where [input has permission "staff.*"]
function IsInAir(p: player) :: boolean:
	loop blocks in radius 3 of {_p}:
		if loop-block is not air:
			return false
	return true
function IsNotOnEdge(p: player) :: boolean:
	if block 1 down 1 east of {_p} is air:
		if block 1 down 1 west of {_p} is air:
			if block 1 down 1 south of {_p} is air:
				if block 1 down 1 north of {_p} is air:
					if block 1 down 1 north 1 east of {_p} is air:
						if block 1 down 1 north 1 west of {_p} is air:
							if block 1 down 1 south 1 west of {_p} is air:
								if block 1 down 1 south 1 east of {_p} is air:
									return true
	return false
function IsNormal(p: player) :: boolean:
	set {_uuid} to uuid of {_p}
	if {_p}'s gamemode is survival or adventure:
		if {_p} is not flying:
			{_p} does not have swiftness:
				return true
	return false
function isInWater(p: player) :: boolean:
	if block at {_p} is water:
		return true
	return false


function alert(p: player, i: text, t: text, ver: text):
	if {_p} is not "ThatOneTqnk":
		set {player} to {_p}
		set {cheat} to {_i}
		add "&c%{_p}% &a&ofailed &c&o%{_i}% &7Type: &c%{_t}% &7Ping: &c%{_p}'s ping%" to {larkuslogs::%{_p}%::*}
		add "{@prefix}&r &c%{_p}% &a&ofailed &c&o%{_i}% &7Type: &c%{_t}% &7Ping: &c%{_p}'s ping%" to {larkuslog::%{_p}%::*}
		#discordalert("%{player}%", "%{cheat}%")
		if {_ver} is set:
			if {lsalert} = false:
				{larkusalert} is not set
				loop all players:
					loop-player has the permission "staff.*"
					{alerts::%loop-player%} is not set
					#send "{@prefix}&r &c%{_p}% &a&ofailed &c&o%{_i}% &7Type: &c%{_t}% &7Ping: &c%{_p}'s ping%" to loop-player
					message formatted "<tooltip:&a&lLarkus Information>{@prefix}&r &c%{_p}% &a&ofailed &c&o%{_i}% &7Type: &c%{_t}% &7Ping: &c%{_p}'s ping%" to loop-player
				#set {larkusalert} to true
				wait 1 tick
				clear {larkusalert}
			if {lsalert} = true:
				message formatted "<tooltip:&a&lLarkus Information>{@prefix}&r &c%{_p}% &a&ofailed &c&o%{_i}% &7Type: &c%{_t}% &7Ping: &c%{_p}'s ping%" to all players
		if {_i} = "Speed":
			if {_t} = "L2P-A":
				add 1 to {L2PLarkus.A::%{_p}%}
				if {L2PLarkus.A::%{_p}%} = 5:
					delete {L2PLarkus.A::%{_p}%}
					autoban({_p}, "Speed (L2P-A)")
			if {_t} = "L2P-AA":
				add 1 to {L2PLarkus.AA::%{_p}%}
				if {L2PLarkus.AA::%{_p}%} = 6:
					delete {L2PLarkus.AA::%{_p}%}
					autoban({_p}, "Speed (L2P-AA)")
		if {_i} = "Flight":
			if {_t} = "L2P":
				add 1 to {L2PLarkus.FA::%{_p}%}
				if {L2PLarkus.FA::%{_p}%} = 5:
					delete {L2PLarkus.A::%{_p}%}
					autoban({_p}, "Flight (L2P)")
			if {_t} = "A":
				add 1 to {L2PLarkus.FC::%{_p}%}
				if {L2PLarkus.FC::%{_p}%} = 3:
					delete {L2PLarkus.FC::%{_p}%}
					autoban({_p}, "Flight (A)")
			if {_t} = "B":
				add 1 to {L2PLarkus.FC::%{_p}%}
				if {L2PLarkus.FC::%{_p}%} = 6:
					delete {L2PLarkus.FC::%{_p}%}
					autoban({_p}, "Flight (B)")
function isAboveBlock(p: Location, b: Item) :: boolean:
	set {_c} to block 0.1 meter below {_p}
	if block west {_c} is {_b}:
		if block north {_c} is {_b}:
			if block south {_c} is {_b}:
				if block east {_c} is {_b}:
					if block southwest {_c} is {_b}:
						if block northwest {_c} is {_b}:
							if block southeast {_c} is {_b}:
								if block northeast {_c} is {_b}:
									if {_c} is {_b}:
										return true
	return false
function distXZ(p: player) :: number:
    set {_DistX} to x coord of {lastmove::%{_p}%} - x coord of {currentmove::%{_p}%}
    set {_DistZ} to z coord of {lastmove::%{_p}%} - z coord of {currentmove::%{_p}%}
    return ({_DistX} * {_DistX}) + ({_DistZ} * {_DistZ})

function isAtBlock(p: Location, b: Item) :: boolean:
	set {_c} to block 0.1 meter above {_p}
	if block west {_c} is {_b}:
		if block north {_c} is {_b}:
			if block south {_c} is {_b}:
				if block east {_c} is {_b}:
					if block southwest {_c} is {_b}:
						if block northwest {_c} is {_b}:
							if block southeast {_c} is {_b}:
								if block northeast {_c} is {_b}:
									if {_c} is {_b}:
										return true
	return false
on death:
	set {lasttogglefly::%attacker%} to now
on place:
	event is cancelled
	set {lasttogglefly::%player%} to now
# Combat



	
function hypot2(a: number, b: number) :: number:
    return {_a}*{_a} + {_b}*{_b}

function addThreshold(p: player, c: text, a: integer, m: integer, t: boolean) :: boolean:
	loop {_a} times:
		add 1 to {L2P.Threshold.%{_c}%::%{_p}%}
		{L2P.Threshold.%{_c}%::%{_p}%} >= {_m}
		set {L2P.Threshold.%{_c}%::%{_p}%} to 0 if {_t} is true
		return true
function removeThreshold(p: player, c: text, a: integer):
	loop {_a} times:
		{L2P.Threshold.%{_c}%::%{_p}%} > 0
		remove 1 from {L2P.Threshold.%{_c}%::%{_p}%}
function resetThreshold(p: player, c: text):
	set {L2P.Threshold.%{_c}%::%{_p}%} to 0
function getTier(p: player, e: text) :: integer:
	return {_effect}
function onStairs(p: player) :: boolean:
	set {_l} to location at {_p}
	remove 0.25 from y coord of {_l}
	return true if "%block at {_l}%" contains "stair"
	return true if "%block 0.3 meters north of {_l}%" contains "stair"
	return true if "%block 0.3 meters south of {_l}%" contains "stair"
	return true if "%block 0.3 meters east of {_l}%" contains "stair"
	return true if "%block 0.3 meters west of {_l}%" contains "stair"
	return true if "%block 0.3 meters north east of {_l}%" contains "stair"
	return true if "%block 0.3 meters south west of {_l}%" contains "stair"
	return true if "%block 0.3 meters south east of {_l}%" contains "stair"
	return true if "%block 0.3 meters north west of {_l}%" contains "stair"
	return false
function underBlock(p: player) :: boolean:
	set {_l} to location at {_p}
	add 2 to y coord of {_l}
	return true if block at {_l} is not air
	return true if block 0.3 meters north of {_l} is not air
	return true if block 0.3 meters south of {_l} is not air
	return true if block 0.3 meters east of {_l} is not air
	return true if block 0.3 meters west of {_l} is not air
	return true if block 0.3 meters north east of {_l} is not air
	return true if block 0.3 meters south west of {_l} is not air
	return true if block 0.3 meters south east of {_l} is not air
	return true if block 0.3 meters north west of {_l} is not air
	return false
function onIce(p: player) :: boolean:
	set {_l} to location under {_p}
	return true if block at {_l} is ice or packed ice
	return true if block 0.3 meters north of {_l} is ice or packed ice
	return true if block 0.3 meters south of {_l} is ice or packed ice
	return true if block 0.3 meters east of {_l} is ice or packed ice
	return true if block 0.3 meters west of {_l} is ice or packed ice
	return true if block 0.3 meters north east of {_l} is ice or packed ice
	return true if block 0.3 meters south west of {_l} is ice or packed ice
	return true if block 0.3 meters south east of {_l} is ice or packed ice
	return true if block 0.3 meters north west of {_l} is ice or packed ice
	return false
function hypot(a: number, b: number) :: number:
	return sqrt({_a}^2 + {_b}^2)


						
function FlightL2P(p: player, getFrom: location, getTo: location):
	difference between {lasttogglefly::%{_p}%} and now >= 3 seconds
	block at {_p} is air
	set {_LastDistY} to {Lite.FlightA.DistY::%{_p}%}
	set {Lite.FlightA.LastDistY::%{_p}%} to {Lite.FlightA.DistY::%{_p}%}
	set {MathGlide::%{_p}%} to {Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%}
	set {Lite.FlightA.DistY::%{_p}%} to y coord of {_getFrom} - y coord of {_getTo}
	set {_diff} to -0.07840000152587 + difference between {_LastDistY} * 0.9800000190734863 and {Lite.FlightA.DistY::%{_p}%}
	if abs({_diff}) > 0.00000001:
		alert({_p}, "Flight", "L2P", "Larkus") if addThreshold({_p}, "Flight (L2P)", 2, 12, true) is true
	resetThreshold({_p}, "Flight (L2P)") if Ground({_p}) is true
	resetThreshold({_p}, "Flight (L2P)") if abs({_diff}) <= 0.00000001
			
function FlightA(p: player, getFrom: location, getTo: location):
	difference between {lasttogglefly::%{_p}%} and now >= 3 seconds
	set {InAirTime::%{_p}%} to 0 if Ground({_p}) is true
	set {InAirTime::%{_p}%} to 0 if atBlock({_p}) is true
	set {InAirTime2::%{_p}%} to 0 if Ground({_p}) is true
	set {InAirTime2::%{_p}%} to 0 if atBlock({_p}) is true
	Ground({_p}) is false
	atBlock({_p}) is false
	if y coord of {_getTo} >= y coord of {_getFrom}:
		add 1 to {InAirTime::%{_p}%}
	if y coord of {_getTo} < y coord of {_getFrom}:
		add 1 to {InAirTime2::%{_p}%}
	#broadcast "%{InAirTime::%{_p}%}% %{_p}%"
	if {InAirTime::%{_p}%} >= 10:
		alert({_p}, "Flight", "A", "Larkus") if addThreshold({_p}, "Flight (A)", 2, 6, true) is true
	if {InAirTime::%{_p}%} is above 0:
		set {LastAirTime::%{_p}%} to now
	else:
		resetThreshold({_p}, "Flight (A)")

function FlightOld(p: player, getFrom: location, getTo: location):
    difference between {lasttogglefly::%{_p}%} and now >= 3 seconds
    IsInAir({_p}) is true
    stop if {Lite.FlightA.DistY::%{_p}%} = 0
    stop if {Lite.FlightA.LastDistY::%{_p}%} = 0
    #roadcast "%{_p}% / %{Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%}% 9 %{LastFlightMath::%{_p}%}% / %{Lite.FlightA.DistY::%{_p}%}% / %{Lite.FlightA.LastDistY::%{_p}%}% / %y coord of {_getFrom}% / %y coord of {_getTo}%"
    if abs({LastFlightMath::%{_p}%} - ({Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%})) < 0.1:
        alert({_p}, "Flight", "Old", "Larkus")
    add {LastFlightMath::%{_p}%} to {LastFlightMathList::%{_p}%::*}
    set {LastFlightMath::%{_p}%} to {Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%}

import:
    org.bukkit.event.player.PlayerMoveEvent

on PlayerMoveEvent:
    set {_player} to event.getPlayer()
    add 1 to {L2P::TimerB::Moves::%{_player}%}
    if {L2P::TimerB::Moves::%{_player}%} >= 20:
        set {L2P::TimerB::Moves::%{_player}%} to 0
        set {_time} to unix timestamp of now - {L2P::TimerB::MoveTime::%{_player}%}
        set {L2P::TimerB::MoveTime::%{_player}%} to unix timestamp of now
        {_time} > 0
        if {_time} < 0.99:
            add 1 to {L2P::TimerBB::Threshold::%{_player}%}
            {L2P::TimerBB::Threshold::%{_player}%} > 4
            alert({_player}, "Timer", "L2P-A", "Larkus")
        else:
            set {L2P::TimerBB::Threshold::%{_player}%} to 0

function FlightB(p: player, getFrom: location, getTo: location):
	#{_p} = "contribe"
	set {Lite.FlightB.YInitialVelocity::%{_p}%} to y of velocity of {_p} if {InAirTime::%{_p}%} = 1
	set {_predicted} to (3.92 + ({Lite.FlightB.YInitialVelocity::%{_p}%})) * 0.98^{InAirTime::%{_p}%} - 3.92
	set {_lastpredicted} to {Lite.FlightB.PredictedVelocity::%{_p}%}
	set {Lite.FlightB.PredictedVelocity::%{_p}%} to {_predicted}
	#broadcast "%{_p}% / %{Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%}% / %{InAirTime2::%{_p}%}% / %{_predicted}%--%{_lastpredicted}%"
	set {CurrentYPred::%{_p}%} to {Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%} 
	if {InAirTime2::%{_p}%} >= 10:
		if {_predicted} is above 0:
			alert({_p2}, "Flight", "Test-1", "Larkus")
		if {_predicted} is not {_lastpredicted}:
			alert({_p2}, "Flight", "Test-2", "Larkus")
	if {InAirTime2::%{_p}%} = 10:
		{Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%} is below 1.2
		alert({_p}, "Flight", "B", "Larkus")
	if {InAirTime2::%{_p}%} = 15:
		{Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%} is below 1.8
		alert({_p}, "Flight", "B", "Larkus")
	if {InAirTime2::%{_p}%} = 20:
		{Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%} is below 2.4
		alert({_p}, "Flight", "B", "Larkus")
	if {InAirTime2::%{_p}%} >= 30:
		{Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%} is below 3.4
		alert({_p}, "Flight", "B", "Larkus")
	set {_set} to {Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%}
	#alert({_p}, "Speed", "C", "Larkus") if {_set} = -0
	#broadcast "%{_p}% / %{Lite.FlightA.DistY::%{_p}%} + {Lite.FlightA.LastDistY::%{_p}%}% / %{InAirTime2::%{_p}%}%"
	set {_r} to 1 or 2
	removeThreshold({_p}, "Flight (B)", 1) if {_r} = 2

Function JesusA(p: player):
	loop all blocks in radius 2 around {_p}:
		if loop-block is a lily pad:
			stop
	{_p} is not flying
	{_p}'s gamemode is not creative or spectator
	isInWater({_p}) is false
	block below {_p} is water
	block 1 east of block below {_p} is water
	block 1 west of block below {_p} is water
	block 1 south the block below {_p} is water
	block 1 north of block below {_p} is water
	block 1 east 1 north of block below {_p} is water
	block 1 west 1 north of block below {_p} is water
	block 1 east 1 south of block below {_p} is water
	block 1 west 1 south of block below {_p} is water
	if {_p} is on ground:
		alert({_p}, "Jesus", "A", "Larkus")

											
on jump:
	set {lastjump::%player%} to now
Function JesusB(p: player):
	difference between {lastjump::%{_p}%} and now < 0.3 second
	set {_u} to uuid of {_p}
	if isAtBlock({_p}, air):
		if isAboveBlock({_p}, water):
			alert({_p}, "Jesus", "B", "Larkus")

