    set {_gapple} to golden apple named "&6&lGOLDEN APPLE"
    set lore of {_gapple} to "&7Premium combat food.", "", "&7Price: &a$%{_gappleCost}%", "", "&eClick to purchase."
    set slot 15 of {_gui} to {_gapple}

    set {_egappleCost} to {@enchanted-golden-apple-cost}
    set {_egapple} to enchanted golden apple named "&d&lENCHANTED GOLDEN APPLE"
    set lore of {_egapple} to "&7Stage 6 elite combat food.", "", "&7Price: &a$%{_egappleCost}%", "", "&dHigh-end Diamond supply.", "&eClick to purchase."
    set slot 22 of {_gui} to {_egapple}

    set slot 27 of {_gui} to arrow named "&e&lBACK TO BLACKSMITH"
    set slot 35 of {_gui} to barrier named "&c&lCLOSE"
    open {_gui} to {_p}

function diamondOpenProgress(p: player):
    if diamondUnlocked({_p}) is false:
        send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to {_p}
        stop

    diamondInit({_p})
    set {_u} to uuid of {_p}
    set {_blocks} to diamondTotalBlocks({_p})
    set {_spent} to diamondSkillPointsSpent({_p})
    set {_pickaxeTier} to {box::%{_u}%::diamond-pickaxe-tier}

    set {_gui} to chest inventory with 4 rows named "&b&lDIAMOND PROGRESS"
    loop 36 times:
        set slot (loop-number - 1) of {_gui} to light blue stained glass pane named " "
    loop 9 times:
        set slot (loop-number - 1) of {_gui} to blue stained glass pane named " "
    loop 9 times:
        set slot (27 + loop-number - 1) of {_gui} to blue stained glass pane named " "

    set {_info} to book named "&6&lSTAGE 6 • DIAMOND"
    set lore of {_info} to "&7Complete all requirements", "&7to unlock Emerald.", "", "&7Stage 6 gives stronger", "&7Money and Box XP than Stone."
    set slot 4 of {_gui} to {_info}

    if {_pickaxeTier} >= 5:
        set {_pickaxeReq} to diamond pickaxe named "&a&l✔ DIAMOND PICKAXE"
    else:
        set {_pickaxeReq} to diamond pickaxe named "&c&l✖ DIAMOND PICKAXE"
    set lore of {_pickaxeReq} to "&7Current: &f%{_pickaxeTier}% &8/ &f5"
    set slot 11 of {_gui} to {_pickaxeReq}

    if {_blocks} >= {@diamond-stage-blocks-required}:
        set {_blocksReq} to diamond ore named "&a&l✔ BLOCKS MINED"
    else:
        set {_blocksReq} to diamond ore named "&c&l✖ BLOCKS MINED"
    set lore of {_blocksReq} to "&7%{_blocks}% &8/ &f{@diamond-stage-blocks-required}"
    set slot 13 of {_gui} to {_blocksReq}

    if {_spent} >= {@diamond-stage-skill-points-spent-required}:
        set {_skillReq} to experience bottle named "&a&l✔ SKILL POINTS SPENT"
    else:
        set {_skillReq} to experience bottle named "&c&l✖ SKILL POINTS SPENT"
    set lore of {_skillReq} to "&7%{_spent}% &8/ &f{@diamond-stage-skill-points-spent-required}"
    set slot 15 of {_gui} to {_skillReq}

    set slot 22 of {_gui} to diamondProgressItem({_p})
    set slot 27 of {_gui} to arrow named "&e&lBACK TO BLACKSMITH"
    set slot 35 of {_gui} to barrier named "&c&lCLOSE"
    open {_gui} to {_p}

# ============================================================
# DIAMOND GUI LOCK
# Prevents moving, shift-clicking and dragging in every Diamond GUI.
# Uses the exact inventory titles opened by this script.
# ============================================================

function diamondIsGuiOpen(p: player) :: boolean:
    set {_title} to name of {_p}'s current inventory

    if {_title} is "&7&lDIAMOND BLACKSMITH":
        return true
    if {_title} is "&f&lDIAMOND PICKAXES":
        return true
    if {_title} is "&b&lDIAMOND SKILLS":
        return true
    if {_title} is "&c&lDIAMOND SWORDS":
        return true
    if {_title} is "&d&lDIAMOND SWORD UPGRADES":
        return true
    if {_title} is "&6&lDIAMOND-FORGED ARMOR":
        return true
    if {_title} is "&d&lDIAMOND ARMOR UPGRADES":
        return true
    if {_title} is "&b&lDIAMOND FOOD":
        return true
    if {_title} is "&b&lDIAMOND PROGRESS":
        return true

    return false

on inventory click:
    if name of player's current inventory contains "DIAMOND":
        cancel event

on inventory click:
    if name of player's current inventory is "&b&lDIAMOND BACKPACK":
        cancel event
        if clicked slot is 22:
            close player's inventory


on inventory drag:
    if name of player's current inventory contains "DIAMOND":
        cancel event

on inventory drag:
    if name of player's current inventory is "&b&lDIAMOND BACKPACK":
        cancel event


on inventory click:
    if diamondIsGuiOpen(player) is true:
        cancel event


on inventory drag:
    if diamondIsGuiOpen(player) is true:
        cancel event


# ============================================================
# BASIC GUI EVENTS
# ============================================================

command /diamond:
    trigger:
        if diamondUnlocked(player) is false:
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop
        diamondOpenBlacksmith(player)


on inventory click:
    if name of player's current inventory is "{@diamond-gui-title}":
        cancel event
        if clicked slot is 25:
            diamondOpenBackpack(player)
            stop
        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop
        if clicked slot is 11:
            diamondOpenPickaxes(player)
            stop
        if clicked slot is 13:
            diamondOpenSwords(player)
            stop
        if clicked slot is 15:
            diamondOpenArmor(player)
            stop
        if clicked slot is 21:
            diamondOpenFood(player)
            stop
        if clicked slot is 23:
            diamondOpenProgress(player)
            stop
        if clicked slot is 40:
            close player's inventory
            stop


on inventory drag:
    if name of player's current inventory is "{@diamond-gui-title}":
        cancel event
        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop


on inventory click:
    if name of player's current inventory is "{@pickaxe-gui-title}":
        cancel event
        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop
        if event-item is air:
            stop

        if diamondIsPickaxe(event-item) is true:
            set {_tier} to diamondPickaxeTierFromItem(event-item)
            set {_u} to uuid of player
            set {_owned} to {box::%{_u}%::diamond-pickaxe-tier}

            if {_tier} <= {_owned}:
                stop

            # Wooden is the FIRST Diamond pickaxe and is free.
            if {_tier} is 1:
                if {_owned} is not 0:
                    stop
            else:
                if {_tier} is not {_owned} + 1:
                    send "&7&lDIAMOND &8» &cUnlock the previous pickaxe tier first." to player
                    stop

            set {_diamondCost} to diamondPickaxeOreCost({_tier})
            set {_diamondBlocksCost} to diamondPickaxeIngotCost({_tier})

            set {_diamondOwned} to diamondCountOre(player)
            set {_diamondBlocksOwned} to diamondCountIngots(player)

            if {_diamondOwned} < {_diamondCost}:
                send "" to player
                send "&7&lDIAMOND PICKAXE &8» &cNot enough resources." to player
                send "&7Diamond Ore: &f%{_diamondOwned}% &8/ &f%{_diamondCost}%" to player
                send "&7Diamonds: &f%{_diamondBlocksOwned}% &8/ &f%{_diamondBlocksCost}%" to player
                send "" to player
                stop

            if {_diamondBlocksOwned} < {_diamondBlocksCost}:
                send "" to player
                send "&7&lDIAMOND PICKAXE &8» &cNot enough resources." to player
                send "&7Diamond Ore: &f%{_diamondOwned}% &8/ &f%{_diamondCost}%" to player
                send "&7Diamonds: &f%{_diamondBlocksOwned}% &8/ &f%{_diamondBlocksCost}%" to player
                send "" to player
                stop

            diamondRemoveOreIncludingBackpack(player, {_diamondCost})
            diamondRemoveDiamondsIncludingBackpack(player, {_diamondBlocksCost})

            set {box::%{_u}%::diamond-pickaxe-tier} to {_tier}

            # One-time Diamond Skill Point bonus for reaching each pickaxe tier.
            # Reclaiming/restoring the same pickaxe can never award this again.
            if {box::%{_u}%::diamond-pickaxe-skill-bonus::%{_tier}%} is not true:
                if {_tier} is 1:
                    set {_pickaxeSkillBonus} to 1
                else if {_tier} is 2:
                    set {_pickaxeSkillBonus} to 1
                else if {_tier} is 3:
                    set {_pickaxeSkillBonus} to 2
                else if {_tier} is 4:
                    set {_pickaxeSkillBonus} to 2
                else:
                    set {_pickaxeSkillBonus} to 3

                set {_basePickaxeSkillBonus} to {_pickaxeSkillBonus}
                set {_pickaxeSkillBonus} to diamondBoostSkillPoints(player, {_basePickaxeSkillBonus})
                if {_pickaxeSkillBonus} > 0:
                    add {_pickaxeSkillBonus} to {box::%{_u}%::diamond-skill-points}
                set {box::%{_u}%::diamond-pickaxe-skill-bonus::%{_tier}%} to true

            diamondGiveCurrentPickaxe(player)

            set {_tierName} to diamondPickaxeTierName({_tier})
            close player's inventory

            send "" to player
            if {_tier} is 1:
                send "&b&lDIAMOND STARTER CLAIMED!" to player
            else:
                send "&7&lDIAMOND PICKAXE UPGRADED!" to player
            send "&7New Pickaxe: &f%{_tierName}% Diamond Pickaxe" to player
            send "&7Progress: &f%{_tier}% &8/ &f5" to player
            if {_pickaxeSkillBonus} is set:
                set {_skillMultiplier} to boxSkillMultiplier(player)
                send "&b+%{_pickaxeSkillBonus}% Diamond Skill Point(s) &8• &d%{_skillMultiplier}%x Skills" to player
            send "" to player

            play sound "entity.player.levelup" with volume 1 and pitch 1 to player
            wait 5 ticks
            diamondOpenPickaxes(player)
            stop

        if clicked slot is 29:
            diamondPurchaseFortuneDrill(player)
            diamondOpenPickaxes(player)
            stop

        if clicked slot is 31:
            diamondOpenSkills(player)
            stop

        if clicked slot is 33:
            set {_u} to uuid of player
            if {box::%{_u}%::diamond-pickaxe-tier} <= 0:
                send "&7&lDIAMOND &8» &cYou have no Diamond Pickaxe unlocked." to player
                stop
            if diamondHasCurrentPickaxe(player) is true:
                send "&7&lDIAMOND &8» &cYour current Diamond Pickaxe is already owned or stored." to player
                stop
            diamondGiveCurrentPickaxe(player)
            send "&7&lDIAMOND &8» &aYour Diamond Pickaxe was restored." to player
            stop

        if clicked slot is 36:
            diamondOpenBlacksmith(player)
            stop
        if clicked slot is 44:
            close player's inventory
            stop


on inventory drag:
    if name of player's current inventory is "{@pickaxe-gui-title}":
        cancel event
        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop


on inventory click:
    if name of player's current inventory is "&b&lDIAMOND SKILLS":
        cancel event

        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop

        if clicked slot is 10:
            diamondBuySkill(player, "conductive-chain")
            stop
        if clicked slot is 12:
            diamondBuySkill(player, "voltage-bank")
            stop
        if clicked slot is 14:
            diamondBuySkill(player, "oxidation")
            stop
        if clicked slot is 16:
            diamondBuySkill(player, "essence-conductor")
            stop
        if clicked slot is 28:
            diamondBuySkill(player, "ore-magnet")
            stop
        if clicked slot is 30:
            diamondBuySkill(player, "power-grid")
            stop
        if clicked slot is 32:
            diamondBuySkill(player, "crystal-burst")
            stop
        if clicked slot is 34:
            diamondBuySkill(player, "deep-focus")
            stop

        if clicked slot is 36:
            diamondOpenPickaxes(player)
            stop
        if clicked slot is 44:
            close player's inventory
            stop


on inventory drag:
    if name of player's current inventory is "&b&lDIAMOND SKILLS":
        cancel event
        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop


on inventory click:
    if name of player's current inventory is "&c&lDIAMOND SWORDS":
        cancel event

        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop

        if event-item is air:
            stop

        if diamondIsSword(event-item) is true:
            diamondPurchaseSword(player, diamondSwordTierFromItem(event-item))
            stop

        if clicked slot is 31:
            diamondOpenSwordEnchant(player)
            stop

        if clicked slot is 33:
            set {_u} to uuid of player
            if {box::%{_u}%::diamond-sword-tier} <= 0:
                send "&7&lDIAMOND &8» &cYou have not unlocked a Diamond Sword yet." to player
                stop
            if diamondHasCurrentSword(player) is true:
                send "&7&lDIAMOND &8» &cYour current Diamond Sword is already owned or stored." to player
                stop
            diamondGiveCurrentSword(player)
            send "&7&lDIAMOND &8» &aYour current Diamond Sword was restored." to player
            play sound "entity.item.pickup" with volume 1 and pitch 1 to player
            diamondOpenSwords(player)
            stop

        if clicked slot is 36:
            diamondOpenBlacksmith(player)
            stop
        if clicked slot is 44:
            close player's inventory
            stop


on inventory drag:
    if name of player's current inventory is "&c&lDIAMOND SWORDS":
        cancel event


on inventory click:
    if name of player's current inventory is "&d&lDIAMOND SWORD UPGRADES":
        cancel event

        if diamondUnlocked(player) is false:
            close player's inventory
            stop

        if clicked slot is 10:
            diamondPurchaseSharpness(player)
            stop
        if clicked slot is 12:
            diamondPurchaseSwordCustom(player, "conductivity")
            stop
        if clicked slot is 14:
            diamondPurchaseSwordCustom(player, "critical-edge")
            stop
        if clicked slot is 16:
            diamondPurchaseSwordCustom(player, "executioner")
            stop
        if clicked slot is 22:
            diamondPurchaseKnockback(player)
            stop
        if clicked slot is 27:
            diamondOpenSwords(player)
            stop
        if clicked slot is 35:
            close player's inventory
            stop


on inventory drag:
    if name of player's current inventory is "&d&lDIAMOND SWORD UPGRADES":
        cancel event


on inventory click:
    if name of player's current inventory is "&6&lDIAMOND-FORGED ARMOR":
        cancel event

        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop

        if event-item is air:
            stop

        if diamondIsArmor(event-item) is true:
            diamondPurchaseArmor(player, diamondArmorPieceFromItem(event-item))
            stop

        if clicked slot is 31:
            diamondOpenArmorEnchants(player)
            stop

        if clicked slot is 33:
            set {_u} to uuid of player
            set {_owned} to 0

            if {box::%{_u}%::diamond-armor::helmet} is true:
                add 1 to {_owned}
            if {box::%{_u}%::diamond-armor::chestplate} is true:
                add 1 to {_owned}
            if {box::%{_u}%::diamond-armor::leggings} is true:
                add 1 to {_owned}
            if {box::%{_u}%::diamond-armor::boots} is true:
                add 1 to {_owned}

            if {_owned} <= 0:
                send "&7&lDIAMOND &8» &cYou have not unlocked any Diamond Armor yet." to player
                stop

            diamondGiveArmorPiece(player, "helmet")
            diamondGiveArmorPiece(player, "chestplate")
            diamondGiveArmorPiece(player, "leggings")
            diamondGiveArmorPiece(player, "boots")
            send "&7&lDIAMOND &8» &aRestored any missing owned Diamond Armor." to player
            play sound "entity.item.pickup" with volume 1 and pitch 1 to player
            wait 2 ticks
            diamondOpenArmor(player)
            stop

        if clicked slot is 36:
            diamondOpenBlacksmith(player)
            stop
        if clicked slot is 44:
            close player's inventory
            stop


on inventory drag:
    if name of player's current inventory is "&6&lDIAMOND-FORGED ARMOR":
        cancel event


on inventory click:
    if name of player's current inventory is "&d&lDIAMOND ARMOR UPGRADES":
        cancel event

        if diamondUnlocked(player) is false:
            close player's inventory
            stop

        if event-item is air:
            stop

        if clicked slot is 10:
            diamondPurchaseProtection(player, "helmet")
            stop
        if clicked slot is 12:
            diamondPurchaseProtection(player, "chestplate")
            stop
        if clicked slot is 14:
            diamondPurchaseProtection(player, "leggings")
            stop
        if clicked slot is 16:
            diamondPurchaseProtection(player, "boots")
            stop
        if clicked slot is 20:
            diamondPurchaseArmorSetUpgrade(player, "reinforcement")
            stop
        if clicked slot is 22:
            diamondPurchaseArmorSetUpgrade(player, "vitality")
            stop
        if clicked slot is 24:
            diamondPurchaseArmorSetUpgrade(player, "static-guard")
            stop

        if clicked slot is 36:
            diamondOpenArmor(player)
            stop
        if clicked slot is 44:
            close player's inventory
            stop


on inventory drag:
    if name of player's current inventory is "&d&lDIAMOND ARMOR UPGRADES":
        cancel event


on inventory click:
    if name of player's current inventory is "&b&lDIAMOND FOOD":
        cancel event

        if index of event-slot is 11:
            set {_cost} to {@bread-16-cost}
            if balance of player < {_cost}:
                send "&cYou do not have enough money." to player
                stop
            remove {_cost} from balance of player
            give 16 bread to player
            send "&b&lDIAMOND &8» &aPurchased 16 Bread." to player
            stop

        if index of event-slot is 13:
            set {_cost} to {@steak-16-cost}
            if balance of player < {_cost}:
                send "&cYou do not have enough money." to player
                stop
            remove {_cost} from balance of player
            give 16 cooked beef to player
            send "&b&lDIAMOND &8» &aPurchased 16 Steak." to player
            stop

        if index of event-slot is 15:
            set {_cost} to {@golden-apple-cost}
            if balance of player < {_cost}:
                send "&cYou do not have enough money." to player
                stop
            remove {_cost} from balance of player
            give 1 golden apple to player
            send "&b&lDIAMOND &8» &aPurchased a Golden Apple." to player
            stop

        if index of event-slot is 22:
            set {_cost} to {@enchanted-golden-apple-cost}
            if balance of player < {_cost}:
                send "&cYou do not have enough money." to player
                stop
            remove {_cost} from balance of player
            give 1 enchanted golden apple to player
            send "&b&lDIAMOND &8» &aPurchased an Enchanted Golden Apple." to player
            stop

        if index of event-slot is 27:
            diamondOpenBlacksmith(player)
            stop

        if index of event-slot is 35:
            close player's inventory
            stop

on inventory drag:
    if name of player's current inventory is "&b&lDIAMOND FOOD":
        cancel event
        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop


on inventory click:
    if name of player's current inventory is "&b&lDIAMOND PROGRESS":
        cancel event

        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop

        if clicked slot is 22:
            diamondAdvanceToEmerald(player)
            stop

        if clicked slot is 27:
            diamondOpenBlacksmith(player)
            stop

        if clicked slot is 35:
            close player's inventory
            stop

on inventory drag:
    if name of player's current inventory is "&b&lDIAMOND PROGRESS":
        cancel event
        if diamondUnlocked(player) is false:
            close player's inventory
            send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
            stop


# ============================================================
# SOULBOUND / UNBREAKABLE / ANTI-DUPLICATION PROTECTION
# Mirrors Woodland protection for Pickaxes, Swords and Armor.
# ============================================================

on drop:
    if diamondIsPickaxe(event-item) is true:
        cancel event
        send action bar "&cDiamond Pickaxes are Soulbound and cannot be dropped." to player
    if diamondIsSword(event-item) is true:
        cancel event
        send action bar "&cDiamond Swords are Soulbound and cannot be dropped." to player
    if diamondIsArmor(event-item) is true:
        cancel event
        send action bar "&cDiamond Armor is Soulbound and cannot be dropped." to player


on inventory item move:
    if diamondIsPickaxe(event-item) is true:
        cancel event
    if diamondIsSword(event-item) is true:
        cancel event
    if diamondIsArmor(event-item) is true:
        cancel event


on inventory pickup:
    if diamondIsPickaxe(event-item) is true:
        cancel event
    if diamondIsSword(event-item) is true:
        cancel event
    if diamondIsArmor(event-item) is true:
        cancel event


on pick up:
    if event-entity is not a player:
        stop

    set {_p} to event-entity

    if diamondIsPickaxe(event-item) is true:
        if diamondPickaxeBelongsTo(event-item, {_p}) is false:
            cancel event
            send action bar "&cThat Diamond Pickaxe belongs to another player." to {_p}

    if diamondIsSword(event-item) is true:
        if diamondSwordBelongsTo(event-item, {_p}) is false:
            cancel event
            send action bar "&cThat Diamond Sword belongs to another player." to {_p}

    if diamondIsArmor(event-item) is true:
        if diamondArmorBelongsTo(event-item, {_p}) is false:
            cancel event
            send action bar "&cThat Diamond Armor belongs to another player." to {_p}


on inventory slot change:
    if event-item is air:
        stop

    if diamondIsPickaxe(event-item) is true:
        if diamondPickaxeBelongsTo(event-item, player) is false:
            set event-slot to air
            send action bar "&cAn invalid Diamond Pickaxe was removed from your inventory." to player

    if diamondIsSword(event-item) is true:
        if diamondSwordBelongsTo(event-item, player) is false:
            set event-slot to air
            send action bar "&cAn invalid Diamond Sword was removed from your inventory." to player

    if diamondIsArmor(event-item) is true:
        if diamondArmorBelongsTo(event-item, player) is false:
            set event-slot to air
            send action bar "&cInvalid Diamond Armor was removed from your inventory." to player


on item damage:
    if diamondIsPickaxe(event-item) is true:
        clear damage
    if diamondIsSword(event-item) is true:
        clear damage
    if diamondIsArmor(event-item) is true:
        clear damage


on death of player:
    set {_pickaxeFound} to false
    set {_equipmentFound} to false

    loop drops:
        if diamondIsPickaxe(loop-value) is true:
            remove loop-value from drops
            set {_pickaxeFound} to true
        else if diamondIsSword(loop-value) is true:
            remove loop-value from drops
            set {_equipmentFound} to true
        else if diamondIsArmor(loop-value) is true:
            remove loop-value from drops
            set {_equipmentFound} to true

    if {_pickaxeFound} is true:
        set {diamondstage::restore-pickaxe::%uuid of victim%} to true

    if {_equipmentFound} is true:
        set {diamondstage::restore-equipment::%uuid of victim%} to true


on respawn:
    set {_u} to uuid of player

    if {diamondstage::restore-pickaxe::%{_u}%} is true:
        delete {diamondstage::restore-pickaxe::%{_u}%}
        wait 5 ticks

        if {box::%{_u}%::diamond-pickaxe-tier} is set:
            if {box::%{_u}%::diamond-pickaxe-tier} > 0:
                diamondGiveCurrentPickaxe(player)

    if {diamondstage::restore-equipment::%{_u}%} is true:
        delete {diamondstage::restore-equipment::%{_u}%}
        wait 2 ticks

        if {box::%{_u}%::diamond-sword-tier} is set:
            if {box::%{_u}%::diamond-sword-tier} > 0:
                diamondGiveCurrentSword(player)

        diamondGiveArmorPiece(player, "helmet")
        diamondGiveArmorPiece(player, "chestplate")
        diamondGiveArmorPiece(player, "leggings")
        diamondGiveArmorPiece(player, "boots")


# ============================================================
# ADMIN TEST / ACCESS
# ============================================================

command /setdiamondtier <player>:
    permission: op
    trigger:
        set {_u} to uuid of arg-1
        set {box::%{_u}%::tier} to "Diamond"
        send "&f&lDIAMOND ADMIN &8» &aSet %arg-1%'s highest unlocked stage to Diamond." to player
        send "&f&lDIAMOND &8» &aDiamond Stage access has been unlocked for testing." to arg-1


command /lockdiamond <player>:
    permission: op
    trigger:
        set {_t} to arg-1
        set {_u} to uuid of {_t}

        # This only locks access to Diamond again by returning the highest stage to Gold.
        # It does NOT delete Diamond items, mined stats, skills, money, XP,
        # Stone/Woodland progress, or any other saved progression.
        set {box::%{_u}%::tier} to "Gold"

        send "&f&lDIAMOND ADMIN &8» &cLocked Diamond Stage for %{_t}%." to player
        send "&c&lLOCKED &8» &cYour Diamond Stage access has been locked." to {_t}


# ============================================================
# ADMIN RESET - DIAMOND ONLY
# Never changes Woodland or Stone progress.
# ============================================================

command /resetdiamondall <player>:
    permission: op
    trigger:
        set {_t} to arg-1
        set {_u} to uuid of {_t}
        delete {diamondstage::skill-chat-global-last::%{_u}%}

        set {box::%{_u}%::diamond-ore-mined} to 0
        set {box::%{_u}%::diamond-block-mined} to 0

        set {box::%{_u}%::diamond-pickaxe-tier} to 0

        delete {box::%{_u}%::diamond-pickaxe-skill-bonus::1}
        delete {box::%{_u}%::diamond-pickaxe-skill-bonus::2}
        delete {box::%{_u}%::diamond-pickaxe-skill-bonus::3}
        delete {box::%{_u}%::diamond-pickaxe-skill-bonus::4}
        delete {box::%{_u}%::diamond-pickaxe-skill-bonus::5}

        delete {box::%{_u}%::diamond-pickaxe-ready::1}
        delete {box::%{_u}%::diamond-pickaxe-ready::2}
        delete {box::%{_u}%::diamond-pickaxe-ready::3}
        delete {box::%{_u}%::diamond-pickaxe-ready::4}
        delete {box::%{_u}%::diamond-pickaxe-ready::5}

        delete {diamondstage::restore-pickaxe::%{_u}%}
        delete {diamondstage::restore-equipment::%{_u}%}
        delete {diamond::regen-pending}
        delete {diamondstage::skill-chat-last::%{_u}%::conductive-chain}
        delete {diamondstage::skill-chat-last::%{_u}%::voltage-bank}
        delete {diamondstage::skill-chat-last::%{_u}%::oxidation}
        delete {diamondstage::skill-chat-last::%{_u}%::ore-magnet}
        delete {diamondstage::skill-chat-last::%{_u}%::power-grid}
        delete {diamondstage::skill-chat-last::%{_u}%::essence-conductor}

        set {box::%{_u}%::diamond-sword-tier} to 0
        set {box::%{_u}%::diamond-sword-sharpness} to 0
        set {box::%{_u}%::diamond-sword-conductivity} to 0
        set {box::%{_u}%::diamond-sword-critical-edge} to 0
        set {box::%{_u}%::diamond-sword-executioner} to 0
        set {box::%{_u}%::diamond-sword-knockback} to 0
        set {box::%{_u}%::diamond-fortune-drill} to 0
        delete {diamondstage::fortune-drill-block-cooldown::%{_u}%}
        delete {diamondstage::golden-vault-armed::%{_u}%}
        delete {diamondstage::golden-vault-cooldown::%{_u}%}
        delete {diamondstage::aura-angle::%{_u}%}

        set {box::%{_u}%::diamond-armor::helmet} to false
        set {box::%{_u}%::diamond-armor::chestplate} to false
        set {box::%{_u}%::diamond-armor::leggings} to false
        set {box::%{_u}%::diamond-armor::boots} to false

        set {box::%{_u}%::diamond-armor-prot::helmet} to 0
        set {box::%{_u}%::diamond-armor-prot::chestplate} to 0
        set {box::%{_u}%::diamond-armor-prot::leggings} to 0
        set {box::%{_u}%::diamond-armor-prot::boots} to 0
        set {box::%{_u}%::diamond-armor-reinforcement} to 0
        set {box::%{_u}%::diamond-armor-vitality} to 0
        set {box::%{_u}%::diamond-armor-static-guard} to 0
        delete {diamondstage::vitality-cooldown::%{_u}%}

        set {box::%{_u}%::diamond-skill-points} to 0
        set {box::%{_u}%::diamond-skill-points-earned} to 0
        set {box::%{_u}%::diamond-skill-point-fraction} to 0
        # Current Diamond skill tree
        set {box::%{_u}%::diamond-skill::conductive-chain} to 0
        set {box::%{_u}%::diamond-skill::voltage-bank} to 0
        set {box::%{_u}%::diamond-skill::oxidation} to 0
        set {box::%{_u}%::diamond-skill::essence-conductor} to 0
        set {box::%{_u}%::diamond-skill::ore-magnet} to 0
        set {box::%{_u}%::diamond-skill::power-grid} to 0
        set {box::%{_u}%::diamond-skill::crystal-burst} to 0
        set {box::%{_u}%::diamond-skill::deep-focus} to 0

        delete {diamondstage::chain-charge::%{_u}%}
        delete {diamondstage::voltage::%{_u}%}
        delete {diamondstage::oxidation-charge::%{_u}%}
        delete {diamondstage::oxidation-phase::%{_u}%}
        delete {diamondstage::magnet-charge::%{_u}%}
        delete {diamondstage::grid-charge::%{_u}%}
        delete {diamondstage::crystal-burst-charge::%{_u}%}
        delete {diamondstage::deep-focus-charge::%{_u}%}

        set {box::%{_u}%::diamond-backpack-ore} to 0
        set {box::%{_u}%::diamond-backpack-diamonds} to 0

        loop all items in {_t}'s inventory:
            if diamondIsPickaxe(loop-item) is true:
                remove loop-item from {_t}'s inventory
            else if diamondIsSword(loop-item) is true:
                remove loop-item from {_t}'s inventory
            else if diamondIsArmor(loop-item) is true:
                remove loop-item from {_t}'s inventory

        remove all diamond ore from {_t}'s inventory
        remove all diamond from {_t}'s inventory

        # If Diamond is still unlocked, a full reset returns the player to the free starter pickaxe.

        send "&7&lDIAMOND ADMIN &8» &aFully reset %{_t}%'s Diamond progression." to player
        send "&7Reset: &fPickaxe, Sword, Armor, Enchants, Skills, Skill Points, mining progress and Diamond resources." to player
        send "&7Woodland, Stone, Iron and other stages were not changed." to player
        delete {diamondstage::skill-chat-last::%{_u}%::*}
        delete {diamondstage::momentum-last-hit::%{_u}%}
        delete {diamondstage::momentum-hits::%{_u}%}
        delete {diamondstage::sovereign-pulse-cooldown::%{_u}%}
        delete {diamondstage::phoenix-ward-cooldown::%{_u}%}
        delete {diamondstage::golden-vault-progress-added::%{_u}%}
        send "&7&lDIAMOND &8» &cYour entire Diamond progression was reset by an administrator." to {_t}
