        set {box::%{_u}%::diamond-backpack-diamonds} to 0


on join:
    diamondInit(player)


# ============================================================
# ACCESS
# ============================================================

function diamondUnlocked(p: player) :: boolean:
    if {_p} is op:
        return true

    set {_u} to uuid of {_p}
    if {box::%{_u}%::tier} is "Diamond":
        return true
    if {box::%{_u}%::tier} is "Emerald":
        return true
    if {box::%{_u}%::tier} is "Nether":
        return true
    if {box::%{_u}%::tier} is "End":
        return true
    if {box::%{_u}%::tier} is "Deep Dark":
        return true
    return false


function diamond3x3Allowed(p: player) :: boolean:
    if {_p} is op:
        return true
    set {_u} to uuid of {_p}
    if {box::%{_u}%::tier} is "Diamond":
        return true
    return false


# ============================================================
# DIAMOND MINE HOLOGRAM
# Matches the Woodland hologram layout:
# STAGE 6
# DIAMOND
# health bar
# percentage
# blocks remaining
# regeneration line
# ============================================================

function diamondHealthBar(percent: number) :: text:
    set {_filled} to floor({_percent} / 10)
    if {_filled} < 0:
        set {_filled} to 0
    if {_filled} > 10:
        set {_filled} to 10
    set {_empty} to 10 - {_filled}
    set {_bar} to ""
    loop {_filled} times:
        set {_bar} to "%{_bar}%&a■"
    loop {_empty} times:
        set {_bar} to "%{_bar}%&8■"
    return {_bar}


function diamondHologramText() :: text:
    set {_percent} to 100
    set {_remaining} to 0
    set {_total} to 0

    if {diamond::percent} is set:
        set {_percent} to {diamond::percent}
    if {diamond::remaining} is set:
        set {_remaining} to {diamond::remaining}
    if {diamond::total} is set:
        set {_total} to {diamond::total}

    set {_bar} to diamondHealthBar({_percent})

    return "&6&lSTAGE 6%nl%&e&lDIAMOND%nl%%nl%&f&lMINE HEALTH%nl%%{_bar}%%nl%&a%{_percent}% &7PERCENT REMAINING%nl%%nl%&f%{_remaining}% &7/ &f%{_total}% &7BLOCKS%nl%%nl%&c10 PERCENT%nl%&7Mine the blocks below to progress"


function diamondRefreshHologram():
    if {diamond::holo-entity} is not set:
        stop

    set {_display} to {diamond::holo-entity}
    set text of {_display} to diamondHologramText()


function diamondCreateHologram():
    if {diamond::holo-location} is not set:
        stop

    if {diamond::holo-entity} is set:
        kill {diamond::holo-entity}
        delete {diamond::holo-entity}

    spawn text display at {diamond::holo-location}
    set {_display} to last spawned text display
    set {diamond::holo-entity} to {_display}

    set billboard of {_display} to center
    set display scale of {_display} to vector(2.6, 2.6, 2.6)
    set line width of {_display} to 300
    apply drop shadow to {_display}

    set text of {_display} to diamondHologramText()


function diamondOpenBackpack(p: player):
    set {_u} to uuid of {_p}
    if {box::%{_u}%::tier} is not "Diamond":
        send "&b&lDIAMOND BACKPACK &8» &cThis backpack is only available while you are in Diamond Stage." to {_p}
        stop

    set {_ore} to diamondBackpackOre({_p})
    set {_diamonds} to diamondBackpackDiamonds({_p})
    set {_totalOre} to diamondCountOre({_p})
    set {_totalDiamonds} to diamondCountIngots({_p})

    set {_gui} to chest inventory with 3 rows named "&b&lDIAMOND BACKPACK"
    loop 27 times:
        set slot (loop-number - 1) of {_gui} to light blue stained glass pane named " "

    set slot 4 of {_gui} to chest named "&b&lDIAMOND OVERFLOW BACKPACK" with lore "&7Automatic overflow storage for", "&7Diamond Stage mining rewards.", "", "&fHow it works:", "&7• Inventory fills first", "&7• Overflow is stored automatically", "&7• Stored resources work for upgrades", "&7• Money, Box XP and progress still count"

    set slot 11 of {_gui} to diamond ore named "&b&lDIAMOND ORE STORAGE" with lore "&7Backpack: &f%{_ore}%", "&7Total Spendable: &f%{_totalOre}%", "", "&8Total includes inventory + backpack."

    set slot 15 of {_gui} to diamond named "&b&lDIAMOND STORAGE" with lore "&7Backpack: &f%{_diamonds}%", "&7Total Spendable: &f%{_totalDiamonds}%", "", "&8Total includes inventory + backpack."

    set slot 22 of {_gui} to barrier named "&c&lCLOSE" with lore "&7Click to close."
    open {_gui} to {_p}


command /diamondbackpack:
    aliases: /dbackpack, /diamondstorage
    trigger:
        set {_u} to uuid of player
        if {box::%{_u}%::tier} is not "Diamond":
            send "&b&lDIAMOND BACKPACK &8» &cThis backpack is only available while you are in Diamond Stage." to player
            stop
        diamondOpenBackpack(player)


on inventory click:
    if name of player's current inventory is "&b&lDIAMOND BACKPACK":
        cancel event
        if clicked slot is 22:
            close player's inventory
        stop


command /diamondholo [<text>]:
    permission: op
    trigger:
        if arg-1 is "set":
            if {diamond::holo-entity} is set:
                kill {diamond::holo-entity}
                delete {diamond::holo-entity}

            set {diamond::holo-location} to location of player
            diamondCreateHologram()
            send "&7&lDIAMOND &8» &aDiamond hologram placed." to player
            stop

        if arg-1 is "refresh":
            if {diamond::holo-location} is not set:
                send "&7&lDIAMOND &8» &cUse /diamondholo set first." to player
                stop

            if {diamond::holo-entity} is set:
                kill {diamond::holo-entity}
                delete {diamond::holo-entity}

            diamondCreateHologram()
            send "&7&lDIAMOND &8» &aDiamond hologram refreshed." to player
            stop

        if arg-1 is "remove":
            if {diamond::holo-entity} is set:
                kill {diamond::holo-entity}
                delete {diamond::holo-entity}

            delete {diamond::holo-location}
            send "&7&lDIAMOND &8» &cDiamond hologram removed." to player
            stop

        send "&7/diamondholo set" to player
        send "&7/diamondholo refresh" to player
        send "&7/diamondholo remove" to player


# ============================================================
# MINE REGION
# ============================================================

function diamondInside(loc: location) :: boolean:
    if {diamond::pos1} is not set:
        return false
    if {diamond::pos2} is not set:
        return false
    if world of {_loc} is not world of {diamond::pos1}:
        return false

    set {_x} to floor(x-coordinate of {_loc})
    set {_y} to floor(y-coordinate of {_loc})
    set {_z} to floor(z-coordinate of {_loc})

    set {_x1} to floor(x-coordinate of {diamond::pos1})
    set {_y1} to floor(y-coordinate of {diamond::pos1})
    set {_z1} to floor(z-coordinate of {diamond::pos1})

    set {_x2} to floor(x-coordinate of {diamond::pos2})
    set {_y2} to floor(y-coordinate of {diamond::pos2})
    set {_z2} to floor(z-coordinate of {diamond::pos2})

    set {_minX} to min({_x1}, {_x2})
    set {_maxX} to max({_x1}, {_x2})
    set {_minY} to min({_y1}, {_y2})
    set {_maxY} to max({_y1}, {_y2})
    set {_minZ} to min({_z1}, {_z2})
    set {_maxZ} to max({_z1}, {_z2})

    if {_x} < {_minX}:
        return false
    if {_x} > {_maxX}:
        return false
    if {_y} < {_minY}:
        return false
    if {_y} > {_maxY}:
        return false
    if {_z} < {_minZ}:
        return false
    if {_z} > {_maxZ}:
        return false
    return true


function diamondGenerate():
    delete {diamond::regen-pending}
    if {diamond::pos1} is not set:
        stop
    if {diamond::pos2} is not set:
        stop

    set {diamond::regenerating} to true
    set {_count} to 0

    loop blocks within {diamond::pos1} and {diamond::pos2}:
        add 1 to {_count}
        set {_roll} to random integer between 1 and 100
        if {_roll} <= {@diamond-ore-chance}:
            set loop-block to diamond ore
        else:
            set {_bx} to floor(x-coordinate of location of loop-block)
            set {_by} to floor(y-coordinate of location of loop-block)
            set {_bz} to floor(z-coordinate of location of loop-block)
            execute console command "setblock %{_bx}% %{_by}% %{_bz}% minecraft:diamond_block"

    set {diamond::total} to {_count}
    set {diamond::remaining} to {_count}
    set {diamond::percent} to 100

    wait 5 ticks
    set {diamond::regenerating} to false
    diamondRefreshHologram()


function diamondUpdatePercent():
    if {diamond::total} is not set:
        stop
    if {diamond::total} <= 0:
        stop

    if {diamond::remaining} < 0:
        set {diamond::remaining} to 0

    set {_percent} to ({diamond::remaining} / {diamond::total}) * 100
    set {diamond::percent} to floor({_percent})
    diamondRefreshHologram()

    if {diamond::percent} <= {@regen-percent}:
        if {diamond::regenerating} is not true:
            if {diamond::regen-pending} is not true:
                set {diamond::regen-pending} to true
                wait 2 ticks
                delete {diamond::regen-pending}
                if {diamond::regenerating} is not true:
                    if {diamond::percent} <= {@regen-percent}:
                        diamondGenerate()


command /diamondmine [<text>]:
    permission: op
    trigger:
        if arg-1 is "set1":
            set {diamond::pos1} to location of player
            send "&7&lDIAMOND &8» &aMine position 1 set." to player
            stop
        if arg-1 is "set2":
            set {diamond::pos2} to location of player
            send "&7&lDIAMOND &8» &aMine position 2 set." to player
            stop
        if arg-1 is "regen":
            diamondGenerate()
            send "&7&lDIAMOND &8» &aDiamond mine regenerated." to player
            stop

        send "&7/diamondmine set1" to player
        send "&7/diamondmine set2" to player
        send "&7/diamondmine regen" to player


# ============================================================
# GLOBAL MULTIPLIER INTEGRATION
# Requires BoxMultiplierSystem v10+ to be loaded.
#
# Money  -> Diamond mining/skill/stage Money rewards
# XP     -> Diamond Box XP rewards
# Skills -> chance-based mining skill procs + earned Skill Points
#
# Resources, lifetime/stage progress and upgrade COSTS are unchanged.
# ============================================================

function diamondBoostMoney(p: player, amount: number) :: number:
    return boxMultiplyMoney({_p}, {_amount})


function diamondBoostXp(p: player, amount: number) :: number:
    return boxMultiplyXp({_p}, {_amount})


function diamondBoostSkillChance(p: player, chance: number) :: number:
    return boxMultiplySkillChance({_p}, {_chance})


# Same fractional Skill Point system used by Copper.
# Example at 1.5x: +1, +2, +1, +2...
# Example at 1.15x: fractional 0.15 carries until it becomes a whole point.
# Spending Skill Points is never multiplied.
function diamondBoostSkillPoints(p: player, amount: number) :: number:
    set {_u} to uuid of {_p}

    if {box::%{_u}%::diamond-skill-point-fraction} is not set:
        set {box::%{_u}%::diamond-skill-point-fraction} to 0

    set {_skillMultiplier} to boxSkillMultiplier({_p})
    set {_scaled} to {_amount} * {_skillMultiplier}
    add {_scaled} to {box::%{_u}%::diamond-skill-point-fraction}

    set {_reward} to floor({box::%{_u}%::diamond-skill-point-fraction})
    if {_reward} > 0:
        subtract {_reward} from {box::%{_u}%::diamond-skill-point-fraction}

    return {_reward}


# ============================================================
# MINING
# ============================================================

# ============================================================
# DIAMOND SKILL CHAT FEEDBACK
# Action bars always show immediately.
# Normal skill chat is rate-limited per skill using mined-block distance,
# so repeated activations do not flood chat or pause the mining event.
# Rare Essence and Emperor's Fortune use their own detailed messages.
# ============================================================

function diamondSkillChat(p: player, skill: text, message: text):
    set {_u} to uuid of {_p}
    set {_blocks} to diamondTotalBlocks({_p})

    if {diamondstage::skill-chat-global-last::%{_u}%} is set:
        set {_last} to {diamondstage::skill-chat-global-last::%{_u}%}
        set {_difference} to {_blocks} - {_last}
        if {_difference} < 200:
            stop

    set {diamondstage::skill-chat-global-last::%{_u}%} to {_blocks}
    send "&6&lDIAMOND SKILL &8» %{_message}%" to {_p}


# ============================================================
# DIAMOND UNIQUE SKILL ENGINE
#
# Stage 6 skills are intentionally more advanced than Gold:
# 1. Diamond Surge = repeated Diamond Ore completes electrical chains for bonus Ore + matching Money/Box XP
# 2. Crystal Bank     = all mining stores charge; rare Diamond Blocks discharge it into money
# 3. Prismatic Streak       = long mining cycles advance 4 oxidation phases, then pay Diamonds + money
# 4. Crystal Essence = rare Store Credit Essence chance, no daily limit
# 5. Gem Magnet      = deterministic mining cycles pull bonus Diamond Ore + Diamonds + matching Money/Box XP
# 6. Emperor's Fortune      = long cycles award bonus Diamond Skill Points
#
# Bonus resources award proportional Money/Box XP but NEVER add fake lifetime physical mined-block progress.
# ============================================================

function diamondBonusOreMoney(amount: number) :: number:
    set {_perItem} to {@diamond-ore-money} / {@diamond-ore-drop}
    return {_perItem} * {_amount}


function diamondBonusOreXp(amount: number) :: number:
    set {_perItem} to {@diamond-ore-xp} / {@diamond-ore-drop}
    return {_perItem} * {_amount}


function diamondBonusRawMoney(amount: number) :: number:
    set {_perItem} to {@diamond-block-money} / {@diamond-block-drop}
    return {_perItem} * {_amount}


function diamondBonusRawXp(amount: number) :: number:
    set {_perItem} to {@diamond-block-xp} / {@diamond-block-drop}
    return {_perItem} * {_amount}


function diamondGiveScaledBonus(p: player, oreAmount: number, rawAmount: number):
    set {_u} to uuid of {_p}

    if {_oreAmount} > 0:
        diamondGiveOreOrBackpack({_p}, {_oreAmount})
        set {_oreMoney} to diamondBonusOreMoney({_oreAmount})
        set {_oreXp} to diamondBonusOreXp({_oreAmount})
        add diamondBoostMoney({_p}, {_oreMoney}) to balance of {_p}
        add diamondBoostXp({_p}, {_oreXp}) to {box::%{_u}%::xp}

    if {_rawAmount} > 0:
        diamondGiveDiamondsOrBackpack({_p}, {_rawAmount})
        set {_rawMoney} to diamondBonusRawMoney({_rawAmount})
        set {_rawXp} to diamondBonusRawXp({_rawAmount})
        add diamondBoostMoney({_p}, {_rawMoney}) to balance of {_p}
        add diamondBoostXp({_p}, {_rawXp}) to {box::%{_u}%::xp}


function diamondProcessUniqueSkills(p: player, materialName: text, origin: location):
    set {_u} to uuid of {_p}

    # 1) GOLDEN RUSH
    set {_level} to {box::%{_u}%::diamond-skill::conductive-chain}
    if {_level} > 0:
        if {_materialName} is "diamond-ore":
            add 1 to {diamondstage::chain-charge::%{_u}%}
            set {_needed} to diamondChainNeeded({_level})
            if {diamondstage::chain-charge::%{_u}%} >= {_needed}:
                set {diamondstage::chain-charge::%{_u}%} to 0
                set {_oreReward} to diamondChainOreReward({_level})
                set {_moneyReward} to diamondBoostMoney({_p}, diamondBonusOreMoney({_oreReward}))
                set {_xpReward} to diamondBoostXp({_p}, diamondBonusOreXp({_oreReward}))
                diamondGiveScaledBonus({_p}, {_oreReward}, 0)
                send action bar "&6&lGOLDEN RUSH &8• &f+%{_oreReward}% Ore &8• &a+$%{_moneyReward}% &8• &b+%{_xpReward}% XP" to {_p}
                diamondSkillChat({_p}, "conductive-chain", "&6Diamond Surge &7completed &8• &f+%{_oreReward}% Diamond Ore &8• &a+$%{_moneyReward}% &8• &b+%{_xpReward}% XP")
                play sound "block.beacon.power_select" with volume 0.7 and pitch 1.55 to {_p}

    # 2) MIDAS BANK
    set {_level} to {box::%{_u}%::diamond-skill::voltage-bank}
    if {_level} > 0:
        add 1 to {diamondstage::voltage::%{_u}%}
        if {_materialName} is "diamond-block":
            add 4 to {diamondstage::voltage::%{_u}%}

        set {_needed} to diamondVoltageNeeded({_level})
        if {diamondstage::voltage::%{_u}%} >= {_needed}:
            if {_materialName} is "diamond-block":
                subtract {_needed} from {diamondstage::voltage::%{_u}%}
                set {_money} to diamondVoltageMoney({_level})
                set {_moneyDisplay} to diamondBoostMoney({_p}, {_money})
                add {_moneyDisplay} to balance of {_p}
                send action bar "&e&lMIDAS BANK &8• &a+$%{_moneyDisplay}% &8• &fCharge discharged" to {_p}
                diamondSkillChat({_p}, "voltage-bank", "&eCrystal Bank &7discharged through Diamonds &8• &a+$%{_moneyDisplay}%")
                play sound "block.respawn_anchor.charge" with volume 0.8 and pitch 1.45 to {_p}

    # 3) GILDED STREAK
    set {_level} to {box::%{_u}%::diamond-skill::oxidation}
    if {_level} > 0:
        add 1 to {diamondstage::oxidation-charge::%{_u}%}
        set {_needed} to diamondGildedStreakNeeded({_level})
        if {diamondstage::oxidation-charge::%{_u}%} >= {_needed}:
            set {diamondstage::oxidation-charge::%{_u}%} to 0
            add 1 to {diamondstage::oxidation-phase::%{_u}%}
            if {diamondstage::oxidation-phase::%{_u}%} is not set:
                set {diamondstage::oxidation-phase::%{_u}%} to 1

            set {_phase} to {diamondstage::oxidation-phase::%{_u}%}
            if {_phase} >= 4:
                set {diamondstage::oxidation-phase::%{_u}%} to 0
                set {_rawReward} to diamondGildedStreakRawReward({_level})
                set {_cycleMoney} to diamondGildedStreakMoneyReward({_level})
                set {_resourceMoney} to diamondBoostMoney({_p}, diamondBonusRawMoney({_rawReward}))
                set {_resourceXp} to diamondBoostXp({_p}, diamondBonusRawXp({_rawReward}))
                set {_cycleMoneyDisplay} to diamondBoostMoney({_p}, {_cycleMoney})
                set {_totalMoney} to {_cycleMoneyDisplay} + {_resourceMoney}
                diamondGiveScaledBonus({_p}, 0, {_rawReward})
                add {_cycleMoneyDisplay} to balance of {_p}
                send action bar "&2&lGILDED STREAK &8• &f+%{_rawReward}% Raw &8• &a+$%{_totalMoney}% &8• &b+%{_resourceXp}% XP" to {_p}
                diamondSkillChat({_p}, "oxidation", "&2Prismatic Streak Cycle &7completed &8• &f+%{_rawReward}% Diamonds &8• &a+$%{_totalMoney}% &8• &b+%{_resourceXp}% XP")
                play sound "block.amethyst_block.chime" with volume 0.8 and pitch 0.9 to {_p}
            else:
                send action bar "&aGILDED STREAK &8• &fPhase %{_phase}%/4 reached" to {_p}

    # 4) ROYAL ESSENCE
    set {_level} to {box::%{_u}%::diamond-skill::essence-conductor}
    if {_level} > 0:
        set {_roll} to random integer between 1 and 10000
        set {_chance} to diamondBoostSkillChance({_p}, diamondEssenceChance({_level}))
        if {_roll} <= {_chance}:
            add 1 to {box::%{_u}%::essence}
            set {_displayChance} to {_chance} / 100
            send "" to {_p}
            send "&d&lROYAL ESSENCE!" to {_p}
            send "&7Your Diamond current found &d1 Essence&7." to {_p}
            send "&7Skill Chance: &f%{_displayChance}% PERCENT" to {_p}
            send "&7Essence Balance: &f%{box::%{_u}%::essence}%" to {_p}
            send "" to {_p}
            send action bar "&dROYAL ESSENCE &8• &f+1 Essence" to {_p}
            play sound "ui.toast.challenge_complete" with volume 0.8 and pitch 1.35 to {_p}

    # 5) TREASURE MAGNET
    set {_level} to {box::%{_u}%::diamond-skill::ore-magnet}
    if {_level} > 0:
        add 1 to {diamondstage::magnet-charge::%{_u}%}
        set {_needed} to diamondMagnetNeeded({_level})
        if {diamondstage::magnet-charge::%{_u}%} >= {_needed}:
            set {diamondstage::magnet-charge::%{_u}%} to 0
            set {_oreReward} to diamondMagnetOreReward({_level})
            set {_rawReward} to diamondMagnetRawReward({_level})
            set {_oreMoney} to diamondBoostMoney({_p}, diamondBonusOreMoney({_oreReward}))
            set {_oreXp} to diamondBoostXp({_p}, diamondBonusOreXp({_oreReward}))
            set {_rawMoney} to diamondBoostMoney({_p}, diamondBonusRawMoney({_rawReward}))
            set {_rawXp} to diamondBoostXp({_p}, diamondBonusRawXp({_rawReward}))
            set {_moneyReward} to {_oreMoney} + {_rawMoney}
            set {_xpReward} to {_oreXp} + {_rawXp}
            diamondGiveScaledBonus({_p}, {_oreReward}, {_rawReward})
            send action bar "&b&lTREASURE MAGNET &8• &f+%{_oreReward}% Ore &8• &6+%{_rawReward}% Raw &8• &a+$%{_moneyReward}% &8• &b+%{_xpReward}% XP" to {_p}
            diamondSkillChat({_p}, "ore-magnet", "&bGem Magnet &7pulled resources &8• &f+%{_oreReward}% Ore &8• &6+%{_rawReward}% Raw &8• &a+$%{_moneyReward}% &8• &b+%{_xpReward}% XP")
            play sound "entity.experience_orb.pickup" with volume 0.8 and pitch 0.75 to {_p}

    # 6) KING'S FORTUNE
    set {_level} to {box::%{_u}%::diamond-skill::power-grid}
    if {_level} > 0:
        add 1 to {diamondstage::grid-charge::%{_u}%}
        set {_needed} to diamondGridNeeded({_level})
        if {diamondstage::grid-charge::%{_u}%} >= {_needed}:
            set {diamondstage::grid-charge::%{_u}%} to 0
            set {_skillMultiplier} to boxSkillMultiplier({_p})
            set {_skillPointReward} to diamondBoostSkillPoints({_p}, 1)
            if {_skillPointReward} > 0:
                add {_skillPointReward} to {box::%{_u}%::diamond-skill-points}

            send "" to {_p}
            send "&e&lKING'S FORTUNE ONLINE!" to {_p}
            send "&7Your Diamond grid generated &e%{_skillPointReward}% bonus Skill Point(s)&7." to {_p}
            send "&7Skills Multiplier: &d%{_skillMultiplier}%x" to {_p}
            send "&7Available: &b%{box::%{_u}%::diamond-skill-points}%" to {_p}
            send "" to {_p}
            send action bar "&eKING'S FORTUNE &8• &f+%{_skillPointReward}% Diamond Skill Point(s) &8• &d%{_skillMultiplier}%x Skills" to {_p}
            play sound "entity.player.levelup" with volume 0.8 and pitch 1.4 to {_p}

    # 7) CRYSTAL BURST
    set {_level} to {box::%{_u}%::diamond-skill::crystal-burst}
    if {_level} > 0:
        add 1 to {diamondstage::crystal-burst-charge::%{_u}%}
        set {_needed} to diamondCrystalBurstNeeded({_level})
        if {diamondstage::crystal-burst-charge::%{_u}%} >= {_needed}:
            set {diamondstage::crystal-burst-charge::%{_u}%} to 0
            set {_bonus} to diamondCrystalBurstReward({_level})
            set {_moneyReward} to diamondBoostMoney({_p}, diamondBonusOreMoney({_bonus}))
            set {_xpReward} to diamondBoostXp({_p}, diamondBonusOreXp({_bonus}))
            diamondGiveScaledBonus({_p}, {_bonus}, 0)
            send action bar "&b&lCRYSTAL BURST &8• &f+%{_bonus}% Diamond Ore &8• &a+$%{_moneyReward}% &8• &b+%{_xpReward}% XP" to {_p}
            diamondSkillChat({_p}, "crystal-burst", "&bCrystal Burst &7activated &8• &f+%{_bonus}% Diamond Ore")
            play sound "block.amethyst_block.break" with volume 0.8 and pitch 1.6 to {_p}

    # 8) DEEP FOCUS
    set {_level} to {box::%{_u}%::diamond-skill::deep-focus}
    if {_level} > 0:
        add 1 to {diamondstage::deep-focus-charge::%{_u}%}
        set {_needed} to diamondDeepFocusNeeded({_level})
        if {diamondstage::deep-focus-charge::%{_u}%} >= {_needed}:
            set {diamondstage::deep-focus-charge::%{_u}%} to 0
            set {_xpBonus} to diamondDeepFocusXp({_level})
            set {_xpReward} to diamondBoostXp({_p}, {_xpBonus})
            add {_xpReward} to {box::%{_u}%::xp}
            send action bar "&3&lDEEP FOCUS &8• &b+%{_xpReward}% Box XP" to {_p}
            diamondSkillChat({_p}, "deep-focus", "&3Deep Focus &7completed &8• &b+%{_xpReward}% Box XP")
            play sound "entity.experience_orb.pickup" with volume 0.8 and pitch 1.8 to {_p}

# Visual-only Diamond equipment feedback.
# Pickaxe particles appear at the block that was successfully mined.
function diamondMineBreakParticles(origin: location):
    loop all players:
        if world of loop-player is world of {_origin}:
            if distance between loop-player and {_origin} <= 32:
                draw 5 enchant particle at {_origin} for loop-player


# Sword particles appear on the player actually hit by a valid Diamond Sword.
function diamondSwordHitParticles(origin: location):
    loop all players:
        if world of loop-player is world of {_origin}:
            if distance between loop-player and {_origin} <= 32:
                draw 5 crit particle at {_origin} for loop-player
                draw 2 enchant particle at {_origin} for loop-player


function diamondFortuneDrillCost(level: number) :: number:
    if {_level} is 1:
        return {@fortune-drill-1-cost}
    if {_level} is 2:
        return {@fortune-drill-2-cost}
    if {_level} is 3:
        return {@fortune-drill-3-cost}
    if {_level} is 4:
        return {@fortune-drill-4-cost}
    if {_level} is 5:
        return {@fortune-drill-5-cost}
    return 0


function diamondFortuneDrillChance(level: number) :: number:
    if {_level} is 1:
        return 2
    if {_level} is 2:
        return 4
    if {_level} is 3:
        return 6
    if {_level} is 4:
        return 8
    if {_level} is 5:
        return 11
    return 0


function diamondApplyFortuneDrill(p: player, materialName: text):
    set {_u} to uuid of {_p}
    set {_level} to {box::%{_u}%::diamond-fortune-drill}
    if {_level} is not set:
        stop
    if {_level} <= 0:
        stop

    if {diamondstage::fortune-drill-block-cooldown::%{_u}%} is set:
        if {diamondstage::fortune-drill-block-cooldown::%{_u}%} > 0:
            subtract 1 from {diamondstage::fortune-drill-block-cooldown::%{_u}%}
            stop

    set {_chance} to diamondBoostSkillChance({_p}, diamondFortuneDrillChance({_level}))
    set {_roll} to random integer between 1 and 100
    if {_roll} > {_chance}:
        stop

    # Prevent lucky streaks from producing several Prismatic Fortune procs in a row.
    # After a proc, the next 4 physical Diamond blocks cannot proc Prismatic Fortune.
    set {diamondstage::fortune-drill-block-cooldown::%{_u}%} to 4

    if {_materialName} is "diamond-ore":
        set {_bonus} to 5
        set {_moneyReward} to diamondBoostMoney({_p}, diamondBonusOreMoney({_bonus}))
        set {_xpReward} to diamondBoostXp({_p}, diamondBonusOreXp({_bonus}))
        diamondGiveScaledBonus({_p}, {_bonus}, 0)
        send action bar "&6&lGILDED FORTUNE &8• &f+5 Diamond Ore &8• &a+$%{_moneyReward}% &8• &b+%{_xpReward}% XP" to {_p}
        diamondSkillChat({_p}, "fortune-drill", "&6Prismatic Fortune &7activated &8• &f+5 Diamond Ore &8• &a+$%{_moneyReward}% &8• &b+%{_xpReward}% XP")
        play sound "entity.experience_orb.pickup" with volume 0.7 and pitch 1.35 to {_p}
        stop

    if {_materialName} is "diamond-block":
        set {_bonus} to 3
        set {_moneyReward} to diamondBoostMoney({_p}, diamondBonusRawMoney({_bonus}))
        set {_xpReward} to diamondBoostXp({_p}, diamondBonusRawXp({_bonus}))
        diamondGiveScaledBonus({_p}, 0, {_bonus})
        send action bar "&6&lGILDED FORTUNE &8• &f+3 Diamonds &8• &a+$%{_moneyReward}% &8• &b+%{_xpReward}% XP" to {_p}
        diamondSkillChat({_p}, "fortune-drill", "&6Prismatic Fortune &7activated &8• &f+3 Diamonds &8• &a+$%{_moneyReward}% &8• &b+%{_xpReward}% XP")
        play sound "entity.experience_orb.pickup" with volume 0.7 and pitch 1.55 to {_p}
        stop



# ============================================================
# DIAMOND 3x3 MINING
# Every current soulbound Diamond-stage pickaxe breaks a 3x3 plane.
# The manually broken centre block uses the normal reward path.
# The 8 surrounding blocks give normal base rewards/progress only,
# so mining skills and Fortune cannot multiply themselves 9 times.
# ============================================================

function diamondAward3x3Extra(p: player, materialName: text):
    set {_u} to uuid of {_p}

    if {_materialName} is "diamond-ore":
        diamondGiveOreOrBackpack({_p}, {@diamond-ore-drop})
        add diamondBoostMoney({_p}, {@diamond-ore-money}) to balance of {_p}
        add diamondBoostXp({_p}, {@diamond-ore-xp}) to {box::%{_u}%::xp}
        add 1 to {box::%{_u}%::diamond-ore-mined}
        add diamondBoostMoney({_p}, {@diamond-ore-money}) to {diamondstage::3x3-money::%{_u}%}
        add diamondBoostXp({_p}, {@diamond-ore-xp}) to {diamondstage::3x3-xp::%{_u}%}

    else if {_materialName} is "diamond-block":
        diamondGiveDiamondsOrBackpack({_p}, {@diamond-block-drop})
        add diamondBoostMoney({_p}, {@diamond-block-money}) to balance of {_p}
        add diamondBoostXp({_p}, {@diamond-block-xp}) to {box::%{_u}%::xp}
        add 1 to {box::%{_u}%::diamond-block-mined}
        add diamondBoostMoney({_p}, {@diamond-block-money}) to {diamondstage::3x3-money::%{_u}%}
        add diamondBoostXp({_p}, {@diamond-block-xp}) to {diamondstage::3x3-xp::%{_u}%}

    subtract 1 from {diamond::remaining}
    if {diamond::remaining} < 0:
        set {diamond::remaining} to 0


function diamondBreak3x3Extra(p: player, loc: location) :: number:
    if diamondInside({_loc}) is false:
        return 0

    set {_b} to block at {_loc}

    if {_b} is diamond ore:
        set {_origin} to location of {_b}
        set block at {_loc} to air
        diamondAward3x3Extra({_p}, "diamond-ore")
        diamondMineBreakParticles({_origin})
        return 1

    set {_typeText} to "%type of {_b}%"
    if {_typeText} contains "diamond block":
        set {_origin} to location of {_b}
        set block at {_loc} to air
        diamondAward3x3Extra({_p}, "diamond-block")
        diamondMineBreakParticles({_origin})
        return 1

    return 0


function diamondBreak3x3(p: player, center: location) :: number:
    set {_broken} to 0
    set {_pitch} to pitch of {_p}
    set {_yaw} to yaw of {_p}

    # Looking mostly up/down -> horizontal X/Z plane.
    if {_pitch} > 55:
        set {_l} to {_center}
        add -1 to x-coordinate of {_l}
        add -1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add -1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to x-coordinate of {_l}
        add -1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add -1 to x-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to x-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add -1 to x-coordinate of {_l}
        add 1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to x-coordinate of {_l}
        add 1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        return {_broken}

    if {_pitch} < -55:
        set {_l} to {_center}
        add -1 to x-coordinate of {_l}
        add -1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add -1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to x-coordinate of {_l}
        add -1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add -1 to x-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to x-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add -1 to x-coordinate of {_l}
        add 1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to x-coordinate of {_l}
        add 1 to z-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        return {_broken}

    # Normalize yaw into 0-360.
    while {_yaw} < 0:
        add 360 to {_yaw}
    while {_yaw} >= 360:
        subtract 360 from {_yaw}

    # Facing North/South -> X/Y wall plane.
    if {_yaw} < 45:
        set {_wallXY} to true
    else if {_yaw} >= 315:
        set {_wallXY} to true
    else if {_yaw} >= 135:
        if {_yaw} < 225:
            set {_wallXY} to true

    if {_wallXY} is true:
        set {_l} to {_center}
        add -1 to x-coordinate of {_l}
        add -1 to y-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add -1 to y-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to x-coordinate of {_l}
        add -1 to y-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add -1 to x-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to x-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add -1 to x-coordinate of {_l}
        add 1 to y-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to y-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        set {_l} to {_center}
        add 1 to x-coordinate of {_l}
        add 1 to y-coordinate of {_l}
        add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

        return {_broken}

    # Facing East/West -> Z/Y wall plane.
    set {_l} to {_center}
    add -1 to z-coordinate of {_l}
    add -1 to y-coordinate of {_l}
    add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

    set {_l} to {_center}
    add -1 to y-coordinate of {_l}
    add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

    set {_l} to {_center}
    add 1 to z-coordinate of {_l}
    add -1 to y-coordinate of {_l}
    add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

    set {_l} to {_center}
    add -1 to z-coordinate of {_l}
    add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

    set {_l} to {_center}
    add 1 to z-coordinate of {_l}
    add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

    set {_l} to {_center}
    add -1 to z-coordinate of {_l}
    add 1 to y-coordinate of {_l}
    add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

    set {_l} to {_center}
    add 1 to y-coordinate of {_l}
    add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

    set {_l} to {_center}
    add 1 to z-coordinate of {_l}
    add 1 to y-coordinate of {_l}
    add diamondBreak3x3Extra({_p}, {_l}) to {_broken}

    return {_broken}

function diamondAwardBlock(p: player, materialName: text, origin: location):
    set {_u} to uuid of {_p}

    if {_materialName} is "diamond-ore":
        diamondGiveOreOrBackpack({_p}, {@diamond-ore-drop})
        add diamondBoostMoney({_p}, {@diamond-ore-money}) to balance of {_p}
        add diamondBoostXp({_p}, {@diamond-ore-xp}) to {box::%{_u}%::xp}
        add 1 to {box::%{_u}%::diamond-ore-mined}

        set {_moneyDisplay} to diamondBoostMoney({_p}, {@diamond-ore-money})
        set {_xpDisplay} to diamondBoostXp({_p}, {@diamond-ore-xp})
        set {_dropDisplay} to {@diamond-ore-drop}
        add {_moneyDisplay} to {diamondstage::3x3-money::%{_u}%}
        add {_xpDisplay} to {diamondstage::3x3-xp::%{_u}%}

    else if {_materialName} is "diamond-block":
        diamondGiveDiamondsOrBackpack({_p}, {@diamond-block-drop})
        add diamondBoostMoney({_p}, {@diamond-block-money}) to balance of {_p}
        add diamondBoostXp({_p}, {@diamond-block-xp}) to {box::%{_u}%::xp}
        add 1 to {box::%{_u}%::diamond-block-mined}

        set {_moneyDisplay} to diamondBoostMoney({_p}, {@diamond-block-money})
        set {_xpDisplay} to diamondBoostXp({_p}, {@diamond-block-xp})
        set {_dropDisplay} to {@diamond-block-drop}
        add {_moneyDisplay} to {diamondstage::3x3-money::%{_u}%}
        add {_xpDisplay} to {diamondstage::3x3-xp::%{_u}%}

    subtract 1 from {diamond::remaining}
    if {diamond::remaining} < 0:
        set {diamond::remaining} to 0

    diamondUpdatePercent()
    diamondMineBreakParticles({_origin})
    diamondApplyFortuneDrill({_p}, {_materialName})
    diamondProcessUniqueSkills({_p}, {_materialName}, {_origin})

on break:
    if diamondInside(location of event-block) is false:
        stop

    if diamondUnlocked(player) is false:
        cancel event
        send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to player
        stop

    if {diamond::regenerating} is true:
        cancel event
        stop

    # Only the player's CURRENT soulbound Diamond-stage pickaxe can earn mine rewards.
    set {_tool} to player's tool
    set {_u} to uuid of player
    if diamondIsPickaxe({_tool}) is false:
        cancel event
        send action bar "&cDIAMOND MINE &8• &fUse your Diamond Stage Pickaxe" to player
        stop
    if diamondPickaxeBelongsTo({_tool}, player) is false:
        cancel event
        send action bar "&cDIAMOND MINE &8• &fThat pickaxe is not bound to you" to player
        stop
    if diamondPickaxeTierFromItem({_tool}) is not {box::%{_u}%::diamond-pickaxe-tier}:
        cancel event
        send action bar "&cDIAMOND MINE &8• &fUse your current Diamond Stage Pickaxe" to player
        stop

    if event-block is diamond ore:
        clear drops
        set {_origin} to location of event-block
        set {diamondstage::3x3-money::%{_u}%} to 0
        set {diamondstage::3x3-xp::%{_u}%} to 0
        diamondAwardBlock(player, "diamond-ore", {_origin})

        set {_extraBroken} to 0
        if {box::%{_u}%::diamond-pickaxe-tier} <= 2:
            if diamond3x3Allowed(player) is true:
                set {_extraBroken} to diamondBreak3x3(player, {_origin})
                if {_extraBroken} > 0:
                    diamondUpdatePercent()

        set {_totalBroken} to {_extraBroken} + 1
        set {_moneyTotal} to {diamondstage::3x3-money::%{_u}%}
        set {_xpTotal} to {diamondstage::3x3-xp::%{_u}%}
        if {box::%{_u}%::diamond-pickaxe-tier} <= 2:
            if diamond3x3Allowed(player) is true:
                send action bar "&b&l3x3 MINER &8• &f%{_totalBroken}% Blocks &8• &a+$%{_moneyTotal}% &8• &b+%{_xpTotal}% XP" to player
            else:
                send action bar "&fDIAMOND &8• &f1 Block &8• &a+$%{_moneyTotal}% &8• &b+%{_xpTotal}% XP" to player
        else:
            send action bar "&fDIAMOND &8• &f1 Block &8• &a+$%{_moneyTotal}% &8• &b+%{_xpTotal}% XP" to player
        delete {diamondstage::3x3-money::%{_u}%}
        delete {diamondstage::3x3-xp::%{_u}%}

        if {diamondstage::golden-vault-armed::%{_u}%} is true:
            delete {diamondstage::golden-vault-armed::%{_u}%}
            set {diamondstage::golden-vault-cooldown::%{_u}%} to 50 seconds from now
            diamondCacheReward(player)

        stop

    set {_brokenType} to "%type of event-block%"
    if {_brokenType} contains "diamond block":
        clear drops
        set {_origin} to location of event-block
        set {diamondstage::3x3-money::%{_u}%} to 0
        set {diamondstage::3x3-xp::%{_u}%} to 0
        diamondAwardBlock(player, "diamond-block", {_origin})

        set {_extraBroken} to 0
        if {box::%{_u}%::diamond-pickaxe-tier} <= 2:
            if diamond3x3Allowed(player) is true:
                set {_extraBroken} to diamondBreak3x3(player, {_origin})
                if {_extraBroken} > 0:
                    diamondUpdatePercent()

        set {_totalBroken} to {_extraBroken} + 1
        set {_moneyTotal} to {diamondstage::3x3-money::%{_u}%}
        set {_xpTotal} to {diamondstage::3x3-xp::%{_u}%}
        if {box::%{_u}%::diamond-pickaxe-tier} <= 2:
            if diamond3x3Allowed(player) is true:
                send action bar "&b&l3x3 MINER &8• &f%{_totalBroken}% Blocks &8• &a+$%{_moneyTotal}% &8• &b+%{_xpTotal}% XP" to player
            else:
                send action bar "&fDIAMOND &8• &f1 Block &8• &a+$%{_moneyTotal}% &8• &b+%{_xpTotal}% XP" to player
        else:
            send action bar "&fDIAMOND &8• &f1 Block &8• &a+$%{_moneyTotal}% &8• &b+%{_xpTotal}% XP" to player
        delete {diamondstage::3x3-money::%{_u}%}
        delete {diamondstage::3x3-xp::%{_u}%}

        if {diamondstage::golden-vault-armed::%{_u}%} is true:
            delete {diamondstage::golden-vault-armed::%{_u}%}
            set {diamondstage::golden-vault-cooldown::%{_u}%} to 50 seconds from now
            diamondCacheReward(player)

        stop

    cancel event


# Extra exploit protection even if a WorldGuard flag is accidentally changed.
on place:
    if diamondInside(location of event-block) is true:
        cancel event


# ============================================================
# RESOURCE COUNTS
# ============================================================

# ============================================================
# DIAMOND OVERFLOW BACKPACK
# Normal rewards go to inventory while there is room.
# Any overflow is stored virtually and remains spendable by all
# Diamond Stage pickaxe/sword/armor systems.
# ============================================================

function diamondBackpackOre(p: player) :: number:
    set {_u} to uuid of {_p}
    if {box::%{_u}%::diamond-backpack-ore} is not set:
        set {box::%{_u}%::diamond-backpack-ore} to 0
    return {box::%{_u}%::diamond-backpack-ore}


function diamondBackpackDiamonds(p: player) :: number:
    set {_u} to uuid of {_p}
    if {box::%{_u}%::diamond-backpack-diamonds} is not set:
        set {box::%{_u}%::diamond-backpack-diamonds} to 0
    return {box::%{_u}%::diamond-backpack-diamonds}


function diamondGiveOreOrBackpack(p: player, amount: number):
    if {_amount} <= 0:
        stop

    set {_u} to uuid of {_p}
    if {box::%{_u}%::diamond-backpack-ore} is not set:
        set {box::%{_u}%::diamond-backpack-ore} to 0

    loop {_amount} times:
        set {_canStore} to false
        set {_slot} to 0

        while {_slot} <= 35:
            set {_slotItem} to slot {_slot} of {_p}'s inventory

            if {_slotItem} is air:
                set {_canStore} to true
                set {_slot} to 36
            else if {_slotItem} is diamond ore:
                if item amount of {_slotItem} < 64:
                    set {_canStore} to true
                    set {_slot} to 36

            add 1 to {_slot}

        if {_canStore} is true:
            give 1 diamond ore to {_p}
        else:
            add 1 to {box::%{_u}%::diamond-backpack-ore}


function diamondGiveDiamondsOrBackpack(p: player, amount: number):
    if {_amount} <= 0:
        stop

    set {_u} to uuid of {_p}
    if {box::%{_u}%::diamond-backpack-diamonds} is not set:
        set {box::%{_u}%::diamond-backpack-diamonds} to 0

    loop {_amount} times:
        set {_canStore} to false
        set {_slot} to 0

        while {_slot} <= 35:
            set {_slotItem} to slot {_slot} of {_p}'s inventory

            if {_slotItem} is air:
                set {_canStore} to true
                set {_slot} to 36
            else if {_slotItem} is diamond:
                if item amount of {_slotItem} < 64:
                    set {_canStore} to true
                    set {_slot} to 36

            add 1 to {_slot}

        if {_canStore} is true:
            give 1 diamond to {_p}
        else:
            add 1 to {box::%{_u}%::diamond-backpack-diamonds}


function diamondRemoveOreIncludingBackpack(p: player, amount: number):
    set {_u} to uuid of {_p}
    if {box::%{_u}%::diamond-backpack-ore} is not set:
        set {box::%{_u}%::diamond-backpack-ore} to 0
    set {_left} to {_amount}

    while {_left} > 0:
        if {_p}'s inventory contains 1 diamond ore:
            remove 1 diamond ore from {_p}'s inventory
            subtract 1 from {_left}
        else:
            stop loop

    if {_left} > 0:
        subtract {_left} from {box::%{_u}%::diamond-backpack-ore}
        if {box::%{_u}%::diamond-backpack-ore} < 0:
            set {box::%{_u}%::diamond-backpack-ore} to 0


function diamondRemoveDiamondsIncludingBackpack(p: player, amount: number):
    set {_u} to uuid of {_p}
    if {box::%{_u}%::diamond-backpack-diamonds} is not set:
        set {box::%{_u}%::diamond-backpack-diamonds} to 0
    set {_left} to {_amount}

    while {_left} > 0:
        if {_p}'s inventory contains 1 diamond:
            remove 1 diamond from {_p}'s inventory
            subtract 1 from {_left}
        else:
            stop loop

    if {_left} > 0:
        subtract {_left} from {box::%{_u}%::diamond-backpack-diamonds}
        if {box::%{_u}%::diamond-backpack-diamonds} < 0:
            set {box::%{_u}%::diamond-backpack-diamonds} to 0


function diamondCountOre(p: player) :: number:
    set {_count} to 0
    loop all items in {_p}'s inventory:
        if loop-item is diamond ore:
            add item amount of loop-item to {_count}
    add diamondBackpackOre({_p}) to {_count}
    return {_count}

function diamondCountIngots(p: player) :: number:
    set {_count} to 0
    loop all items in {_p}'s inventory:
        if loop-item is diamond:
            add item amount of loop-item to {_count}
    add diamondBackpackDiamonds({_p}) to {_count}
    return {_count}

# ============================================================
# PICKAXES
# ============================================================

function diamondPickaxeTierName(tier: number) :: text:
    if {_tier} is 1:
        return "Wooden"
    if {_tier} is 2:
        return "Stone"
    if {_tier} is 3:
        return "Iron"
    if {_tier} is 4:
        return "Golden"
    if {_tier} is 5:
        return "Diamond"
    return "None"


function diamondCreatePickaxe(p: player, tier: number) :: item:
    set {_u} to uuid of {_p}
    set {_owner} to name of {_p}

    if {_tier} is 1:
        set {_item} to unbreakable wooden pickaxe
        set name of {_item} to "&f&lDIAMOND PICKAXE &8[&fWOODEN&8]"
        set custom model data of {_item} to 106001
        enchant {_item} with efficiency 8
        set {_eff} to "VIII"
    else if {_tier} is 2:
        set {_item} to unbreakable stone pickaxe
        set name of {_item} to "&f&lDIAMOND PICKAXE &8[&7STONE&8]"
        set custom model data of {_item} to 106002
        enchant {_item} with efficiency 9
        set {_eff} to "IX"
    else if {_tier} is 3:
        set {_item} to unbreakable iron pickaxe
        set name of {_item} to "&f&lDIAMOND PICKAXE &8[&fIRON&8]"
        set custom model data of {_item} to 106003
        enchant {_item} with efficiency 10
        set {_eff} to "X"
    else if {_tier} is 4:
        set {_item} to unbreakable golden pickaxe
        set name of {_item} to "&f&lDIAMOND PICKAXE &8[&eGOLDEN&8]"
        set custom model data of {_item} to 106004
        enchant {_item} with efficiency 11
        set {_eff} to "XI"
    else if {_tier} is 5:
        set {_item} to unbreakable diamond pickaxe
        set name of {_item} to "&f&lDIAMOND PICKAXE &8[&bDIAMOND&8]"
        set custom model data of {_item} to 106005
        enchant {_item} with efficiency 12
        set {_eff} to "XII"
    else:
        return air

    set {_tierName} to diamondPickaxeTierName({_tier})
    set {_fortune} to {box::%{_u}%::diamond-fortune-drill}
    if {_fortune} is not set:
        set {_fortune} to 0

    set lore of {_item} to "&8Stage 6 • Diamond", "&7Tier: &f%{_tierName}% &8(%{_tier}%/5)", "&7Owner: &f%{_owner}%", "&7Efficiency: &f%{_eff}% &8• &aInfinite", "&b3x3 Miner: &aEnabled"
    if {_tier} >= 3:
        remove "&b3x3 Miner: &aEnabled" from lore of {_item}
        add "&b3x3 Miner: &cDisabled from Iron+" to lore of {_item}

    add "" to lore of {_item}
    add "&6&lSKILLS" to lore of {_item}

    set {_skillLevel} to {box::%{_u}%::diamond-skill::conductive-chain}
    if {_skillLevel} > 0:
        add "&6Diamond Surge &8• &fLv.%{_skillLevel}%" to lore of {_item}

    set {_skillLevel} to {box::%{_u}%::diamond-skill::voltage-bank}
    if {_skillLevel} > 0:
        add "&eCrystal Bank &8• &fLv.%{_skillLevel}%" to lore of {_item}

    set {_skillLevel} to {box::%{_u}%::diamond-skill::oxidation}
    if {_skillLevel} > 0:
        add "&2Prismatic Streak &8• &fLv.%{_skillLevel}%" to lore of {_item}

    set {_skillLevel} to {box::%{_u}%::diamond-skill::essence-conductor}
    if {_skillLevel} > 0:
        add "&dCrystal Essence &8• &fLv.%{_skillLevel}%" to lore of {_item}

    set {_skillLevel} to {box::%{_u}%::diamond-skill::ore-magnet}
    if {_skillLevel} > 0:
        add "&bGem Magnet &8• &fLv.%{_skillLevel}%" to lore of {_item}

    set {_skillLevel} to {box::%{_u}%::diamond-skill::power-grid}
    if {_skillLevel} > 0:
        add "&eEmperor's Fortune &8• &fLv.%{_skillLevel}%" to lore of {_item}

    set {_skillLevel} to {box::%{_u}%::diamond-skill::crystal-burst}
    if {_skillLevel} > 0:
        add "&bCrystal Burst &8• &fLv.%{_skillLevel}%" to lore of {_item}

    set {_skillLevel} to {box::%{_u}%::diamond-skill::deep-focus}
    if {_skillLevel} > 0:
        add "&3Deep Focus &8• &fLv.%{_skillLevel}%" to lore of {_item}

    if {_fortune} > 0:
        add "&6Prismatic Fortune &8• &fLv.%{_fortune}%" to lore of {_item}

    add "" to lore of {_item}
    add "&6Diamond Detonation &8• &eRight-Click → Mine &8• &750s" to lore of {_item}
    add "" to lore of {_item}
    add "&aUnbreakable &8• Infinite Durability" to lore of {_item}
    add "&cSoulbound &8• Cannot be traded" to lore of {_item}
    add "&8Bound ID: %{_u}%" to lore of {_item}
    return {_item}
function diamondIsPickaxe(item: item type) :: boolean:
    if {_item} is air:
        return false
    if custom model data of {_item} is not set:
        return false
    set {_m} to custom model data of {_item}
    if {_m} >= 106001:
        if {_m} <= 106005:
            return true
    return false


function diamondPickaxeTierFromItem(item: item type) :: number:
    if diamondIsPickaxe({_item}) is false:
        return 0
    set {_m} to custom model data of {_item}
    return {_m} - 106000


function diamondPickaxeBelongsTo(item: item type, p: player) :: boolean:
    if diamondIsPickaxe({_item}) is false:
        return false
    set {_u} to uuid of {_p}
    set {_wanted} to "Bound ID: %{_u}%"
    loop lore of {_item}:
        if uncolored loop-value contains {_wanted}:
            return true
    return false


function diamondHasCurrentPickaxe(p: player) :: boolean:
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-pickaxe-tier}

    if {_tier} is not set:
        return false
    if {_tier} <= 0:
        return false

    # Normal inventory
    set {_slot} to 0
    while {_slot} <= 35:
        set {_found} to slot {_slot} of {_p}'s inventory
        if diamondIsPickaxe({_found}) is true:
            if diamondPickaxeTierFromItem({_found}) is {_tier}:
                if diamondPickaxeBelongsTo({_found}, {_p}) is true:
                    return true
        add 1 to {_slot}

    # Offhand
    set {_found} to offhand tool of {_p}
    if diamondIsPickaxe({_found}) is true:
        if diamondPickaxeTierFromItem({_found}) is {_tier}:
            if diamondPickaxeBelongsTo({_found}, {_p}) is true:
                return true

    # Equipped armor slots are checked too in case a custom item is moved there.
    set {_found} to helmet of {_p}
    if diamondIsPickaxe({_found}) is true:
        if diamondPickaxeTierFromItem({_found}) is {_tier}:
            if diamondPickaxeBelongsTo({_found}, {_p}) is true:
                return true

    set {_found} to chestplate of {_p}
    if diamondIsPickaxe({_found}) is true:
        if diamondPickaxeTierFromItem({_found}) is {_tier}:
            if diamondPickaxeBelongsTo({_found}, {_p}) is true:
                return true

    set {_found} to leggings of {_p}
    if diamondIsPickaxe({_found}) is true:
        if diamondPickaxeTierFromItem({_found}) is {_tier}:
            if diamondPickaxeBelongsTo({_found}, {_p}) is true:
                return true

    set {_found} to boots of {_p}
    if diamondIsPickaxe({_found}) is true:
        if diamondPickaxeTierFromItem({_found}) is {_tier}:
            if diamondPickaxeBelongsTo({_found}, {_p}) is true:
                return true

    # Vanilla Ender Chest
    set {_slot} to 0
    while {_slot} <= 26:
        set {_found} to slot {_slot} of {_p}'s ender chest
        if diamondIsPickaxe({_found}) is true:
            if diamondPickaxeTierFromItem({_found}) is {_tier}:
                if diamondPickaxeBelongsTo({_found}, {_p}) is true:
                    return true
        add 1 to {_slot}

    return false


function diamondRemovePickaxes(p: player):
    loop all items in {_p}'s inventory:
        if diamondIsPickaxe(loop-item) is true:
            remove loop-item from {_p}'s inventory


function diamondGiveCurrentPickaxe(p: player):
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-pickaxe-tier}
    if {_tier} <= 0:
        stop

    # Anti-dupe: do not create another current owned item if the
    # same stage/tier item already exists in carried gear or Ender Chest.
    if diamondHasCurrentPickaxe({_p}) is true:
        stop

    diamondRemovePickaxes({_p})
    give diamondCreatePickaxe({_p}, {_tier}) to {_p}


# Gives the Stage 6 starter tool exactly once when Diamond access begins.
# Tier 1 is free because players need a pickaxe before they can earn Diamond Ore/Ingots.
function diamondEnsureStarterPickaxe(p: player):
    diamondInit({_p})
    if diamondUnlocked({_p}) is false:
        stop

    set {_u} to uuid of {_p}
    if {box::%{_u}%::diamond-pickaxe-tier} > 0:
        stop

    set {box::%{_u}%::diamond-pickaxe-tier} to 1

    # Keep the existing one-time pickaxe Skill Point progression.
    if {box::%{_u}%::diamond-pickaxe-skill-bonus::1} is not true:
        set {_starterSkillBonus} to diamondBoostSkillPoints({_p}, 1)
        if {_starterSkillBonus} > 0:
            add {_starterSkillBonus} to {box::%{_u}%::diamond-skill-points}
        set {box::%{_u}%::diamond-pickaxe-skill-bonus::1} to true

    diamondGiveCurrentPickaxe({_p})

    send "" to {_p}
    send "&f&lDIAMOND STAGE STARTER" to {_p}
    send "&7You received your &fWooden Diamond Pickaxe&7." to {_p}
    send "&7Use it to mine &fDiamond Ore &7and rare &fDiamond Blocks&7 for upgrades." to {_p}
    if {_starterSkillBonus} is set:
        set {_skillMultiplier} to boxSkillMultiplier({_p})
        send "&7Starter Skill Points: &b+%{_starterSkillBonus}% &8• &d%{_skillMultiplier}%x Skills" to {_p}
    send "" to {_p}
    send action bar "&fDIAMOND STARTER &8• &fWooden Diamond Pickaxe received" to {_p}
    play sound "entity.player.levelup" with volume 0.8 and pitch 1.3 to {_p}


function diamondPickaxeOreCost(tier: number) :: number:
    if {_tier} is 1:
        return {@wooden-diamond-cost}
    if {_tier} is 2:
        return {@stone-diamond-cost}
    if {_tier} is 3:
        return {@iron-diamond-cost}
    if {_tier} is 4:
        return {@golden-diamond-cost}
    if {_tier} is 5:
        return {@diamond-diamond-cost}
    return 0


function diamondPickaxeIngotCost(tier: number) :: number:
    if {_tier} is 1:
        return {@wooden-diamond-block-cost}
    if {_tier} is 2:
        return {@stone-diamond-block-cost}
    if {_tier} is 3:
        return {@iron-diamond-block-cost}
    if {_tier} is 4:
        return {@golden-diamond-block-cost}
    if {_tier} is 5:
        return {@diamond-diamond-block-cost}
    return 0


function diamondGuiPickaxe(p: player, tier: number) :: item:
    set {_u} to uuid of {_p}
    set {_owned} to {box::%{_u}%::diamond-pickaxe-tier}
    if {_owned} is not set:
        set {_owned} to 0

    set {_item} to diamondCreatePickaxe({_p}, {_tier})
    set {_oreCost} to diamondPickaxeOreCost({_tier})
    set {_diamondCost} to diamondPickaxeIngotCost({_tier})
    set {_oreHeld} to diamondCountOre({_p})
    set {_diamondsHeld} to diamondCountIngots({_p})
    set {_tierName} to diamondPickaxeTierName({_tier})

    set lore of {_item} to "&8Stage 6 • Diamond Pickaxe", "&7Tier: &f%{_tierName}% &8(%{_tier}%/5)", "", "&b&lCOST", "&7Diamond Ore: &f%{_oreHeld}% &8/ &f%{_oreCost}%", "&7Diamonds: &f%{_diamondsHeld}% &8/ &f%{_diamondCost}%"

    # Tier 1 is the first pickaxe. There is NO previous pickaxe.
    if {_tier} is 1:
        if {_owned} <= 0:
            add "" to lore of {_item}
            add "&a✔ FREE STARTER PICKAXE" to lore of {_item}
            add "&eClick to claim." to lore of {_item}
        else if {_owned} is 1:
            add "" to lore of {_item}
            add "&a✔ CURRENT PICKAXE" to lore of {_item}
        else:
            add "" to lore of {_item}
            add "&a✔ COMPLETED" to lore of {_item}
        return {_item}

    if {_tier} < {_owned}:
        add "" to lore of {_item}
        add "&a✔ COMPLETED" to lore of {_item}
    else if {_tier} is {_owned}:
        add "" to lore of {_item}
        add "&a✔ CURRENT PICKAXE" to lore of {_item}
    else if {_tier} is {_owned} + 1:
        add "" to lore of {_item}
        if {_oreHeld} >= {_oreCost}:
            if {_diamondsHeld} >= {_diamondCost}:
                add "&a✔ READY TO UNLOCK" to lore of {_item}
                add "&eClick to purchase." to lore of {_item}
            else:
                add "&e▶ NEXT PICKAXE" to lore of {_item}
                add "&cMore Diamonds required." to lore of {_item}
        else:
            add "&e▶ NEXT PICKAXE" to lore of {_item}
            add "&cMore Diamond Ore required." to lore of {_item}
    else:
        add "" to lore of {_item}
        add "&c✖ LOCKED" to lore of {_item}
        add "&7Unlock the previous pickaxe tier first." to lore of {_item}

    return {_item}

function diamondPickaxeNextName(currentTier: number) :: text:
    if {_currentTier} is 0:
        return "Wooden Diamond Pickaxe"
    if {_currentTier} is 1:
        return "Stone Diamond Pickaxe"
    if {_currentTier} is 2:
        return "Iron Diamond Pickaxe"
    if {_currentTier} is 3:
        return "Golden Diamond Pickaxe"
    if {_currentTier} is 4:
        return "Diamond Diamond Pickaxe"
    return "MAX"


# ============================================================
# DIAMOND PICKAXE ACTIVE ABILITY - GOLDEN VAULT
# Right-click the player's CURRENT soulbound Diamond Stage Pickaxe to ARM it.
# The cache activates on the next manually mined Diamond Ore / Diamond Block.
# On activation it awards a larger Stage 6 resource cache:
# - 20-30 Diamond Ore
# - 8-12 Diamonds
# The bonus resources also award proportional Money + Box XP.
# They do NOT add fake lifetime Stage Progress or reduce mine health.
# 45 second cooldown starts when the armed cache activates.
# ============================================================

function diamondCacheReward(p: player):
    set {_u} to uuid of {_p}

    set {_oreReward} to random integer between 45 and 65
    set {_rawReward} to random integer between 18 and 26

    set {_oreMoney} to diamondBoostMoney({_p}, diamondBonusOreMoney({_oreReward}))
    set {_oreXp} to diamondBoostXp({_p}, diamondBonusOreXp({_oreReward}))
    set {_rawMoney} to diamondBoostMoney({_p}, diamondBonusRawMoney({_rawReward}))
    set {_rawXp} to diamondBoostXp({_p}, diamondBonusRawXp({_rawReward}))

    set {_moneyReward} to {_oreMoney} + {_rawMoney}
    set {_xpReward} to {_oreXp} + {_rawXp}

    diamondGiveScaledBonus({_p}, {_oreReward}, {_rawReward})


    # Diamond Detonation bonus resources count toward Diamond -> Diamond progression.
    # Diamond Ore is 1 item per equivalent block.
    # Rare Diamond Blocks award {@diamond-block-drop} Diamonds each.
    add {_oreReward} to {box::%{_u}%::diamond-ore-mined}

    set {_rareProgress} to floor({_rawReward} / {@diamond-block-drop})
    if {_rareProgress} < 1:
        set {_rareProgress} to 1
    add {_rareProgress} to {box::%{_u}%::diamond-block-mined}

    set {_vaultProgressAdded} to {_oreReward} + {_rareProgress}
    set {diamondstage::golden-vault-progress-added::%{_u}%} to {_vaultProgressAdded}

    set {_origin} to location of {_p}
    loop all players:
        if world of loop-player is world of {_origin}:
            if distance between loop-player and {_origin} <= 32:
                draw 6 enchant particle at {_origin} for loop-player
                draw 3 sculk soul particle at {_origin} for loop-player

    send "" to {_p}
    send "&6&lGOLDEN VAULT! &8(+%{_vaultProgressAdded}% progress)" to {_p}
    send "&7You uncovered a royal Stage 6 treasure vault." to {_p}
    send "&8• &f+%{_oreReward}% Diamond Ore" to {_p}
    send "&8• &6+%{_rawReward}% Diamonds" to {_p}
    send "&8• &a+$%{_moneyReward}% &8• &b+%{_xpReward}% Box XP" to {_p}
    send "" to {_p}

    send action bar "&6&lGOLDEN VAULT &8• &f+%{_oreReward}% Ore &8• &6+%{_rawReward}% Raw &8• &c45s cooldown" to {_p}
    play sound "block.respawn_anchor.charge" with volume 1 and pitch 1.45 to {_p}


on right click:
    set {_tool} to player's tool
    if diamondIsPickaxe({_tool}) is false:
        stop

    set {_u} to uuid of player

    if diamondUnlocked(player) is false:
        stop
    if diamondPickaxeBelongsTo({_tool}, player) is false:
        stop
    if diamondPickaxeTierFromItem({_tool}) is not {box::%{_u}%::diamond-pickaxe-tier}:
        send action bar "&cGOLDEN VAULT &8• &fUse your current Diamond Stage Pickaxe" to player
        stop

    if {diamondstage::golden-vault-cooldown::%{_u}%} is set:
        if {diamondstage::golden-vault-cooldown::%{_u}%} > now:
            set {_remaining} to difference between {diamondstage::golden-vault-cooldown::%{_u}%} and now
            send action bar "&cGOLDEN VAULT &8• &fCooldown: %{_remaining}%" to player
            stop

    if {diamondstage::golden-vault-armed::%{_u}%} is true:
        send action bar "&6GOLDEN VAULT &8• &aARMED &8• &fMine a Diamond block to activate" to player
        stop

    set {diamondstage::golden-vault-armed::%{_u}%} to true
    send "&6&lGOLDEN VAULT &8» &7Armed. &fMine Diamond Ore or a Diamond Block to activate it." to player
    send action bar "&6&lGOLDEN VAULT &8• &aARMED &8• &fMine a block to activate" to player
    play sound "block.respawn_anchor.charge" with volume 0.8 and pitch 1.55 to player

# ============================================================
# PICKAXE UPGRADE READY NOTIFICATIONS
# Same one-time notification behaviour as Woodland.
# ============================================================

every 3 seconds:
    loop all players:
        if diamondUnlocked(loop-player) is true:
            diamondInit(loop-player)

            set {_p} to loop-player
            set {_u} to uuid of {_p}
            set {_tier} to {box::%{_u}%::diamond-pickaxe-tier}

            if {_tier} < 5:
                set {_target} to {_tier} + 1
                set {_needDiamond} to diamondPickaxeOreCost({_target})
                set {_needDiamondBlocks} to diamondPickaxeIngotCost({_target})
                set {_diamondOwned} to diamondCountOre({_p})
                set {_diamondBlocksOwned} to diamondCountIngots({_p})

                if {_diamondOwned} >= {_needDiamond}:
                    if {_diamondBlocksOwned} >= {_needDiamondBlocks}:
                        if {box::%{_u}%::diamond-pickaxe-ready::%{_target}%} is not true:
                            set {box::%{_u}%::diamond-pickaxe-ready::%{_target}%} to true

                            set {_nextName} to diamondPickaxeNextName({_tier})

                            send "" to {_p}
                            send "&7&lPICKAXE UPGRADE READY!" to {_p}
                            send "&7You can now unlock the &f%{_nextName}%&7." to {_p}
                            send "&7Visit the &7Diamond Blacksmith &7to upgrade." to {_p}
                            send "" to {_p}

                            send action bar "&7PICKAXE READY &8• &f%{_nextName}% &8• &eVisit the Blacksmith" to {_p}
                            play sound "entity.player.levelup" with volume 1 and pitch 1.2 to {_p}



# ============================================================
# DIAMOND FANCYNPC BLACKSMITH
# Mirrors the working Woodland FancyNPC setup.
# ============================================================

function diamondRemoveNpc():
    execute console command "npc remove {@diamond-npc-id}"
    delete {diamondstage::npc-location}


function diamondSpawnNpc(p: player):
    set {_loc} to location of {_p}

    execute console command "npc remove {@diamond-npc-id}"
    wait 2 ticks

    execute {_p} command "npc create {@diamond-npc-id} --type player"
    wait 2 ticks

    execute {_p} command "npc move_here {@diamond-npc-id}"
    wait 2 ticks

    execute console command "npc displayname {@diamond-npc-id} <gradient:#FFD700:#FFF2A8><bold>DIAMOND BLACKSMITH</bold></gradient>"
    wait 2 ticks

    execute console command "npc action {@diamond-npc-id} RIGHT_CLICK clear"
    wait 2 ticks
    execute console command "npc action {@diamond-npc-id} RIGHT_CLICK add player_command diamond"

    set {diamondstage::npc-location} to {_loc}


command /diamondnpc [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            send ""
            send "&7&lDIAMOND FANCYNPC"
            send "&8&m--------------------------------"
            send "&f/diamondnpc spawn"
            send "&7Creates or moves the Diamond Blacksmith here."
            send ""
            send "&f/diamondnpc remove"
            send "&7Removes the Diamond Blacksmith."
            send ""
            send "&f/diamondnpc tp"
            send "&7Teleports you to the saved Diamond Blacksmith location."
            send "&8&m--------------------------------"
            send ""
            stop

        if arg-1 is "spawn":
            diamondSpawnNpc(player)
            send ""
            send "&7&lDIAMOND &8» &aFancyNpc Blacksmith created."
            send "&7NPC ID: &f{@diamond-npc-id}"
            send "&7Right-click action: &f/diamond"
            send ""
            stop

        if arg-1 is "remove":
            diamondRemoveNpc()
            send "&7&lDIAMOND &8» &cFancyNpc Blacksmith removed."
            stop

        if arg-1 is "tp":
            if {diamondstage::npc-location} is not set:
                send "&cThere is no saved Diamond Blacksmith location."
                stop

            teleport player to {diamondstage::npc-location}
            send "&7&lDIAMOND &8» &aTeleported to the Blacksmith location."
            stop

        send "&cUnknown option. Use &f/diamondnpc&c."


# ============================================================
# DIAMOND FANCYNPC SPIRAL PARTICLES
# Same proven particle syntax as Woodland.
# ============================================================

every 2 ticks:
    if {diamondstage::npc-location} is set:
        if {diamondstage::particle-step} is not set:
            set {diamondstage::particle-step} to 0

        add 1 to {diamondstage::particle-step}
        if {diamondstage::particle-step} > 23:
            set {diamondstage::particle-step} to 0

        set {_step} to {diamondstage::particle-step}
        set {_base} to {diamondstage::npc-location}

        set {_cx} to x-coordinate of {_base}
        set {_cy} to y-coordinate of {_base}
        set {_cz} to z-coordinate of {_base}

        set {_yOffset} to 2.05 - ({_step} * 0.082)

        set {_circleStep} to {_step}
        if {_circleStep} > 11:
            subtract 12 from {_circleStep}

        if {_circleStep} is 0:
            set {_dx} to 0.42
            set {_dz} to 0
        else if {_circleStep} is 1:
            set {_dx} to 0.36
            set {_dz} to 0.21
        else if {_circleStep} is 2:
            set {_dx} to 0.21
            set {_dz} to 0.36
        else if {_circleStep} is 3:
            set {_dx} to 0
            set {_dz} to 0.42
        else if {_circleStep} is 4:
            set {_dx} to -0.21
            set {_dz} to 0.36
        else if {_circleStep} is 5:
            set {_dx} to -0.36
            set {_dz} to 0.21
        else if {_circleStep} is 6:
            set {_dx} to -0.42
            set {_dz} to 0
        else if {_circleStep} is 7:
            set {_dx} to -0.36
            set {_dz} to -0.21
        else if {_circleStep} is 8:
            set {_dx} to -0.21
            set {_dz} to -0.36
        else if {_circleStep} is 9:
            set {_dx} to 0
            set {_dz} to -0.42
        else if {_circleStep} is 10:
            set {_dx} to 0.21
            set {_dz} to -0.36
        else:
            set {_dx} to 0.36
            set {_dz} to -0.21

        set {_particleLoc} to {_base}
        set x-coordinate of {_particleLoc} to {_cx} + {_dx}
        set y-coordinate of {_particleLoc} to {_cy} + {_yOffset}
        set z-coordinate of {_particleLoc} to {_cz} + {_dz}

        set {_particleLoc2} to {_base}
        set x-coordinate of {_particleLoc2} to {_cx} - {_dx}
        set y-coordinate of {_particleLoc2} to {_cy} + {_yOffset} - 0.08
        set z-coordinate of {_particleLoc2} to {_cz} - {_dz}

        loop all players:
            if world of loop-player is world of {_base}:
                if distance between loop-player and {_base} <= 32:
                    draw 1 cherry leaves particle at {_particleLoc} for loop-player
                    draw 1 cherry leaves particle at {_particleLoc2} for loop-player


# ============================================================
# SWORDS
# ============================================================

function diamondIsSword(item: item type) :: boolean:
    if {_item} is air:
        return false
    if custom model data of {_item} is not set:
        return false
    set {_m} to custom model data of {_item}
    if {_m} >= 107001:
        if {_m} <= 107005:
            return true
    return false


function diamondSwordTierFromItem(item: item type) :: number:
    if diamondIsSword({_item}) is false:
        return 0
    return (custom model data of {_item}) - 107000


function diamondSwordBelongsTo(item: item type, p: player) :: boolean:
    if diamondIsSword({_item}) is false:
        return false
    set {_u} to uuid of {_p}
    set {_wanted} to "Bound ID: %{_u}%"
    loop lore of {_item}:
        if uncolored loop-value contains {_wanted}:
            return true
    return false


function diamondSwordTierName(tier: number) :: text:
    if {_tier} is 1:
        return "Wooden"
    if {_tier} is 2:
        return "Stone"
    if {_tier} is 3:
        return "Iron"
    if {_tier} is 4:
        return "Golden"
    if {_tier} is 5:
        return "Diamond"
    return "None"


function diamondSwordSharpnessCap(tier: number) :: number:
    if {_tier} <= 0:
        return 0
    if {_tier} <= 2:
        return 1
    if {_tier} is 3:
        return 2
    if {_tier} is 4:
        return 4
    return 5


function diamondCreateSword(p: player, tier: number) :: item:
    set {_u} to uuid of {_p}
    set {_owner} to name of {_p}
    set {_sharp} to {box::%{_u}%::diamond-sword-sharpness}
    set {_cap} to diamondSwordSharpnessCap({_tier})
    if {_sharp} > {_cap}:
        set {_sharp} to {_cap}

    if {_tier} is 1:
        set {_item} to unbreakable wooden sword
        set custom model data of {_item} to 107001
    else if {_tier} is 2:
        set {_item} to unbreakable stone sword
        set custom model data of {_item} to 107002
    else if {_tier} is 3:
        set {_item} to unbreakable iron sword
        set custom model data of {_item} to 107003
    else if {_tier} is 4:
        set {_item} to unbreakable golden sword
        set custom model data of {_item} to 107004
    else if {_tier} is 5:
        set {_item} to unbreakable diamond sword
        set custom model data of {_item} to 107005
    else:
        return air

    set {_name} to diamondSwordTierName({_tier})
    set name of {_item} to "&6&lDIAMOND SWORD &8[&f%{_name}%&8]"

    set {_conductivity} to {box::%{_u}%::diamond-sword-conductivity}
    set {_critical} to {box::%{_u}%::diamond-sword-critical-edge}
    set {_executioner} to {box::%{_u}%::diamond-sword-executioner}
    set {_knockback} to {box::%{_u}%::diamond-sword-knockback}

    if {_sharp} is 1:
        enchant {_item} with sharpness 1
    else if {_sharp} is 2:
        enchant {_item} with sharpness 2
    else if {_sharp} is 3:
        enchant {_item} with sharpness 3
    else if {_sharp} is 4:
        enchant {_item} with sharpness 4
    else if {_sharp} >= 5:
        enchant {_item} with sharpness 5


    set lore of {_item} to "&8Stage 6 • Diamond", "&7Tier: &f%{_name}% &8(%{_tier}%/5)", "&7Owner: &f%{_owner}%", "", "&6&lDIAMOND COMBAT", "&7Passive: &eDiamond Strike", "&7Sword Tier and Combat Upgrades", "&7both improve this weapon.", "", "&7&lEQUIPMENT UPGRADES"
    if {_sharp} <= 0:
        add "&7Prismatic Edge: &8Not Upgraded" to lore of {_item}
    else:
        add "&7Prismatic Edge: &f%{_sharp}% &8/ &f5" to lore of {_item}
    if {_conductivity} <= 0:
        add "&7Voidlight: &8Not Upgraded" to lore of {_item}
    else:
        add "&7Voidlight: &6%{_conductivity}% &8/ &f3" to lore of {_item}
    if {_critical} <= 0:
        add "&7Crystal Momentum: &8Not Upgraded" to lore of {_item}
    else:
        add "&7Crystal Momentum: &b%{_critical}% &8/ &f3" to lore of {_item}
    if {_executioner} <= 0:
        add "&7Armor Shatter: &8Not Upgraded" to lore of {_item}
    else:
        add "&7Armor Shatter: &e%{_executioner}% &8/ &f3" to lore of {_item}
    if {_knockback} <= 0:
        add "&7Diamond Tempo: &8Not Upgraded" to lore of {_item}
    else:
        add "&7Diamond Tempo: &a%{_knockback}% &8/ &f2" to lore of {_item}
    add "" to lore of {_item}
    add "&aUnbreakable &8• Infinite Durability" to lore of {_item}
    add "&cSoulbound &8• Cannot be traded" to lore of {_item}
    add "&8Bound ID: %{_u}%" to lore of {_item}
    return {_item}


function diamondHasCurrentSword(p: player) :: boolean:
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-sword-tier}

    if {_tier} is not set:
        return false
    if {_tier} <= 0:
        return false

    set {_slot} to 0
    while {_slot} <= 35:
        set {_found} to slot {_slot} of {_p}'s inventory
        if diamondIsSword({_found}) is true:
            if diamondSwordTierFromItem({_found}) is {_tier}:
                if diamondSwordBelongsTo({_found}, {_p}) is true:
                    return true
        add 1 to {_slot}

    set {_found} to offhand tool of {_p}
    if diamondIsSword({_found}) is true:
        if diamondSwordTierFromItem({_found}) is {_tier}:
            if diamondSwordBelongsTo({_found}, {_p}) is true:
                return true

    set {_slot} to 0
    while {_slot} <= 26:
        set {_found} to slot {_slot} of {_p}'s ender chest
        if diamondIsSword({_found}) is true:
            if diamondSwordTierFromItem({_found}) is {_tier}:
                if diamondSwordBelongsTo({_found}, {_p}) is true:
                    return true
        add 1 to {_slot}

    return false


function diamondRemoveSwords(p: player):
    loop all items in {_p}'s inventory:
        if diamondIsSword(loop-item) is true:
            remove loop-item from {_p}'s inventory


function diamondGiveCurrentSword(p: player):
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-sword-tier}
    if {_tier} <= 0:
        stop

    # Anti-dupe: do not create another current owned item if the
    # same stage/tier item already exists in carried gear or Ender Chest.
    if diamondHasCurrentSword({_p}) is true:
        stop

    diamondRemoveSwords({_p})
    give diamondCreateSword({_p}, {_tier}) to {_p}


# ============================================================
# DIAMOND SWORD COMBAT
# Stage 6 is where weapons begin gaining real upgrade paths.
# ============================================================

function diamondSwordProcChance(tier: number) :: number:
    if {_tier} is 1:
        return 70
    if {_tier} is 2:
        return 95
    if {_tier} is 3:
        return 125
    if {_tier} is 4:
        return 160
    if {_tier} is 5:
        return 200
    return 0


function diamondSwordBonusDamage(tier: number) :: number:
    if {_tier} is 1:
        return 0.75
    if {_tier} is 2:
        return 1.0
    if {_tier} is 3:
        return 1.35
    if {_tier} is 4:
        return 1.75
    if {_tier} is 5:
        return 2.25
    return 0


function diamondMidasEdgeExtraChance(level: number) :: number:
    if {_level} is 1:
        return 25
    if {_level} is 2:
        return 50
    if {_level} >= 3:
        return 80
    return 0


function diamondMidasEdgeExtraDamage(level: number) :: number:
    if {_level} is 1:
        return 0.25
    if {_level} is 2:
        return 0.5
    if {_level} >= 3:
        return 0.75
    return 0


function diamondCriticalChance(level: number) :: number:
    if {_level} is 1:
        return 40
    if {_level} is 2:
        return 70
    if {_level} >= 3:
        return 100
    return 0


function diamondCriticalBonus(level: number) :: number:
    if {_level} is 1:
        return 0.5
    if {_level} is 2:
        return 1
    if {_level} >= 3:
        return 1.5
    return 0


function diamondKingsJudgmentPercent(level: number) :: number:
    if {_level} is 1:
        return 5
    if {_level} is 2:
        return 10
    if {_level} >= 3:
        return 15
    return 0


on damage:
    if attacker is not a player:
        stop
    if victim is not a player:
        stop

    set {_p} to attacker
    set {_v} to victim
    set {_tool} to {_p}'s tool

    if diamondIsSword({_tool}) is false:
        stop

    if diamondSwordBelongsTo({_tool}, {_p}) is false:
        cancel event
        send action bar "&cDIAMOND SWORD &8• &fThis sword is not bound to you" to {_p}
        stop

    set {_u} to uuid of {_p}
    set {_tier} to diamondSwordTierFromItem({_tool})
    if {_tier} is not {box::%{_u}%::diamond-sword-tier}:
        cancel event
        send action bar "&cDIAMOND SWORD &8• &fUse your current Diamond Sword" to {_p}
        stop

    set {_hitLoc} to location of {_v}
    add 1 to y-coordinate of {_hitLoc}
    diamondSwordHitParticles({_hitLoc})

    # Built-in Diamond Sword passive: Diamond Strike.
    # Tier alone controls this passive; Diamond enchants below are separate mechanics.
    set {_chance} to diamondSwordProcChance({_tier})
    set {_roll} to random integer between 1 and 1000
    if {_roll} <= {_chance}:
        set {_bonus} to diamondSwordBonusDamage({_tier})
        add {_bonus} to damage
        send action bar "&e&lMIDAS STRIKE &8• &f+%{_bonus}% bonus damage" to {_p}
        play sound "block.respawn_anchor.charge" with volume 0.55 and pitch 1.65 to {_p}

        if {_tier} >= 4:
            execute console command "effect give %name of {_p}% minecraft:speed 2 0 true"
        if {_tier} >= 5:
            execute console command "effect give %name of {_v}% minecraft:glowing 2 0 true"

    # SUNFIRE I-III
    # A Diamond-only proc: burst damage + a short burn.
    set {_sunfire} to {box::%{_u}%::diamond-sword-conductivity}
    if {_sunfire} > 0:
        if {_sunfire} is 1:
            set {_sunChance} to 45
            set {_sunBonus} to 0.75
            set {_burnSeconds} to 1
        else if {_sunfire} is 2:
            set {_sunChance} to 75
            set {_sunBonus} to 1.25
            set {_burnSeconds} to 2
        else:
            set {_sunChance} to 110
            set {_sunBonus} to 1.75
            set {_burnSeconds} to 3

        set {_sunRoll} to random integer between 1 and 1000
        if {_sunRoll} <= {_sunChance}:
            add {_sunBonus} to damage
            execute console command "effect give %name of {_v}% minecraft:glowing %{_burnSeconds}% 0 true"
            set {_burnTicks} to {_burnSeconds} * 20
            execute console command "data merge entity %uuid of {_v}% {Fire:%{_burnTicks}%s}"
            send action bar "&b&lVOIDLIGHT &8• &f+%{_sunBonus}% damage &8• &6Ignited" to {_p}
            play sound "item.firecharge.use" with volume 0.55 and pitch 1.35 to {_p}

    # ROYAL MOMENTUM I-III
    # Consecutive hits within 4 seconds build toward a guaranteed burst.
    set {_momentum} to {box::%{_u}%::diamond-sword-critical-edge}
    if {_momentum} > 0:
        if {diamondstage::momentum-last-hit::%{_u}%} is set:
            if difference between now and {diamondstage::momentum-last-hit::%{_u}%} > 4 seconds:
                set {diamondstage::momentum-hits::%{_u}%} to 0

        set {diamondstage::momentum-last-hit::%{_u}%} to now
        add 1 to {diamondstage::momentum-hits::%{_u}%}

        if {_momentum} is 1:
            set {_needed} to 5
            set {_momentumBonus} to 1
        else if {_momentum} is 2:
            set {_needed} to 4
            set {_momentumBonus} to 1.5
        else:
            set {_needed} to 3
            set {_momentumBonus} to 2

        if {diamondstage::momentum-hits::%{_u}%} >= {_needed}:
            set {diamondstage::momentum-hits::%{_u}%} to 0
            add {_momentumBonus} to damage
            execute console command "effect give %name of {_p}% minecraft:speed 2 0 true"
            send action bar "&3&lCRYSTAL MOMENTUM &8• &f+%{_momentumBonus}% damage &8• &bSpeed" to {_p}
            play sound "entity.player.attack.sweep" with volume 0.65 and pitch 1.35 to {_p}

    # CROWN BREAKER I-III
    # Unlike Copper's low-health finisher, Diamond rewards an opening assault.
    set {_breaker} to {box::%{_u}%::diamond-sword-executioner}
    if {_breaker} > 0:
        set {_healthPercent} to (health of {_v} * 100) / max health of {_v}
        if {_healthPercent} >= 75:
            if {_breaker} is 1:
                set {_percent} to 6
            else if {_breaker} is 2:
                set {_percent} to 10
            else:
                set {_percent} to 15

            set {_breakerBonus} to damage * ({_percent} / 100)
            add {_breakerBonus} to damage
            send action bar "&d&lARMOR SHATTER &8• &fOpening damage +%{_percent}% percent" to {_p}

    # KING'S TEMPO I-II
    # Replaces Copper-style Knockback with a Diamond-only mobility proc.
    set {_tempo} to {box::%{_u}%::diamond-sword-knockback}
    if {_tempo} > 0:
        if {_tempo} is 1:
            set {_tempoChance} to 120
            set {_tempoSeconds} to 2
        else:
            set {_tempoChance} to 200
            set {_tempoSeconds} to 3

        set {_tempoRoll} to random integer between 1 and 1000
        if {_tempoRoll} <= {_tempoChance}:
            execute console command "effect give %name of {_p}% minecraft:speed %{_tempoSeconds}% 0 true"
            send action bar "&a&lKING'S TEMPO &8• &fSpeed activated" to {_p}


# ============================================================
# ARMOR
# ============================================================

function diamondIsArmor(item: item type) :: boolean:
    if {_item} is air:
        return false
    if custom model data of {_item} is not set:
        return false
    set {_m} to custom model data of {_item}
    if {_m} >= 108001:
        if {_m} <= 108004:
            return true
    return false


function diamondArmorPieceFromItem(item: item type) :: text:
    if diamondIsArmor({_item}) is false:
        return "none"
    set {_m} to custom model data of {_item}
    if {_m} is 108001:
        return "helmet"
    if {_m} is 108002:
        return "chestplate"
    if {_m} is 108003:
        return "leggings"
    if {_m} is 108004:
        return "boots"
    return "none"


function diamondArmorBelongsTo(item: item type, p: player) :: boolean:
    if diamondIsArmor({_item}) is false:
        return false
    set {_u} to uuid of {_p}
    set {_wanted} to "Bound ID: %{_u}%"
    loop lore of {_item}:
        if uncolored loop-value contains {_wanted}:
            return true
    return false


function diamondArmorDisplayName(piece: text) :: text:
    if {_piece} is "helmet":
        return "Diamond-Forged Helmet"
    if {_piece} is "chestplate":
        return "Diamond-Forged Chestplate"
    if {_piece} is "leggings":
        return "Diamond-Forged Leggings"
    if {_piece} is "boots":
        return "Diamond-Forged Boots"
    return "Diamond-Forged Armor"


function diamondCreateArmor(p: player, piece: text) :: item:
    set {_u} to uuid of {_p}
    set {_owner} to name of {_p}
    set {_prot} to {box::%{_u}%::diamond-armor-prot::%{_piece}%}

    if {_piece} is "helmet":
        set {_item} to unbreakable diamond helmet
        set custom model data of {_item} to 108001
    else if {_piece} is "chestplate":
        set {_item} to unbreakable diamond chestplate
        set custom model data of {_item} to 108002
    else if {_piece} is "leggings":
        set {_item} to unbreakable diamond leggings
        set custom model data of {_item} to 108003
    else if {_piece} is "boots":
        set {_item} to unbreakable diamond boots
        set custom model data of {_item} to 108004
    else:
        return air

    # Visual-only Stage 6 identity. SkBee armor trim; no resource pack needed.
    set armor trim of {_item} to armor trim using minecraft:netherite_material and minecraft:silence_pattern

    set {_name} to diamondArmorDisplayName({_piece})
    set name of {_item} to "&6&l%{_name}%"

    if {_prot} is 1:
        enchant {_item} with protection 1
    else if {_prot} is 2:
        enchant {_item} with protection 2
    else if {_prot} is 3:
        enchant {_item} with protection 3
    else if {_prot} is 4:
        enchant {_item} with protection 4
    else if {_prot} >= 5:
        enchant {_item} with protection 5

    set {_reinforcement} to {box::%{_u}%::diamond-armor-reinforcement}
    set {_vitality} to {box::%{_u}%::diamond-armor-vitality}
    set {_static} to {box::%{_u}%::diamond-armor-static-guard}

    set lore of {_item} to "&8Stage 6 • Diamond", "&7Owner: &f%{_owner}%", "", "&7&lEQUIPMENT UPGRADES"
    if {_prot} <= 0:
        add "&7Prismatic Protection: &8Not Upgraded" to lore of {_item}
    else:
        add "&7Prismatic Protection: &f%{_prot}% &8/ &f5" to lore of {_item}
    add "&7Diamond Bulwark: &b%{_reinforcement}% &8/ &f3" to lore of {_item}
    add "&7Crystal Ward: &c%{_vitality}% &8/ &f3" to lore of {_item}
    add "&7Prismatic Reprisal: &6%{_static}% &8/ &f3" to lore of {_item}
    add "" to lore of {_item}
    add "&6Visual: &fNetherite Silence Trim" to lore of {_item}
    add "&6Full Set: &ePrismatic Diamond Aura" to lore of {_item}
    add "" to lore of {_item}
    add "&aUnbreakable &8• Infinite Durability" to lore of {_item}
    add "&cSoulbound &8• Cannot be traded" to lore of {_item}
    add "&8Bound ID: %{_u}%" to lore of {_item}
    return {_item}


function diamondHasArmorPiece(p: player, piece: text) :: boolean:
    # Normal inventory
    set {_slot} to 0
    while {_slot} <= 35:
        set {_found} to slot {_slot} of {_p}'s inventory
        if diamondIsArmor({_found}) is true:
            if diamondArmorPieceFromItem({_found}) is {_piece}:
                if diamondArmorBelongsTo({_found}, {_p}) is true:
                    return true
        add 1 to {_slot}

    # Equipped armor
    set {_found} to helmet of {_p}
    if diamondIsArmor({_found}) is true:
        if diamondArmorPieceFromItem({_found}) is {_piece}:
            if diamondArmorBelongsTo({_found}, {_p}) is true:
                return true

    set {_found} to chestplate of {_p}
    if diamondIsArmor({_found}) is true:
        if diamondArmorPieceFromItem({_found}) is {_piece}:
            if diamondArmorBelongsTo({_found}, {_p}) is true:
                return true

    set {_found} to leggings of {_p}
    if diamondIsArmor({_found}) is true:
        if diamondArmorPieceFromItem({_found}) is {_piece}:
            if diamondArmorBelongsTo({_found}, {_p}) is true:
                return true

    set {_found} to boots of {_p}
    if diamondIsArmor({_found}) is true:
        if diamondArmorPieceFromItem({_found}) is {_piece}:
            if diamondArmorBelongsTo({_found}, {_p}) is true:
                return true

    # Offhand
    set {_found} to offhand tool of {_p}
    if diamondIsArmor({_found}) is true:
        if diamondArmorPieceFromItem({_found}) is {_piece}:
            if diamondArmorBelongsTo({_found}, {_p}) is true:
                return true

    # Vanilla Ender Chest
    set {_slot} to 0
    while {_slot} <= 26:
        set {_found} to slot {_slot} of {_p}'s ender chest
        if diamondIsArmor({_found}) is true:
            if diamondArmorPieceFromItem({_found}) is {_piece}:
                if diamondArmorBelongsTo({_found}, {_p}) is true:
                    return true
        add 1 to {_slot}

    return false


function diamondGiveArmorPiece(p: player, piece: text):
    set {_u} to uuid of {_p}
    if {box::%{_u}%::diamond-armor::%{_piece}%} is not true:
        stop
    if diamondHasArmorPiece({_p}, {_piece}) is true:
        stop
    give diamondCreateArmor({_p}, {_piece}) to {_p}


# ============================================================
# DIAMOND-FORGED ARMOR COMBAT
# Set upgrades work only while wearing the player's own bound set.
# ============================================================

function diamondEquippedArmorCount(p: player) :: number:
    set {_count} to 0

    set {_helmet} to helmet of {_p}
    if diamondIsArmor({_helmet}) is true:
        if diamondArmorBelongsTo({_helmet}, {_p}) is true:
            add 1 to {_count}

    set {_chest} to chestplate of {_p}
    if diamondIsArmor({_chest}) is true:
        if diamondArmorBelongsTo({_chest}, {_p}) is true:
            add 1 to {_count}

    set {_legs} to leggings of {_p}
    if diamondIsArmor({_legs}) is true:
        if diamondArmorBelongsTo({_legs}, {_p}) is true:
            add 1 to {_count}

    set {_boots} to boots of {_p}
    if diamondIsArmor({_boots}) is true:
        if diamondArmorBelongsTo({_boots}, {_p}) is true:
            add 1 to {_count}

    return {_count}


function diamondWearingFullArmorSet(p: player) :: boolean:
    if diamondEquippedArmorCount({_p}) is 4:
        return true
    return false


# Cosmetic reward for wearing all 4 of the player's own Diamond-Forged pieces.
every 6 ticks:
    loop all players:
        if diamondWearingFullArmorSet(loop-player) is true:
            set {_base} to location of loop-player
            set {_angle} to {diamondstage::aura-angle::%uuid of loop-player%}
            if {_angle} is not set:
                set {_angle} to 0

            set {_radians} to {_angle} * 0.0174532925
            set {_x1} to cos({_radians}) * 0.65
            set {_z1} to sin({_radians}) * 0.65
            set {_x2} to cos({_radians} + 3.14159265) * 0.65
            set {_z2} to sin({_radians} + 3.14159265) * 0.65

            set {_p1} to {_base}
            add {_x1} to x-coordinate of {_p1}
            add 0.35 to y-coordinate of {_p1}
            add {_z1} to z-coordinate of {_p1}

            set {_p2} to {_base}
            add {_x2} to x-coordinate of {_p2}
            add 0.85 to y-coordinate of {_p2}
            add {_z2} to z-coordinate of {_p2}

            draw 1 enchant particle at {_p1} for loop-player
            draw 1 sculk soul particle at {_p2} for loop-player

            add 24 to {_angle}
            if {_angle} >= 360:
                subtract 360 from {_angle}
            set {diamondstage::aura-angle::%uuid of loop-player%} to {_angle}


function diamondRoyalGuardPercent(level: number) :: number:
    if {_level} is 1:
        return 3
    if {_level} is 2:
        return 6
    if {_level} >= 3:
        return 9
    return 0


function diamondStaticGuardChance(level: number) :: number:
    if {_level} is 1:
        return 40
    if {_level} is 2:
        return 70
    if {_level} >= 3:
        return 100
    return 0


function diamondGoldenHeartHeal(level: number) :: number:
    if {_level} is 1:
        return 1
    if {_level} is 2:
        return 2
    if {_level} >= 3:
        return 3
    return 0


on damage:
    if victim is not a player:
        stop

    set {_p} to victim
    set {_u} to uuid of {_p}
    set {_pieces} to diamondEquippedArmorCount({_p})

    if {_pieces} <= 0:
        stop

    # SOVEREIGN PLATING I-III
    # Scales with the number of bound Diamond pieces being worn.
    set {_plating} to {box::%{_u}%::diamond-armor-reinforcement}
    if {_plating} > 0:
        if {_plating} is 1:
            set {_fullPercent} to 4
        else if {_plating} is 2:
            set {_fullPercent} to 7
        else:
            set {_fullPercent} to 11

        set {_percent} to ({_fullPercent} * {_pieces}) / 4
        set {_reduction} to damage * ({_percent} / 100)
        subtract {_reduction} from damage

        # Full-set Diamond identity: a heavy hit can produce a short absorption shield.
        if {_pieces} is 4:
            if damage >= 5:
                if {diamondstage::sovereign-pulse-cooldown::%{_u}%} is not set:
                    execute console command "effect give %name of {_p}% minecraft:absorption 4 0 true"
                    set {diamondstage::sovereign-pulse-cooldown::%{_u}%} to true
                    send action bar "&b&lDIAMOND BULWARK &8• &fAbsorption pulse" to {_p}
                    wait 18 seconds
                    delete {diamondstage::sovereign-pulse-cooldown::%{_u}%}

    # PHOENIX WARD I-III
    # Diamond does not copy Copper's emergency heal: it grants temporary resistance.
    set {_ward} to {box::%{_u}%::diamond-armor-vitality}
    if {_ward} > 0:
        set {_healthPercent} to (health of {_p} * 100) / max health of {_p}
        if {_healthPercent} <= 40:
            if {diamondstage::phoenix-ward-cooldown::%{_u}%} is not set:
                if {_ward} is 1:
                    set {_seconds} to 2
                else if {_ward} is 2:
                    set {_seconds} to 3
                else:
                    set {_seconds} to 4

                execute console command "effect give %name of {_p}% minecraft:resistance %{_seconds}% 0 true"
                set {diamondstage::phoenix-ward-cooldown::%{_u}%} to true
                send action bar "&d&lCRYSTAL WARD &8• &fResistance activated" to {_p}
                play sound "item.totem.use" with volume 0.45 and pitch 1.45 to {_p}
                wait 22 seconds
                delete {diamondstage::phoenix-ward-cooldown::%{_u}%}

    # GOLDEN REPRISAL I-III
    # Marks an attacking player instead of copying Copper's Slowness disruption.
    if attacker is a player:
        set {_reprisal} to {box::%{_u}%::diamond-armor-static-guard}
        if {_reprisal} > 0:
            if {_reprisal} is 1:
                set {_chance} to 50
                set {_seconds} to 1
            else if {_reprisal} is 2:
                set {_chance} to 85
                set {_seconds} to 2
            else:
                set {_chance} to 125
                set {_seconds} to 3

            set {_roll} to random integer between 1 and 1000
            if {_roll} <= {_chance}:
                execute console command "effect give %name of attacker% minecraft:glowing %{_seconds}% 0 true"
                execute console command "effect give %name of attacker% minecraft:weakness %{_seconds}% 0 true"
                send action bar "&3&lPRISMATIC REPRISAL &8• &fAttacker marked" to {_p}
                play sound "block.amethyst_block.chime" with volume 0.5 and pitch 1.6 to {_p}


# ============================================================
# SKILL POINTS
# Same milediamond style as Woodland, but its own Diamond wallet.
# ============================================================

function diamondTotalBlocks(p: player) :: number:
    set {_u} to uuid of {_p}
    return {box::%{_u}%::diamond-ore-mined} + {box::%{_u}%::diamond-block-mined}


function diamondExpectedMiningPoints(blocks: number) :: number:
    if {_blocks} < 200:
        return 0
    if {_blocks} < 450:
        return 1
    if {_blocks} < 700:
        return 2
    if {_blocks} < 1000:
        return 3
    if {_blocks} < 1300:
        return 4
    set {_extra} to floor(({_blocks} - 1300) / 200)
    return 5 + {_extra}


every 2 seconds:
    loop all players:
        if diamondUnlocked(loop-player) is true:
            diamondInit(loop-player)
            set {_u} to uuid of loop-player
            set {_blocks} to diamondTotalBlocks(loop-player)
            set {_should} to diamondExpectedMiningPoints({_blocks})
            set {_earned} to {box::%{_u}%::diamond-skill-points-earned}

            if {_should} > {_earned}:
                set {_baseGive} to {_should} - {_earned}
                set {_skillMultiplier} to boxSkillMultiplier(loop-player)
                set {_give} to diamondBoostSkillPoints(loop-player, {_baseGive})

                if {_give} > 0:
                    add {_give} to {box::%{_u}%::diamond-skill-points}

                # Base milestone tracker remains unmultiplied so the same
                # mining milestone can never pay twice.
                set {box::%{_u}%::diamond-skill-points-earned} to {_should}

                send "" to loop-player
                if {_give} is 1:
                    send "&6&lDIAMOND SKILL POINT!" to loop-player
                    send "&7You earned &61 Skill Point&7." to loop-player
                else:
                    send "&6&lDIAMOND SKILL POINTS!" to loop-player
                    send "&7You earned &6%{_give}% Skill Points&7." to loop-player
                send "&7Skills Multiplier: &d%{_skillMultiplier}%x" to loop-player
                send "&7Available: &b%{box::%{_u}%::diamond-skill-points}%" to loop-player
                send "&7Use them at the &6Diamond Blacksmith&7." to loop-player
                send "" to loop-player
                send action bar "&6SKILL POINT EARNED &8• &f+%{_give}% &8• &d%{_skillMultiplier}%x Skills &8• &f%{box::%{_u}%::diamond-skill-points}% available" to loop-player
                play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.25 to loop-player


function diamondSkillCost(skill: text, nextLevel: number) :: number:
    if {_nextLevel} <= 0:
    
    # Crystal Burst = 35
    if {_skill} is "crystal-burst":
        if {_nextLevel} is 1:
            return 3
        if {_nextLevel} is 2:
            return 4
        if {_nextLevel} is 3:
            return 6
        if {_nextLevel} is 4:
            return 9
        return 13

    # Deep Focus = 42
    if {_skill} is "deep-focus":
        if {_nextLevel} is 1:
            return 3
        if {_nextLevel} is 2:
            return 5
        if {_nextLevel} is 3:
            return 8
        if {_nextLevel} is 4:
            return 11
        return 15

    return 0

    # Diamond Surge = 18
    if {_skill} is "conductive-chain":
        if {_nextLevel} is 1:
            return 1
        if {_nextLevel} is 2:
            return 2
        if {_nextLevel} is 3:
            return 3
        if {_nextLevel} is 4:
            return 5
        return 7

    # Prismatic Streak = 22
    if {_skill} is "oxidation":
        if {_nextLevel} is 1:
            return 2
        if {_nextLevel} is 2:
            return 3
        if {_nextLevel} is 3:
            return 4
        if {_nextLevel} is 4:
            return 6
        return 7

    # Gem Magnet = 28
    if {_skill} is "ore-magnet":
        if {_nextLevel} is 1:
            return 2
        if {_nextLevel} is 2:
            return 4
        if {_nextLevel} is 3:
            return 5
        if {_nextLevel} is 4:
            return 7
        return 10

    # Crystal Bank = 32
    if {_skill} is "voltage-bank":
        if {_nextLevel} is 1:
            return 3
        if {_nextLevel} is 2:
            return 4
        if {_nextLevel} is 3:
            return 6
        if {_nextLevel} is 4:
            return 8
        return 11

    # Emperor's Fortune = 40
    if {_skill} is "power-grid":
        if {_nextLevel} is 1:
            return 3
        if {_nextLevel} is 2:
            return 5
        if {_nextLevel} is 3:
            return 8
        if {_nextLevel} is 4:
            return 10
        return 14

    # Crystal Essence = 45
    if {_skill} is "essence-conductor":
        if {_nextLevel} is 1:
            return 4
        if {_nextLevel} is 2:
            return 6
        if {_nextLevel} is 3:
            return 8
        if {_nextLevel} is 4:
            return 12
        return 15

    return 0


function diamondSkillName(skill: text) :: text:
    if {_skill} is "conductive-chain":
        return "Diamond Surge"
    if {_skill} is "voltage-bank":
        return "Crystal Bank"
    if {_skill} is "oxidation":
        return "Prismatic Streak"
    if {_skill} is "essence-conductor":
        return "Crystal Essence"
    if {_skill} is "ore-magnet":
        return "Gem Magnet"
    if {_skill} is "power-grid":
        return "Emperor's Fortune"
    if {_skill} is "crystal-burst":
        return "Crystal Burst"
    if {_skill} is "deep-focus":
        return "Deep Focus"
    return "Diamond Skill"


