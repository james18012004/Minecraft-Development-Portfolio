    if {_level} is 1:
        return 140
    if {_level} is 2:
        return 125
    if {_level} is 3:
        return 110
    if {_level} is 4:
        return 95
    if {_level} is 5:
        return 80
    return 999999


function diamondCrystalBurstReward(level: number) :: number:
    if {_level} is 1:
        return 2
    if {_level} is 2:
        return 3
    if {_level} is 3:
        return 4
    if {_level} is 4:
        return 5
    if {_level} is 5:
        return 7
    return 0


function diamondDeepFocusNeeded(level: number) :: number:
    if {_level} is 1:
        return 180
    if {_level} is 2:
        return 165
    if {_level} is 3:
        return 150
    if {_level} is 4:
        return 135
    if {_level} is 5:
        return 120
    return 999999


function diamondDeepFocusXp(level: number) :: number:
    if {_level} is 1:
        return 60
    if {_level} is 2:
        return 90
    if {_level} is 3:
        return 130
    if {_level} is 4:
        return 180
    if {_level} is 5:
        return 250
    return 0

function diamondSkillPointsSpent(p: player) :: number:
    set {_u} to uuid of {_p}
    set {_spent} to 0

    loop "conductive-chain", "oxidation", "ore-magnet", "voltage-bank", "power-grid", "essence-conductor", "crystal-burst", "deep-focus":
        set {_skill} to loop-value
        set {_level} to {box::%{_u}%::diamond-skill::%{_skill}%}
        if {_level} is not set:
            set {_level} to 0
        loop {_level} times:
            add diamondSkillCost({_skill}, loop-number) to {_spent}

    return {_spent}

# ============================================================
# DIAMOND -> EMERALD STAGE PROGRESSION
# Uses the same proven stage progression structure as Iron.
# ============================================================

function diamondEmeraldUnlocked(p: player) :: boolean:
    set {_u} to uuid of {_p}

    if {box::%{_u}%::tier} is "Emerald":
        return true
    if {box::%{_u}%::tier} is "Nether":
        return true
    if {box::%{_u}%::tier} is "End":
        return true
    if {box::%{_u}%::tier} is "Deep Dark":
        return true
    return false


function diamondStageReady(p: player) :: boolean:
    set {_u} to uuid of {_p}

    if {box::%{_u}%::diamond-pickaxe-tier} < 5:
        return false

    set {_blocks} to diamondTotalBlocks({_p})
    if {_blocks} < {@diamond-stage-blocks-required}:
        return false

    set {_spent} to diamondSkillPointsSpent({_p})
    if {_spent} < {@diamond-stage-skill-points-spent-required}:
        return false

    return true


function diamondProgressItem(p: player) :: item:
    set {_u} to uuid of {_p}
    set {_pickaxeTier} to {box::%{_u}%::diamond-pickaxe-tier}
    set {_blocks} to diamondTotalBlocks({_p})
    set {_spent} to diamondSkillPointsSpent({_p})
    set {_moneyReward} to diamondBoostMoney({_p}, {@diamond-stage-money-reward})
    set {_xpReward} to diamondBoostXp({_p}, {@diamond-stage-xp-reward})

    if diamondEmeraldUnlocked({_p}) is true:
        set {_item} to lime dye named "&a&lDIAMOND COMPLETE"
        set lore of {_item} to "&7Highest Tier: &f%{box::%{_u}%::tier}%", "", "&a✔ Diamond Diamond Pickaxe", "&a✔ %{_blocks}% / {@diamond-stage-blocks-required} blocks", "&a✔ %{_spent}% / {@diamond-stage-skill-points-spent-required} Skill Points spent", "", "&7Emerald Stage has been unlocked."
        return {_item}

    if diamondStageReady({_p}) is true:
        set {_item} to emerald named "&a&lDIAMOND STAGE READY!"
        set lore of {_item} to "&7You have completed the", "&7Diamond Stage&7.", "", "&a✔ Diamond Diamond Pickaxe", "&a✔ %{_blocks}% / {@diamond-stage-blocks-required} blocks", "&a✔ %{_spent}% / {@diamond-stage-skill-points-spent-required} Skill Points spent", "", "&6Completion Reward:", "&a+$%{_moneyReward}%", "&b+%{_xpReward}% Box XP", "", "&eClick to unlock Emerald Stage."
        return {_item}

    set {_item} to barrier named "&c&lNEXT STAGE: EMERALD"

    if {_pickaxeTier} >= 5:
        set {_pickaxeLine} to "&a✔ Diamond Diamond Pickaxe"
    else:
        set {_pickaxeLine} to "&c✖ Diamond Diamond Pickaxe"

    if {_blocks} >= {@diamond-stage-blocks-required}:
        set {_blockLine} to "&a✔ %{_blocks}% / {@diamond-stage-blocks-required} blocks"
    else:
        set {_blockLine} to "&c✖ %{_blocks}% / {@diamond-stage-blocks-required} blocks"

    if {_spent} >= {@diamond-stage-skill-points-spent-required}:
        set {_skillLine} to "&a✔ %{_spent}% / {@diamond-stage-skill-points-spent-required} Skill Points spent"
    else:
        set {_skillLine} to "&c✖ %{_spent}% / {@diamond-stage-skill-points-spent-required} Skill Points spent"

    set lore of {_item} to "&7Complete Diamond to unlock", "&aEmerald Stage&7.", "", "%{_pickaxeLine}%", "%{_blockLine}%", "%{_skillLine}%", "", "&8All three requirements are needed."
    return {_item}

function diamondAdvanceToEmerald(p: player):
    if diamondEmeraldUnlocked({_p}) is true:
        send "&f&lDIAMOND &8» &aYou have already completed the Diamond Stage." to {_p}
        stop

    if diamondStageReady({_p}) is false:
        send "&f&lDIAMOND &8» &cYou have not completed all Diamond Stage requirements yet." to {_p}
        stop

    set {_u} to uuid of {_p}
    add diamondBoostMoney({_p}, {@diamond-stage-money-reward}) to balance of {_p}
    add diamondBoostXp({_p}, {@diamond-stage-xp-reward}) to {box::%{_u}%::xp}
    set {box::%{_u}%::tier} to "Emerald"

    set {_moneyReward} to diamondBoostMoney({_p}, {@diamond-stage-money-reward})
    set {_xpReward} to diamondBoostXp({_p}, {@diamond-stage-xp-reward})

    send "" to {_p}
    send "&6&lDIAMOND STAGE COMPLETE!" to {_p}
    send "&7You unlocked &aEmerald Stage&7." to {_p}
    send "&7Reward: &a$%{_moneyReward}% &8• &b+%{_xpReward}% Box XP" to {_p}
    send "" to {_p}
    play sound "ui.toast.challenge_complete" with volume 1 and pitch 1.1 to {_p}


# ============================================================
# GUI - SAME LAYOUT AS WOODLAND
# ============================================================

function diamondOpenBlacksmith(p: player):
    diamondInit({_p})
    if diamondUnlocked({_p}) is false:
        send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to {_p}
        stop

    set {_u} to uuid of {_p}
    set {_pickaxeTier} to {box::%{_u}%::diamond-pickaxe-tier}
    set {_swordTier} to {box::%{_u}%::diamond-sword-tier}
    set {_blocks} to diamondTotalBlocks({_p})
    set {_oreHeld} to diamondCountOre({_p})
    set {_ingotsHeld} to diamondCountIngots({_p})

    set {_gui} to chest inventory with 5 rows named "&6&lDIAMOND BLACKSMITH"
    loop 45 times:
        set slot (loop-number - 1) of {_gui} to light blue stained glass pane named " "
    loop 9 times:
        set slot (loop-number - 1) of {_gui} to blue stained glass pane named " "
    loop 9 times:
        set slot (36 + loop-number - 1) of {_gui} to blue stained glass pane named " "

    set {_profile} to book named "&6&lDIAMOND PROFILE"
    set lore of {_profile} to "&7Highest Stage: &f%{box::%{_u}%::tier}%", "", "&7Pickaxe Tier: &f%{_pickaxeTier}% &8/ &f5", "&7Sword Tier: &f%{_swordTier}% &8/ &f5", "&7Blocks Mined: &f%{_blocks}%", "", "&6Held Resources", "&7Diamond Ore: &f%{_oreHeld}%", "&7Diamonds: &f%{_ingotsHeld}%"
    set slot 4 of {_gui} to {_profile}

    set {_pickaxes} to diamond pickaxe named "&7&lDIAMOND PICKAXES"
    set lore of {_pickaxes} to "&7Pickaxes, reclaim and", "&7Diamond Pickaxe Skills.", "", "&eClick to open."
    set slot 11 of {_gui} to {_pickaxes}

    set {_swords} to diamond sword named "&c&lDIAMOND SWORDS"
    set lore of {_swords} to "&7Sword progression, reclaim", "&7and advanced Diamond combat upgrades.", "", "&6Prismatic Edge • Voidlight", "&bCrystal Momentum • Armor Shatter", "&aDiamond Tempo I-II", "", "&eClick to open."
    set slot 13 of {_gui} to {_swords}

    set {_armor} to diamond chestplate named "&6&lDIAMOND-FORGED ARMOR"
    set lore of {_armor} to "&7Helmet, Chestplate,", "&7Leggings and Boots.", "", "&6&lFULL SET BONUS", "&eWear all 4 Diamond-Forged pieces", "&eto activate a Prismatic Diamond Aura", "&earound your armor.", "", "&eClick to open."
    set slot 15 of {_gui} to {_armor}

    set {_food} to cooked beef named "&e&lDIAMOND FOOD"
    set lore of {_food} to "&7Bread and Steak.", "&7Purchased with money.", "", "&eClick to open."
    set slot 21 of {_gui} to {_food}

    set {_progress} to compass named "&b&lSTAGE PROGRESS"
    set lore of {_progress} to "&7View Diamond completion", "&7and unlock Emerald.", "", "&eClick to open."
    set slot 23 of {_gui} to {_progress}

    set {_backpackOre} to diamondBackpackOre({_p})
    set {_backpackDiamonds} to diamondBackpackDiamonds({_p})
    set {_backpack} to chest named "&b&lDIAMOND BACKPACK"
    set lore of {_backpack} to "&7Automatic overflow storage.", "", "&7Stored Diamond Ore: &f%{_backpackOre}%", "&7Stored Diamonds: &f%{_backpackDiamonds}%", "", "&7Overflow still counts for upgrades,", "&7Money, Box XP and progression.", "", "&eClick to view."
    set slot 25 of {_gui} to {_backpack}

    set {_guide} to nether star named "&b&lSTAGE 6 GUIDE"
    set lore of {_guide} to "&7Mine &bDiamond Ore &7and &bDiamond Blocks&7.", "&7Upgrade tools, gear and 8 mining skills.", "", "&aNext Stage: &2Emerald", "&7Requirement: Complete Stage 6."
    set slot 31 of {_gui} to {_guide}

    set slot 40 of {_gui} to barrier named "&c&lCLOSE"
    open {_gui} to {_p}

function diamondOpenPickaxes(p: player):
    if diamondUnlocked({_p}) is false:
        send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to {_p}
        stop

    diamondInit({_p})
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-pickaxe-tier}
    set {_points} to {box::%{_u}%::diamond-skill-points}

    set {_gui} to chest inventory with 5 rows named "{@pickaxe-gui-title}"
    loop 45 times:
        set slot (loop-number - 1) of {_gui} to light blue stained glass pane named " "
    loop 9 times:
        set slot (loop-number - 1) of {_gui} to blue stained glass pane named " "
    loop 9 times:
        set slot (36 + loop-number - 1) of {_gui} to blue stained glass pane named " "

    set {_profile} to book named "&7&lPICKAXE PROGRESS"
    set lore of {_profile} to "&7Current Pickaxe Tier: &f%{_tier}% &8/ &f5", "&7Skill Points: &b%{_points}%", "", "&7Manage permanent Pickaxe Skills", "&7inside this section.", "", "&b3x3 Mining: &aWooden + Stone only", "&8Iron, Golden and Diamond mine 1 block."
    set slot 4 of {_gui} to {_profile}

    set slot 10 of {_gui} to diamondGuiPickaxe({_p}, 1)
    set slot 12 of {_gui} to diamondGuiPickaxe({_p}, 2)
    set slot 14 of {_gui} to diamondGuiPickaxe({_p}, 3)
    set slot 16 of {_gui} to diamondGuiPickaxe({_p}, 4)
    set slot 22 of {_gui} to diamondGuiPickaxe({_p}, 5)

    set {_fortune} to diamondFortuneDrillItem({_p})
    set slot 29 of {_gui} to {_fortune}

    set {_skills} to enchanted book named "&d&lPICKAXE SKILLS"
    set lore of {_skills} to "&7Diamond Surge • Crystal Bank", "&7Prismatic Streak • Crystal Essence", "&7Gem Magnet • Emperor's Fortune", "&7Crystal Burst • Deep Focus", "", "&eClick to open."
    set slot 31 of {_gui} to {_skills}

    if {_tier} <= 0:
        set {_reclaim} to red stained glass pane named "&c&lNO PICKAXE UNLOCKED"
        set lore of {_reclaim} to "&7You have not unlocked a", "&7Diamond Pickaxe yet."
    else if diamondHasCurrentPickaxe({_p}) is true:
        set {_reclaim} to lime stained glass pane named "&a&lPICKAXE ALREADY OWNED"
        set lore of {_reclaim} to "&7Your current Diamond Pickaxe", "&7is already owned or stored."
    else:
        set {_reclaim} to recovery compass named "&a&lRECLAIM PICKAXE"
        set lore of {_reclaim} to "&7Your current Diamond Pickaxe", "&7is missing.", "", "&eClick to reclaim."
    set slot 33 of {_gui} to {_reclaim}

    set slot 36 of {_gui} to arrow named "&e&lBACK TO BLACKSMITH"
    set slot 44 of {_gui} to barrier named "&c&lCLOSE"
    open {_gui} to {_p}

function diamondSkillItem(p: player, skill: text, itemType: itemtype) :: item:
    set {_u} to uuid of {_p}
    set {_level} to {box::%{_u}%::diamond-skill::%{_skill}%}
    if {_level} is not set:
        set {_level} to 0

    set {_points} to {box::%{_u}%::diamond-skill-points}
    set {_pickaxeTier} to {box::%{_u}%::diamond-pickaxe-tier}
    set {_item} to {_itemType}

    if {_skill} is "conductive-chain":
        set name of {_item} to "&b&lDIAMOND SURGE"
        set lore of {_item} to "&7Diamond Ore builds an electrical", "&7chain. Complete it for", "&fbonus Diamond Ore &7and &bBox XP&7.", "&8Fast deterministic mining skill."
    else if {_skill} is "voltage-bank":
        set name of {_item} to "&3&lCRYSTAL BANK"
        set lore of {_item} to "&7Mining stores Voltage.", "&7A rare Diamond Block can", "&7discharge a full bank for &amoney&7.", "&8Rare-block interaction skill."
    else if {_skill} is "oxidation":
        set name of {_item} to "&d&lPRISMATIC STREAK"
        set lore of {_item} to "&7Long mining cycles advance", "&7through &f4 oxidation phases&7.", "&7Full oxidation pays Diamonds", "&7and money before resetting."
    else if {_skill} is "essence-conductor":
        set name of {_item} to "&d&lCRYSTAL ESSENCE"
        set lore of {_item} to "&7A tiny chance while mining", "&7to conduct &d1 Essence&7.", "&8Store credit • No daily limit."
    else if {_skill} is "ore-magnet":
        set name of {_item} to "&b&lGEM MAGNET"
        set lore of {_item} to "&7Deterministic mining cycles", "&7pull extra &fDiamond Ore", "&7and higher levels pull &6Diamonds&7.", "&8Resource gathering skill."
    else if {_skill} is "power-grid":
        set name of {_item} to "&e&lEMPEROR'S FORTUNE"
        set lore of {_item} to "&7Very long mining cycles charge", "&7the Stage 6 grid and award", "&eextra Diamond Skill Points&7.", "&8Long-term progression skill."
    else if {_skill} is "crystal-burst":
        set name of {_item} to "&b&lCRYSTAL BURST"
        set lore of {_item} to "&7Builds crystalline pressure while mining.", "&7When full, releases bonus &fDiamond Ore&7.", "&8Deterministic resource skill."
    else if {_skill} is "deep-focus":
        set name of {_item} to "&3&lDEEP FOCUS"
        set lore of {_item} to "&7Long mining focus cycles.", "&7Completing a cycle grants a burst", "&7of &bBox XP&7.", "&8Progression-focused skill."
    else:
        set name of {_item} to "&b&lDIAMOND SKILL"
        set lore of {_item} to "&7Unknown Diamond skill."

    if {_level} >= 5:
        add "" to lore of {_item}
        add "&aLevel: &f5/5 &8(MAX)" to lore of {_item}
        add "" to lore of {_item}
        add "&6&lMAX LEVEL EFFECT" to lore of {_item}

        if {_skill} is "conductive-chain":
            add "&7Every: &f%diamondChainNeeded(5)% Diamond Ore" to lore of {_item}
            add "&7Reward: &f+%diamondChainOreReward(5)% Ore &8• &b+%diamondChainXpReward(5)% XP" to lore of {_item}
        else if {_skill} is "voltage-bank":
            add "&7Bank Needed: &f%diamondVoltageNeeded(5)% Voltage" to lore of {_item}
            add "&7Discharge: &a+$%diamondVoltageMoney(5)%" to lore of {_item}
        else if {_skill} is "oxidation":
            add "&7Phase Every: &f%diamondGildedStreakNeeded(5)% blocks" to lore of {_item}
            add "&7Full Cycle: &f+%diamondGildedStreakRawReward(5)% Diamonds &8• &a+$%diamondGildedStreakMoneyReward(5)%" to lore of {_item}
        else if {_skill} is "essence-conductor":
            set {_essDisplay} to diamondEssenceChance(5) / 100
            add "&7Activation: &f%{_essDisplay}% PERCENT" to lore of {_item}
            add "&7Reward: &d1 Essence" to lore of {_item}
        else if {_skill} is "ore-magnet":
            add "&7Every: &f%diamondMagnetNeeded(5)% blocks" to lore of {_item}
            add "&7Reward: &f+%diamondMagnetOreReward(5)% Ore &8• &6+%diamondMagnetRawReward(5)% Diamonds" to lore of {_item}
        else if {_skill} is "power-grid":
            add "&7Every: &f%diamondGridNeeded(5)% blocks" to lore of {_item}
            add "&7Reward: &e+1 Diamond Skill Point" to lore of {_item}
        else if {_skill} is "crystal-burst":
            add "&7Every: &f%diamondCrystalBurstNeeded(5)% blocks" to lore of {_item}
            add "&7Reward: &f+%diamondCrystalBurstReward(5)% Diamond Ore" to lore of {_item}
        else if {_skill} is "deep-focus":
            add "&7Every: &f%diamondDeepFocusNeeded(5)% blocks" to lore of {_item}
            add "&7Reward: &b+%diamondDeepFocusXp(5)% Box XP" to lore of {_item}

        add "" to lore of {_item}
        add "&a✔ MAXED" to lore of {_item}
        return {_item}

    set {_next} to {_level} + 1
    set {_cost} to diamondSkillCost({_skill}, {_next})

    add "" to lore of {_item}
    add "&7Level: &f%{_level}% &8/ &f5" to lore of {_item}
    add "&7Next Level: &f%{_next}%" to lore of {_item}
    add "&7Cost: &b%{_cost}% Diamond Skill Points" to lore of {_item}
    add "&7Available: &b%{_points}%" to lore of {_item}

    add "" to lore of {_item}
    if {_pickaxeTier} < {_next}:
        add "&c✖ Requires Pickaxe Tier %{_next}%" to lore of {_item}
    else if {_points} < {_cost}:
        add "&c✖ Not enough Skill Points" to lore of {_item}
    else:
        add "&a✔ READY TO UPGRADE" to lore of {_item}
        add "&eClick to purchase." to lore of {_item}

    return {_item}


function diamondBuySkill(p: player, skill: text):
    if diamondUnlocked({_p}) is false:
        send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to {_p}
        stop

    diamondInit({_p})
    set {_u} to uuid of {_p}
    set {_name} to diamondSkillName({_skill})
    set {_current} to {box::%{_u}%::diamond-skill::%{_skill}%}
    if {_current} is not set:
        set {_current} to 0

    if {_current} >= 5:
        send "&f&l%{_name}% &8» &aThis skill is already max level." to {_p}
        stop

    set {_next} to {_current} + 1
    set {_cost} to diamondSkillCost({_skill}, {_next})
    set {_pickaxeTier} to {box::%{_u}%::diamond-pickaxe-tier}
    set {_points} to {box::%{_u}%::diamond-skill-points}

    if {_pickaxeTier} < {_next}:
        send "&f&l%{_name}% &8» &cYou need Diamond Pickaxe Tier %{_next}% first." to {_p}
        stop

    if {_points} < {_cost}:
        send "&f&l%{_name}% &8» &cNot enough Diamond Skill Points." to {_p}
        stop

    subtract {_cost} from {box::%{_u}%::diamond-skill-points}
    set {box::%{_u}%::diamond-skill::%{_skill}%} to {_next}

    # Refresh the player's current Diamond Pickaxe immediately so the
    # newly unlocked/leveled skill appears in the compact pickaxe lore.
    diamondGiveCurrentPickaxe({_p})

    send "" to {_p}
    send "&f&lDIAMOND SKILL UPGRADED!" to {_p}
    send "&7Skill: &f%{_name}%" to {_p}
    send "&7Level: &f%{_next}% &8/ &f5" to {_p}
    send "&7Cost: &b%{_cost}% Skill Points" to {_p}
    send "&7Remaining: &b%{box::%{_u}%::diamond-skill-points}%" to {_p}
    send "" to {_p}

    play sound "entity.player.levelup" with volume 1 and pitch 1.2 to {_p}
    wait 2 ticks
    diamondOpenSkills({_p})


function diamondOpenSkills(p: player):
    if diamondUnlocked({_p}) is false:
        send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to {_p}
        stop

    diamondInit({_p})
    set {_u} to uuid of {_p}
    set {_pickaxeTier} to {box::%{_u}%::diamond-pickaxe-tier}
    set {_points} to {box::%{_u}%::diamond-skill-points}
    set {_blocks} to diamondTotalBlocks({_p})

    if {_blocks} < 200:
        set {_nextPointAt} to 200
    else if {_blocks} < 450:
        set {_nextPointAt} to 450
    else if {_blocks} < 700:
        set {_nextPointAt} to 700
    else if {_blocks} < 1000:
        set {_nextPointAt} to 1000
    else if {_blocks} < 1300:
        set {_nextPointAt} to 1300
    else:
        set {_nextPointAt} to 1300 + ((floor(({_blocks} - 1300) / 200) + 1) * 200)

    set {_remainingBlocks} to {_nextPointAt} - {_blocks}

    set {_gui} to chest inventory with 5 rows named "&b&lDIAMOND SKILLS"
    loop 45 times:
        set slot (loop-number - 1) of {_gui} to light blue stained glass pane named " "
    loop 9 times:
        set slot (loop-number - 1) of {_gui} to blue stained glass pane named " "
    loop 9 times:
        set slot (36 + loop-number - 1) of {_gui} to blue stained glass pane named " "

    set {_profile} to experience bottle named "&b&lDIAMOND SKILL PROFILE"
    set lore of {_profile} to "&7Pickaxe Tier: &f%{_pickaxeTier}% &8/ &f5", "&7Skill Points: &b%{_points}%", "", "&7Stage Progress: &f%{_blocks}% blocks", "&7Next Skill Point: &f%{_remainingBlocks}% blocks", "", "&b8 permanent Diamond skills.", "&8Higher power, slower balanced activations."
    set slot 4 of {_gui} to {_profile}

    set slot 10 of {_gui} to diamondSkillItem({_p}, "conductive-chain", lightning rod)
    set slot 12 of {_gui} to diamondSkillItem({_p}, "voltage-bank", redstone)
    set slot 14 of {_gui} to diamondSkillItem({_p}, "oxidation", diamond block)
    set slot 16 of {_gui} to diamondSkillItem({_p}, "essence-conductor", amethyst shard)
    set slot 28 of {_gui} to diamondSkillItem({_p}, "ore-magnet", compass)
    set slot 30 of {_gui} to diamondSkillItem({_p}, "power-grid", daylight detector)
    set slot 32 of {_gui} to diamondSkillItem({_p}, "crystal-burst", prismarine crystals)
    set slot 34 of {_gui} to diamondSkillItem({_p}, "deep-focus", sculk sensor)

    set slot 36 of {_gui} to arrow named "&e&lBACK TO PICKAXES"
    set slot 44 of {_gui} to barrier named "&c&lCLOSE"
    open {_gui} to {_p}


function diamondSwordOreCost(tier: number) :: number:
    if {_tier} is 1:
        return {@sword-wooden-diamond-cost}
    if {_tier} is 2:
        return {@sword-stone-diamond-cost}
    if {_tier} is 3:
        return {@sword-iron-diamond-cost}
    if {_tier} is 4:
        return {@sword-golden-diamond-cost}
    if {_tier} is 5:
        return {@sword-diamond-diamond-cost}
    return 0


function diamondSwordIngotCost(tier: number) :: number:
    if {_tier} is 1:
        return {@sword-wooden-diamond-block-cost}
    if {_tier} is 2:
        return {@sword-stone-diamond-block-cost}
    if {_tier} is 3:
        return {@sword-iron-diamond-block-cost}
    if {_tier} is 4:
        return {@sword-golden-diamond-block-cost}
    if {_tier} is 5:
        return {@sword-diamond-diamond-block-cost}
    return 0


function diamondGuiSword(p: player, tier: number) :: item:
    set {_u} to uuid of {_p}
    set {_owned} to {box::%{_u}%::diamond-sword-tier}
    set {_item} to diamondCreateSword({_p}, {_tier})
    set {_oreCost} to diamondSwordOreCost({_tier})
    set {_ingotCost} to diamondSwordIngotCost({_tier})
    set {_oreHeld} to diamondCountOre({_p})
    set {_ingotsHeld} to diamondCountIngots({_p})

    set {_procChance} to diamondSwordProcChance({_tier}) / 10
    set {_bonusDamage} to diamondSwordBonusDamage({_tier})
    set lore of {_item} to "&8Diamond Sword Progression", "&7Tier: &f%{_tier}% &8/ &f5", "", "&6&lMIDAS STRIKE", "&7Proc Chance: &e%{_procChance}% PERCENT", "&7Bonus Damage: &c+%{_bonusDamage}%", "&8Tier 4+ also grants Speed I.", "&8Tier 5 marks the target briefly.", "", "&6&lRESOURCES", "&7Diamond Ore: &f%{_oreHeld}% &8/ &f%{_oreCost}%", "&7Diamonds: &f%{_ingotsHeld}% &8/ &f%{_ingotCost}%"

    # Wooden is the FIRST Diamond sword. There is no previous sword before it.
    if {_tier} is 1:
        if {_owned} <= 0:
            add "" to lore of {_item}
            if {_oreHeld} >= {_oreCost}:
                if {_ingotsHeld} >= {_ingotCost}:
                    add "&a✔ READY TO UNLOCK" to lore of {_item}
                    add "&eClick to purchase your first Diamond Stage sword." to lore of {_item}
                else:
                    add "&e▶ FIRST SWORD" to lore of {_item}
                    add "&cMore resources required." to lore of {_item}
            else:
                add "&e▶ FIRST SWORD" to lore of {_item}
                add "&cMore resources required." to lore of {_item}
        else if {_owned} is 1:
            add "" to lore of {_item}
            add "&a✔ CURRENT SWORD" to lore of {_item}
        else:
            add "" to lore of {_item}
            add "&a✔ COMPLETED" to lore of {_item}
        return {_item}

    if {_tier} < {_owned}:
        add "" to lore of {_item}
        add "&a✔ COMPLETED" to lore of {_item}
    else if {_tier} is {_owned}:
        add "" to lore of {_item}
        add "&a✔ CURRENT SWORD" to lore of {_item}
    else if {_tier} is {_owned} + 1:
        add "" to lore of {_item}
        if {_oreHeld} >= {_oreCost}:
            if {_ingotsHeld} >= {_ingotCost}:
                add "&a✔ READY TO UNLOCK" to lore of {_item}
                add "&eClick to purchase." to lore of {_item}
            else:
                add "&e▶ NEXT SWORD" to lore of {_item}
                add "&cMore resources required." to lore of {_item}
        else:
            add "&e▶ NEXT SWORD" to lore of {_item}
            add "&cMore resources required." to lore of {_item}
    else:
        add "" to lore of {_item}
        add "&c✖ LOCKED" to lore of {_item}
        add "&7Unlock the previous sword tier first." to lore of {_item}

    return {_item}

function diamondPurchaseSword(p: player, tier: number):
    diamondInit({_p})
    set {_u} to uuid of {_p}
    set {_current} to {box::%{_u}%::diamond-sword-tier}

    if {_tier} <= {_current}:
        send "&7&lDIAMOND &8» &cYou already own this sword tier." to {_p}
        stop

    # Wooden is the FIRST Diamond sword and can be purchased from tier 0.
    if {_tier} is 1:
        if {_current} is not 0:
            send "&7&lDIAMOND &8» &cYou already own this sword tier." to {_p}
            stop
    else:
        if {_tier} is not {_current} + 1:
            send "&7&lDIAMOND &8» &cYou must unlock the previous sword tier first." to {_p}
            stop

    set {_diamond} to diamondSwordOreCost({_tier})
    set {_diamondBlocks} to diamondSwordIngotCost({_tier})

    if diamondCountOre({_p}) < {_diamond}:
        send "&7&lDIAMOND SWORD &8» &cYou need more Diamond Ore." to {_p}
        stop
    if diamondCountIngots({_p}) < {_diamondBlocks}:
        send "&7&lDIAMOND SWORD &8» &cYou need more Diamonds." to {_p}
        stop

    diamondRemoveOreIncludingBackpack({_p}, {_diamond})
    diamondRemoveDiamondsIncludingBackpack({_p}, {_diamondBlocks})

    set {box::%{_u}%::diamond-sword-tier} to {_tier}
    diamondGiveCurrentSword({_p})
    set {_name} to diamondSwordTierName({_tier})
    send "&7&lDIAMOND &8» &aUnlocked the &f%{_name}% Diamond Sword&a!" to {_p}
    play sound "entity.player.levelup" with volume 1 and pitch 1.2 to {_p}
    diamondOpenSwords({_p})


function diamondArmorOreCost(piece: text) :: number:
    if {_piece} is "boots":
        return {@armor-boots-diamond-cost}
    if {_piece} is "helmet":
        return {@armor-helmet-diamond-cost}
    if {_piece} is "leggings":
        return {@armor-leggings-diamond-cost}
    if {_piece} is "chestplate":
        return {@armor-chestplate-diamond-cost}
    return 0


function diamondArmorIngotCost(piece: text) :: number:
    if {_piece} is "boots":
        return {@armor-boots-diamond-block-cost}
    if {_piece} is "helmet":
        return {@armor-helmet-diamond-block-cost}
    if {_piece} is "leggings":
        return {@armor-leggings-diamond-block-cost}
    if {_piece} is "chestplate":
        return {@armor-chestplate-diamond-block-cost}
    return 0


function diamondGuiArmor(p: player, piece: text) :: item:
    set {_u} to uuid of {_p}
    set {_item} to diamondCreateArmor({_p}, {_piece})
    set {_oreCost} to diamondArmorOreCost({_piece})
    set {_ingotCost} to diamondArmorIngotCost({_piece})
    set {_oreHeld} to diamondCountOre({_p})
    set {_ingotsHeld} to diamondCountIngots({_p})
    set {_prot} to {box::%{_u}%::diamond-armor-prot::%{_piece}%}

    set lore of {_item} to "&8Permanent Diamond Armor", "", "&6&lRESOURCES", "&7Diamond Ore: &f%{_oreHeld}% &8/ &f%{_oreCost}%", "&7Diamonds: &f%{_ingotsHeld}% &8/ &f%{_ingotCost}%", "", "&7Prismatic Protection: &f%{_prot}% &8/ &f4", "", "&6&lFULL SET BONUS", "&eWear all 4 Diamond-Forged pieces", "&eto activate a Prismatic Diamond Aura", "&earound your armor."

    if {box::%{_u}%::diamond-armor::%{_piece}%} is true:
        add "" to lore of {_item}
        add "&a✔ OWNED PERMANENTLY" to lore of {_item}
        if diamondHasArmorPiece({_p}, {_piece}) is false:
            add "&eClick to reclaim." to lore of {_item}
    else:
        add "" to lore of {_item}
        if {_oreHeld} >= {_oreCost}:
            if {_ingotsHeld} >= {_ingotCost}:
                add "&a✔ READY TO PURCHASE" to lore of {_item}
                add "&eClick to unlock." to lore of {_item}
            else:
                add "&cMore resources required." to lore of {_item}
        else:
            add "&cMore resources required." to lore of {_item}

    return {_item}

function diamondPurchaseArmor(p: player, piece: text):
    diamondInit({_p})
    set {_u} to uuid of {_p}

    if {box::%{_u}%::diamond-armor::%{_piece}%} is true:
        if diamondHasArmorPiece({_p}, {_piece}) is false:
            diamondGiveArmorPiece({_p}, {_piece})
            send "&7&lDIAMOND &8» &aYour %diamondArmorDisplayName({_piece})% was reclaimed." to {_p}
        else:
            send "&7&lDIAMOND &8» &cYou already have this armor piece." to {_p}
        wait 2 ticks
        diamondOpenArmor({_p})
        stop

    set {_diamond} to diamondArmorOreCost({_piece})
    set {_diamondBlocks} to diamondArmorIngotCost({_piece})

    if diamondCountOre({_p}) < {_diamond}:
        send "&7&lDIAMOND ARMOR &8» &cYou need more Diamond Ore." to {_p}
        stop
    if diamondCountIngots({_p}) < {_diamondBlocks}:
        send "&7&lDIAMOND ARMOR &8» &cYou need more Diamonds." to {_p}
        stop

    diamondRemoveOreIncludingBackpack({_p}, {_diamond})
    diamondRemoveDiamondsIncludingBackpack({_p}, {_diamondBlocks})

    set {box::%{_u}%::diamond-armor::%{_piece}%} to true
    diamondGiveArmorPiece({_p}, {_piece})
    set {_name} to diamondArmorDisplayName({_piece})
    send "&7&lDIAMOND &8» &aUnlocked &f%{_name}%&a permanently!" to {_p}
    play sound "entity.player.levelup" with volume 1 and pitch 1.2 to {_p}
    wait 2 ticks
    diamondOpenArmor({_p})


function diamondRefreshArmorPiece(p: player, piece: text):
    loop all items in {_p}'s inventory:
        if diamondIsArmor(loop-item) is true:
            if diamondArmorPieceFromItem(loop-item) is {_piece}:
                if diamondArmorBelongsTo(loop-item, {_p}) is true:
                    remove loop-item from {_p}'s inventory
    diamondGiveArmorPiece({_p}, {_piece})


