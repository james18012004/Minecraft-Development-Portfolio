    return 0


function diamondSwordCustomCap(upgrade: text, tier: number) :: number:
    if {_upgrade} is "conductivity":
        if {_tier} <= 1:
            return 0
        if {_tier} is 2:
            return 1
        if {_tier} <= 4:
            return 2
        return 3

    if {_upgrade} is "critical-edge":
        if {_tier} <= 2:
            return 0
        if {_tier} is 3:
            return 1
        if {_tier} is 4:
            return 2
        return 3

    if {_upgrade} is "executioner":
        if {_tier} <= 3:
            return 0
        if {_tier} is 4:
            return 1
        return 3

    return 0


function diamondSwordSharpnessItem(p: player) :: item:
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-sword-tier}
    set {_level} to {box::%{_u}%::diamond-sword-sharpness}
    set {_cap} to diamondSwordSharpnessCap({_tier})
    set {_item} to enchanted book named "&b&lPRISMATIC EDGE"

    if {_tier} <= 0:
        set lore of {_item} to "&7Diamond-forged base damage progression.", "", "&c✖ Purchase a Diamond Sword first."
        return {_item}

    if {_level} >= 5:
        set lore of {_item} to "&7Diamond-forged base damage progression.", "", "&7Current: &6Prismatic Edge V", "", "&a✔ MAX LEVEL"
        return {_item}

    if {_level} >= {_cap}:
        set lore of {_item} to "&7Diamond-forged base damage progression.", "", "&7Current: &f%{_level}% &8/ &f5", "&7Current Sword Tier cap: &f%{_cap}%", "", "&cUpgrade your Diamond Sword", "&cto unlock the next level."
        return {_item}

    set {_next} to {_level} + 1
    set {_cost} to diamondSwordSharpnessCost({_next})
    set lore of {_item} to "&7Diamond-forged base damage progression.", "", "&7Current: &f%{_level}% &8/ &f5", "&7Next: &6Prismatic Edge %{_next}%", "", "&6Cost: &a$%{_cost}%", "", "&e▶ Click to upgrade permanently."
    return {_item}


function diamondSwordCustomItem(p: player, upgrade: text, material: item type) :: item:
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-sword-tier}
    set {_item} to {_material}

    if {_upgrade} is "conductivity":
        set {_level} to {box::%{_u}%::diamond-sword-conductivity}
        set name of {_item} to "&b&lVOIDLIGHT"
        set {_desc1} to "&7Chance to ignite the enemy"
        set {_desc2} to "&7and deal a burst of bonus damage."
    else if {_upgrade} is "critical-edge":
        set {_level} to {box::%{_u}%::diamond-sword-critical-edge}
        set name of {_item} to "&3&lCRYSTAL MOMENTUM"
        set {_desc1} to "&7Build consecutive-hit momentum;"
        set {_desc2} to "&7the finishing hit bursts and grants Speed."
    else:
        set {_level} to {box::%{_u}%::diamond-sword-executioner}
        set name of {_item} to "&d&lARMOR SHATTER"
        set {_desc1} to "&7Deals increased opening damage against"
        set {_desc2} to "&7players at 75 PERCENT health or higher."

    if {_tier} <= 0:
        set lore of {_item} to {_desc1}, {_desc2}, "", "&c✖ Purchase a Diamond Sword first."
        return {_item}

    set {_cap} to diamondSwordCustomCap({_upgrade}, {_tier})

    if {_level} >= 3:
        set lore of {_item} to {_desc1}, {_desc2}, "", "&7Current: &fIII &8/ &fIII", "", "&a✔ MAX LEVEL"
        return {_item}

    if {_level} >= {_cap}:
        set lore of {_item} to {_desc1}, {_desc2}, "", "&7Current: &f%{_level}% &8/ &f3", "&7Current Sword Tier cap: &f%{_cap}%", "", "&cUpgrade your Diamond Sword tier", "&cto unlock the next level."
        return {_item}

    set {_next} to {_level} + 1
    set {_cost} to diamondSwordCustomCost({_upgrade}, {_next})

    if {_upgrade} is "conductivity":
        set {_effect1} to "&7Next level improves Voidlight"
        set {_effect2} to "&7proc chance, burn time and burst damage."
    else if {_upgrade} is "critical-edge":
        set {_effect1} to "&7Next level increases proc chance"
        set {_effect2} to "&7and critical bonus damage."
    else:
        set {_effect1} to "&7Next level increases damage against"
        set {_effect2} to "&7targets at 35 PERCENT health or lower."

    set lore of {_item} to {_desc1}, {_desc2}, "", "&7Current: &f%{_level}% &8/ &f3", {_effect1}, {_effect2}, "", "&6Cost: &a$%{_cost}%", "", "&e▶ Click to upgrade permanently."
    return {_item}


function diamondArmorProtectionItem(p: player, piece: text) :: item:
    set {_u} to uuid of {_p}
    set {_item} to diamondCreateArmor({_p}, {_piece})
    set {_name} to diamondArmorDisplayName({_piece})
    set name of {_item} to "&a&l%{_name}% PROTECTION"

    if {box::%{_u}%::diamond-armor::%{_piece}%} is not true:
        set lore of {_item} to "&7Permanent Prismatic Protection I-V.", "", "&c✖ Purchase this armor piece first."
        return {_item}

    set {_level} to {box::%{_u}%::diamond-armor-prot::%{_piece}%}

    if {_level} >= 5:
        set lore of {_item} to "&7Permanent Prismatic Protection I-V.", "", "&7Current: &6Prismatic Protection V", "", "&a✔ MAX LEVEL"
        return {_item}

    set {_next} to {_level} + 1
    set {_cost} to diamondArmorProtectionCost({_next})
    set lore of {_item} to "&7Permanent Prismatic Protection I-V.", "", "&7Current: &f%{_level}% &8/ &f5", "&7Next: &6Prismatic Protection %{_next}%", "", "&6Cost: &a$%{_cost}%", "", "&e▶ Click to upgrade permanently."
    return {_item}


function diamondOwnsFullArmor(p: player) :: boolean:
    set {_u} to uuid of {_p}
    if {box::%{_u}%::diamond-armor::helmet} is not true:
        return false
    if {box::%{_u}%::diamond-armor::chestplate} is not true:
        return false
    if {box::%{_u}%::diamond-armor::leggings} is not true:
        return false
    if {box::%{_u}%::diamond-armor::boots} is not true:
        return false
    return true


function diamondArmorSetUpgradeItem(p: player, upgrade: text, material: item type) :: item:
    set {_u} to uuid of {_p}
    set {_item} to {_material}

    if {_upgrade} is "reinforcement":
        set {_level} to {box::%{_u}%::diamond-armor-reinforcement}
        set name of {_item} to "&b&lDIAMOND BULWARK"
        set {_desc1} to "&7Reduces incoming damage and, with"
        set {_desc2} to "&7a full set, can trigger an Absorption pulse."
    else if {_upgrade} is "vitality":
        set {_level} to {box::%{_u}%::diamond-armor-vitality}
        set name of {_item} to "&d&lCRYSTAL WARD"
        set {_desc1} to "&7Below 40 PERCENT health, triggers"
        set {_desc2} to "&7short Resistance instead of healing."
    else:
        set {_level} to {box::%{_u}%::diamond-armor-static-guard}
        set name of {_item} to "&3&lPRISMATIC REPRISAL"
        set {_desc1} to "&7Chance when hit to mark the attacker"
        set {_desc2} to "&7with Glowing and a short Weakness effect."

    if diamondOwnsFullArmor({_p}) is false:
        set lore of {_item} to {_desc1}, {_desc2}, "", "&c✖ Own all 4 Diamond-Forged", "&carmor pieces to unlock."
        return {_item}

    if {_level} >= 3:
        set lore of {_item} to {_desc1}, {_desc2}, "", "&7Current: &fIII &8/ &fIII", "", "&a✔ MAX LEVEL"
        return {_item}

    set {_next} to {_level} + 1
    set {_cost} to diamondArmorSetCost({_upgrade}, {_next})
    set lore of {_item} to {_desc1}, {_desc2}, "", "&7Current: &f%{_level}% &8/ &f3", "", "&6Cost: &a$%{_cost}%", "", "&e▶ Click to upgrade permanently."
    return {_item}


function diamondPurchaseSharpness(p: player):
    diamondInit({_p})
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-sword-tier}

    if {_tier} <= 0:
        send "&7&lDIAMOND &8» &cPurchase a Diamond Sword first." to {_p}
        stop

    set {_level} to {box::%{_u}%::diamond-sword-sharpness}
    if {_level} >= 5:
        send "&7&lDIAMOND &8» &cPrismatic Edge is already maxed." to {_p}
        stop

    set {_cap} to diamondSwordSharpnessCap({_tier})
    set {_next} to {_level} + 1
    if {_next} > {_cap}:
        send "&7&lDIAMOND &8» &cUpgrade your Diamond Sword tier first." to {_p}
        stop

    set {_cost} to diamondSwordSharpnessCost({_next})
    if balance of {_p} < {_cost}:
        send "&7&lDIAMOND &8» &cYou need $%{_cost}% for this upgrade." to {_p}
        stop

    remove {_cost} from balance of {_p}
    set {box::%{_u}%::diamond-sword-sharpness} to {_next}
    diamondGiveCurrentSword({_p})

    send "&7&lDIAMOND &8» &aPurchased Prismatic Edge %{_next}% permanently." to {_p}
    play sound "block.anvil.use" with volume 1 and pitch 1.2 to {_p}
    wait 2 ticks
    diamondOpenSwordEnchant({_p})


function diamondPurchaseSwordCustom(p: player, upgrade: text):
    diamondInit({_p})
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-sword-tier}

    if {_tier} <= 0:
        send "&7&lDIAMOND &8» &cPurchase a Diamond Sword first." to {_p}
        stop

    if {_upgrade} is "conductivity":
        set {_level} to {box::%{_u}%::diamond-sword-conductivity}
    else if {_upgrade} is "critical-edge":
        set {_level} to {box::%{_u}%::diamond-sword-critical-edge}
    else:
        set {_level} to {box::%{_u}%::diamond-sword-executioner}

    if {_level} >= 3:
        send "&7&lDIAMOND &8» &cThat combat upgrade is already maxed." to {_p}
        stop

    set {_cap} to diamondSwordCustomCap({_upgrade}, {_tier})
    set {_next} to {_level} + 1
    if {_next} > {_cap}:
        send "&7&lDIAMOND &8» &cUpgrade your Diamond Sword tier first." to {_p}
        stop

    set {_cost} to diamondSwordCustomCost({_upgrade}, {_next})
    if balance of {_p} < {_cost}:
        send "&7&lDIAMOND &8» &cYou need $%{_cost}% for this upgrade." to {_p}
        stop

    remove {_cost} from balance of {_p}

    if {_upgrade} is "conductivity":
        set {box::%{_u}%::diamond-sword-conductivity} to {_next}
        set {_display} to "Voidlight"
    else if {_upgrade} is "critical-edge":
        set {box::%{_u}%::diamond-sword-critical-edge} to {_next}
        set {_display} to "Crystal Momentum"
    else:
        set {box::%{_u}%::diamond-sword-executioner} to {_next}
        set {_display} to "Armor Shatter"

    diamondGiveCurrentSword({_p})
    send "&7&lDIAMOND &8» &a%{_display}% upgraded to level %{_next}%." to {_p}
    play sound "block.anvil.use" with volume 1 and pitch 1.25 to {_p}
    wait 2 ticks
    diamondOpenSwordEnchant({_p})


function diamondPurchaseFortuneDrill(p: player):
    diamondInit({_p})
    set {_u} to uuid of {_p}

    if {box::%{_u}%::diamond-pickaxe-tier} <= 0:
        send "&7&lDIAMOND &8» &cYou need your Diamond Pickaxe first." to {_p}
        stop

    set {_level} to {box::%{_u}%::diamond-fortune-drill}
    if {_level} is not set:
        set {_level} to 0

    if {_level} >= 5:
        send "&7&lDIAMOND &8» &cPrismatic Fortune is already maxed." to {_p}
        stop

    set {_next} to {_level} + 1
    set {_cost} to diamondFortuneDrillCost({_next})

    if balance of {_p} < {_cost}:
        send "&7&lDIAMOND &8» &cYou need $%{_cost}% for this upgrade." to {_p}
        stop

    remove {_cost} from balance of {_p}
    set {box::%{_u}%::diamond-fortune-drill} to {_next}

    # Refresh once so Prismatic Fortune level updates in pickaxe lore.
    diamondGiveCurrentPickaxe({_p})

    set {_chance} to diamondFortuneDrillChance({_next})
    send "" to {_p}
    send "&6&lGILDED FORTUNE UPGRADED!" to {_p}
    send "&7Level: &a%{_next}% &8/ &f5" to {_p}
    send "&7Resource Proc Chance: &f%{_chance}% percent" to {_p}
    send "&7Diamond Ore Proc: &f+5 Diamond Ore" to {_p}
    send "&7Diamonds Proc: &f+3 Diamonds" to {_p}
    send "&7Bonus resources also award &aMoney &7and &bBox XP&7." to {_p}
    send "&7Bonus resources never count as extra physical stage blocks." to {_p}
    send "" to {_p}
    send action bar "&6GILDED FORTUNE &8• &aLEVEL %{_next}% UNLOCKED" to {_p}
    play sound "block.anvil.use" with volume 1 and pitch 1.2 to {_p}


function diamondPurchaseKnockback(p: player):
    diamondInit({_p})
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-sword-tier}

    if {_tier} <= 0:
        send "&7&lDIAMOND &8» &cPurchase a Diamond Sword first." to {_p}
        stop

    set {_level} to {box::%{_u}%::diamond-sword-knockback}
