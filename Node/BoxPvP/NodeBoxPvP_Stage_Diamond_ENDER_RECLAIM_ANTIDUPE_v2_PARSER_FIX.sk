function diamondPurchaseProtection(p: player, piece: text):
    diamondInit({_p})
    set {_u} to uuid of {_p}

    if {box::%{_u}%::diamond-armor::%{_piece}%} is not true:
        send "&7&lDIAMOND &8» &cPurchase that armor piece first." to {_p}
        stop

    set {_level} to {box::%{_u}%::diamond-armor-prot::%{_piece}%}
    if {_level} >= 4:
        send "&7&lDIAMOND &8» &cPrismatic Protection is already maxed on that piece." to {_p}
        stop

    set {_next} to {_level} + 1
    set {_cost} to diamondArmorProtectionCost({_next})
    if balance of {_p} < {_cost}:
        send "&7&lDIAMOND &8» &cYou need $%{_cost}% for this upgrade." to {_p}
        stop

    remove {_cost} from balance of {_p}
    set {box::%{_u}%::diamond-armor-prot::%{_piece}%} to {_next}
    diamondRefreshArmorPiece({_p}, {_piece})

    set {_name} to diamondArmorDisplayName({_piece})
    send "&7&lDIAMOND &8» &a%{_name}% upgraded to Prismatic Protection %{_next}%." to {_p}
    play sound "block.anvil.use" with volume 1 and pitch 1.2 to {_p}
    wait 2 ticks
    diamondOpenArmorEnchants({_p})


function diamondPurchaseArmorSetUpgrade(p: player, upgrade: text):
    diamondInit({_p})
    set {_u} to uuid of {_p}

    if diamondOwnsFullArmor({_p}) is false:
        send "&7&lDIAMOND &8» &cOwn all 4 Diamond-Forged armor pieces first." to {_p}
        stop

    if {_upgrade} is "reinforcement":
        set {_level} to {box::%{_u}%::diamond-armor-reinforcement}
    else if {_upgrade} is "vitality":
        set {_level} to {box::%{_u}%::diamond-armor-vitality}
    else:
        set {_level} to {box::%{_u}%::diamond-armor-static-guard}

    if {_level} >= 3:
        send "&7&lDIAMOND &8» &cThat armor upgrade is already maxed." to {_p}
        stop

    set {_next} to {_level} + 1
    set {_cost} to diamondArmorSetCost({_upgrade}, {_next})
    if balance of {_p} < {_cost}:
        send "&7&lDIAMOND &8» &cYou need $%{_cost}% for this upgrade." to {_p}
        stop

    remove {_cost} from balance of {_p}

    if {_upgrade} is "reinforcement":
        set {box::%{_u}%::diamond-armor-reinforcement} to {_next}
        set {_display} to "Diamond Bulwark"
    else if {_upgrade} is "vitality":
        set {box::%{_u}%::diamond-armor-vitality} to {_next}
        set {_display} to "Crystal Ward"
    else:
        set {box::%{_u}%::diamond-armor-static-guard} to {_next}
        set {_display} to "Prismatic Reprisal"

    diamondRefreshArmorPiece({_p}, "helmet")
    diamondRefreshArmorPiece({_p}, "chestplate")
    diamondRefreshArmorPiece({_p}, "leggings")
    diamondRefreshArmorPiece({_p}, "boots")

    send "&7&lDIAMOND &8» &a%{_display}% upgraded to level %{_next}%." to {_p}
    play sound "block.anvil.use" with volume 1 and pitch 1.25 to {_p}
    wait 2 ticks
    diamondOpenArmorEnchants({_p})


function diamondOpenSwordEnchant(p: player):
    if diamondUnlocked({_p}) is false:
        stop

    set {_gui} to chest inventory with 4 rows named "&d&lDIAMOND SWORD UPGRADES"
    loop 36 times:
        set slot (loop-number - 1) of {_gui} to light blue stained glass pane named " "
    loop 9 times:
        set slot (loop-number - 1) of {_gui} to blue stained glass pane named " "
    loop 9 times:
        set slot (27 + loop-number - 1) of {_gui} to blue stained glass pane named " "

    set {_info} to book named "&6&lDIAMOND WEAPON FORGE"
    set lore of {_info} to "&7Diamond introduces advanced combat", "&7upgrades that remain permanent.", "", "&fUpgrade your Sword Tier to unlock", "&fstronger upgrade levels."
    set slot 4 of {_gui} to {_info}

    set slot 10 of {_gui} to diamondSwordSharpnessItem({_p})
    set slot 12 of {_gui} to diamondSwordCustomItem({_p}, "conductivity", lightning rod)
    set slot 14 of {_gui} to diamondSwordCustomItem({_p}, "critical-edge", iron sword)
    set slot 16 of {_gui} to diamondSwordCustomItem({_p}, "executioner", netherite sword)
    set slot 22 of {_gui} to diamondSwordKnockbackItem({_p})

    set slot 27 of {_gui} to arrow named "&e&lBACK TO SWORDS"
    set slot 35 of {_gui} to barrier named "&c&lCLOSE"
    open {_gui} to {_p}


function diamondOpenArmorEnchants(p: player):
    if diamondUnlocked({_p}) is false:
        stop

    set {_gui} to chest inventory with 5 rows named "&d&lDIAMOND ARMOR UPGRADES"
    loop 45 times:
        set slot (loop-number - 1) of {_gui} to light blue stained glass pane named " "
    loop 9 times:
        set slot (loop-number - 1) of {_gui} to blue stained glass pane named " "
    loop 9 times:
        set slot (36 + loop-number - 1) of {_gui} to blue stained glass pane named " "

    set {_info} to book named "&6&lDIAMOND ARMOR FORGE"
    set lore of {_info} to "&7Protection upgrades each piece.", "&7Set upgrades require ownership of", "&7all four Diamond-Forged pieces.", "", "&fSet effects work while your own", "&fDiamond-Forged armor is equipped."
    set slot 4 of {_gui} to {_info}

    set slot 10 of {_gui} to diamondArmorProtectionItem({_p}, "helmet")
    set slot 12 of {_gui} to diamondArmorProtectionItem({_p}, "chestplate")
    set slot 14 of {_gui} to diamondArmorProtectionItem({_p}, "leggings")
    set slot 16 of {_gui} to diamondArmorProtectionItem({_p}, "boots")

    set slot 20 of {_gui} to diamondArmorSetUpgradeItem({_p}, "reinforcement", anvil)
    set slot 22 of {_gui} to diamondArmorSetUpgradeItem({_p}, "vitality", golden apple)
    set slot 24 of {_gui} to diamondArmorSetUpgradeItem({_p}, "static-guard", lightning rod)

    set slot 36 of {_gui} to arrow named "&e&lBACK TO ARMOR"
    set slot 44 of {_gui} to barrier named "&c&lCLOSE"
    open {_gui} to {_p}


function diamondOpenSwords(p: player):
    if diamondUnlocked({_p}) is false:
        send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to {_p}
        stop

    diamondInit({_p})
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-sword-tier}
    set {_sharp} to {box::%{_u}%::diamond-sword-sharpness}

    set {_gui} to chest inventory with 5 rows named "&c&lDIAMOND SWORDS"
    loop 45 times:
        set slot (loop-number - 1) of {_gui} to light blue stained glass pane named " "
    loop 9 times:
        set slot (loop-number - 1) of {_gui} to blue stained glass pane named " "
    loop 9 times:
        set slot (36 + loop-number - 1) of {_gui} to blue stained glass pane named " "

    set {_profile} to book named "&c&lSWORD PROGRESS"
    set lore of {_profile} to "&7Current Sword Tier: &f%{_tier}% &8/ &f5", "&7Prismatic Edge: &f%{_sharp}% &8/ &f4"
    set slot 4 of {_gui} to {_profile}

    set slot 10 of {_gui} to diamondGuiSword({_p}, 1)
    set slot 12 of {_gui} to diamondGuiSword({_p}, 2)
    set slot 14 of {_gui} to diamondGuiSword({_p}, 3)
    set slot 16 of {_gui} to diamondGuiSword({_p}, 4)
    set slot 22 of {_gui} to diamondGuiSword({_p}, 5)

    set {_enchant} to enchanted book named "&d&lSWORD ENCHANTS"
    set lore of {_enchant} to "&7Professional Diamond weapon upgrades.", "", "&6Prismatic Edge I-V", "&6Voidlight I-III", "&bCrystal Momentum I-III", "&eArmor Shatter I-III", "&aDiamond Tempo I-II", "", "&eClick to open."
    set slot 31 of {_gui} to {_enchant}

    if {_tier} <= 0:
        set {_reclaim} to red stained glass pane named "&c&lNO SWORD UNLOCKED"
        set lore of {_reclaim} to "&7You have not unlocked a", "&7Diamond Sword yet."
    else if diamondHasCurrentSword({_p}) is true:
        set {_reclaim} to lime stained glass pane named "&a&lSWORD ALREADY OWNED"
        set lore of {_reclaim} to "&7Your current Diamond Sword", "&7is already owned or stored."
    else:
        set {_reclaim} to recovery compass named "&a&lRECLAIM SWORD"
        set lore of {_reclaim} to "&7Your current Diamond Sword", "&7is missing.", "", "&eClick to reclaim."
    set slot 33 of {_gui} to {_reclaim}

    set slot 36 of {_gui} to arrow named "&e&lBACK TO BLACKSMITH"
    set slot 44 of {_gui} to barrier named "&c&lCLOSE"
    open {_gui} to {_p}

function diamondOpenArmor(p: player):
    if diamondUnlocked({_p}) is false:
        send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to {_p}
        stop

    diamondInit({_p})
    set {_u} to uuid of {_p}
    set {_owned} to 0

    if {box::%{_u}%::diamond-armor::helmet} is true:
        add 1 to {_owned}
    if {box::%{_u}%::diamond-armor::chestplate} is true:
        add 1 to {_owned}
    if {box::%{_u}%::diamond-armor::leggings} is true:
        add 1 to {_owned}
    if {box::%{_u}%::diamond-armor::boots} is true:
        add 1 to {_owned}

    set {_gui} to chest inventory with 5 rows named "&6&lDIAMOND-FORGED ARMOR"
    loop 45 times:
        set slot (loop-number - 1) of {_gui} to light blue stained glass pane named " "
    loop 9 times:
        set slot (loop-number - 1) of {_gui} to blue stained glass pane named " "
    loop 9 times:
        set slot (36 + loop-number - 1) of {_gui} to blue stained glass pane named " "

    set {_info} to book named "&a&lARMOR PROGRESS"
    set lore of {_info} to "&7Pieces Unlocked: &f%{_owned}% &8/ &f4", "", "&7All armor is &aunbreakable", "&7and &csoulbound&7."
    set slot 4 of {_gui} to {_info}

    set slot 10 of {_gui} to diamondGuiArmor({_p}, "helmet")
    set slot 12 of {_gui} to diamondGuiArmor({_p}, "chestplate")
    set slot 14 of {_gui} to diamondGuiArmor({_p}, "leggings")
    set slot 16 of {_gui} to diamondGuiArmor({_p}, "boots")

    set {_enchant} to enchanted book named "&d&lARMOR ENCHANTS"
    set lore of {_enchant} to "&7Prismatic Protection I-V per armor piece.", "&7Advanced Diamond set upgrades.", "", "&bDiamond Bulwark I-III", "&cCrystal Ward I-III", "&6Prismatic Reprisal I-III", "", "&eClick to open."
    set slot 31 of {_gui} to {_enchant}

    if {_owned} <= 0:
        set {_reclaim} to red stained glass pane named "&c&lNO ARMOR UNLOCKED"
        set lore of {_reclaim} to "&7You have not unlocked any", "&7Diamond Armor yet."
    else:
        set {_missing} to false

        if {box::%{_u}%::diamond-armor::helmet} is true:
            if diamondHasArmorPiece({_p}, "helmet") is false:
                set {_missing} to true
        if {box::%{_u}%::diamond-armor::chestplate} is true:
            if diamondHasArmorPiece({_p}, "chestplate") is false:
                set {_missing} to true
        if {box::%{_u}%::diamond-armor::leggings} is true:
            if diamondHasArmorPiece({_p}, "leggings") is false:
                set {_missing} to true
        if {box::%{_u}%::diamond-armor::boots} is true:
            if diamondHasArmorPiece({_p}, "boots") is false:
                set {_missing} to true

        if {_missing} is true:
            set {_reclaim} to recovery compass named "&a&lRECLAIM ARMOR"
            set lore of {_reclaim} to "&7One or more unlocked pieces", "&7are missing.", "", "&eClick to reclaim."
        else:
            set {_reclaim} to lime stained glass pane named "&a&lARMOR ALREADY OWNED"
            set lore of {_reclaim} to "&7All unlocked Diamond Armor", "&7is already owned or stored."

    set slot 33 of {_gui} to {_reclaim}

    set slot 36 of {_gui} to arrow named "&e&lBACK TO BLACKSMITH"
    set slot 44 of {_gui} to barrier named "&c&lCLOSE"
    open {_gui} to {_p}

function diamondOpenFood(p: player):
    if diamondUnlocked({_p}) is false:
        send "&c&lLOCKED &8» &cComplete Gold Stage 5 first." to {_p}
        stop

    set {_gui} to chest inventory with 4 rows named "&b&lDIAMOND FOOD"
    loop 36 times:
        set slot (loop-number - 1) of {_gui} to light blue stained glass pane named " "

    loop 9 times:
        set slot (loop-number - 1) of {_gui} to blue stained glass pane named " "
    loop 9 times:
        set slot (27 + loop-number - 1) of {_gui} to blue stained glass pane named " "

    set {_info} to book named "&b&lDIAMOND PROVISIONS"
    set lore of {_info} to "&7Stage 6 combat supplies.", "", "&7Purchased using &amoney&7."
    set slot 4 of {_gui} to {_info}

