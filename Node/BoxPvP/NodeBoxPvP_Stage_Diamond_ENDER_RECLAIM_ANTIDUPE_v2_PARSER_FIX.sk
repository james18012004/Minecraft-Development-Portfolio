# ============================================================
# NODE BOXPVP - RECLAIM / ENDER CHEST ANTI-DUPE v2
# Parser-safe for this project: NO 'is similar to' comparisons.
# Uses each stage's existing tier + Bound ID ownership functions.
# Checks inventory, equipped gear, offhand and vanilla Ender Chest.
# Old DIFFERENT tiers do not block the player's current tier.
# ============================================================

# ============================================================
# STAGE 6 - DIAMOND
# Paper 1.21.11 / Skript 2.15.3 / SkBee / Vault / EssentialsX
#
# Mine resources: Diamond Ore + rare Diamond Blocks.
# Diamond Ore -> Diamond Ore item. Diamond Block -> Diamonds.
# Separate Stage 6 system; progression from Gold into Diamond.
# Woodland, Stone and Iron progress are NEVER reset by this file.
#
# Stage layout intentionally matches Woodland:
# - Main Diamond Blacksmith
# - Pickaxes -> Skills + Reclaim
# - Swords -> Enchants + Reclaim
# - Armor -> Enchants + Reclaim
# - Food
# - Stage Progress
# ============================================================

options:
    diamond-gui-title: &6&lDIAMOND BLACKSMITH
    pickaxe-gui-title: &6&lDIAMOND PICKAXES

    # Mine distribution
    diamond-ore-chance: 90
    diamond-block-chance: 10

    # Per physical block rewards
    diamond-ore-drop: 1
    diamond-block-drop: 6

    diamond-ore-money: 8.0
    diamond-block-money: 45.0

    diamond-ore-xp: 14
    diamond-block-xp: 80

    regen-percent: 10

    # Pickaxe costs - Diamond Ore + Diamonds
    # Tier 1 is the FREE stage starter pickaxe so players can begin mining.
    wooden-diamond-cost: 0
    wooden-diamond-block-cost: 0

    stone-diamond-cost: 700
    stone-diamond-block-cost: 160

    iron-diamond-cost: 1900
    iron-diamond-block-cost: 420

    golden-diamond-cost: 4300
    golden-diamond-block-cost: 950

    diamond-diamond-cost: 8500
    diamond-diamond-block-cost: 1900

    # Diamond swords
    sword-wooden-diamond-cost: 250
    sword-wooden-diamond-block-cost: 80

    sword-stone-diamond-cost: 700
    sword-stone-diamond-block-cost: 200

    sword-iron-diamond-cost: 1600
    sword-iron-diamond-block-cost: 450

    sword-golden-diamond-cost: 4300
    sword-golden-diamond-block-cost: 950

    sword-diamond-diamond-cost: 6500
    sword-diamond-diamond-block-cost: 1700

    # Diamond armor
    armor-boots-diamond-cost: 600
    armor-boots-diamond-block-cost: 160

    armor-helmet-diamond-cost: 800
    armor-helmet-diamond-block-cost: 220

    armor-leggings-diamond-cost: 1200
    armor-leggings-diamond-block-cost: 330

    armor-chestplate-diamond-cost: 1600
    armor-chestplate-diamond-block-cost: 450

    # Advanced Diamond equipment upgrades
    sword-sharpness-1-cost: 20000
    sword-sharpness-2-cost: 45000
    sword-sharpness-3-cost: 90000
    sword-sharpness-4-cost: 175000
    sword-sharpness-5-cost: 300000

    sword-conductivity-1-cost: 30000
    sword-conductivity-2-cost: 70000
    sword-conductivity-3-cost: 150000

    sword-critical-edge-1-cost: 40000
    sword-critical-edge-2-cost: 90000
    sword-critical-edge-3-cost: 190000

    sword-executioner-1-cost: 55000
    sword-executioner-2-cost: 120000
    sword-executioner-3-cost: 250000

    sword-knockback-1-cost: 50000
    sword-knockback-2-cost: 125000

    fortune-drill-1-cost: 10000
    fortune-drill-2-cost: 25000
    fortune-drill-3-cost: 50000
    fortune-drill-4-cost: 90000
    fortune-drill-5-cost: 150000

    armor-protection-1-cost: 15000
    armor-protection-2-cost: 35000
    armor-protection-3-cost: 70000
    armor-protection-4-cost: 140000
    armor-protection-5-cost: 240000

    armor-reinforcement-1-cost: 50000
    armor-reinforcement-2-cost: 110000
    armor-reinforcement-3-cost: 225000

    armor-vitality-1-cost: 65000
    armor-vitality-2-cost: 140000
    armor-vitality-3-cost: 285000

    armor-static-guard-1-cost: 60000
    armor-static-guard-2-cost: 130000
    armor-static-guard-3-cost: 265000

    # Food - same layout as Woodland/Stone
    bread-16-cost: 150
    steak-16-cost: 300
    golden-apple-cost: 1250
    enchanted-golden-apple-cost: 7500

    # Stage completion
    diamond-stage-blocks-required: 26000
    diamond-stage-skill-points-spent-required: 40
    diamond-stage-money-reward: 60000
    diamond-stage-xp-reward: 8500

    # FancyNPC
    diamond-npc-id: diamond_blacksmith


# ============================================================
# INITIALISE PLAYER
# ============================================================

function diamondInit(p: player):
    set {_u} to uuid of {_p}

    if {box::%{_u}%::diamond-ore-mined} is not set:
        set {box::%{_u}%::diamond-ore-mined} to 0
    if {box::%{_u}%::diamond-block-mined} is not set:
        set {box::%{_u}%::diamond-block-mined} to 0

    if {box::%{_u}%::diamond-pickaxe-tier} is not set:
        set {box::%{_u}%::diamond-pickaxe-tier} to 0

    if {box::%{_u}%::diamond-sword-tier} is not set:
        set {box::%{_u}%::diamond-sword-tier} to 0
    if {box::%{_u}%::diamond-sword-sharpness} is not set:
        set {box::%{_u}%::diamond-sword-sharpness} to 0
    if {box::%{_u}%::diamond-sword-conductivity} is not set:
        set {box::%{_u}%::diamond-sword-conductivity} to 0
    if {box::%{_u}%::diamond-sword-critical-edge} is not set:
        set {box::%{_u}%::diamond-sword-critical-edge} to 0
    if {box::%{_u}%::diamond-sword-executioner} is not set:
        set {box::%{_u}%::diamond-sword-executioner} to 0
    if {box::%{_u}%::diamond-sword-knockback} is not set:
        set {box::%{_u}%::diamond-sword-knockback} to 0
    if {box::%{_u}%::diamond-fortune-drill} is not set:
        set {box::%{_u}%::diamond-fortune-drill} to 0

    if {box::%{_u}%::diamond-armor::helmet} is not set:
        set {box::%{_u}%::diamond-armor::helmet} to false
    if {box::%{_u}%::diamond-armor::chestplate} is not set:
        set {box::%{_u}%::diamond-armor::chestplate} to false
    if {box::%{_u}%::diamond-armor::leggings} is not set:
        set {box::%{_u}%::diamond-armor::leggings} to false
    if {box::%{_u}%::diamond-armor::boots} is not set:
        set {box::%{_u}%::diamond-armor::boots} to false

    if {box::%{_u}%::diamond-armor-prot::helmet} is not set:
        set {box::%{_u}%::diamond-armor-prot::helmet} to 0
    if {box::%{_u}%::diamond-armor-prot::chestplate} is not set:
        set {box::%{_u}%::diamond-armor-prot::chestplate} to 0
    if {box::%{_u}%::diamond-armor-prot::leggings} is not set:
        set {box::%{_u}%::diamond-armor-prot::leggings} to 0
    if {box::%{_u}%::diamond-armor-prot::boots} is not set:
        set {box::%{_u}%::diamond-armor-prot::boots} to 0

    if {box::%{_u}%::diamond-armor-reinforcement} is not set:
        set {box::%{_u}%::diamond-armor-reinforcement} to 0
    if {box::%{_u}%::diamond-armor-vitality} is not set:
        set {box::%{_u}%::diamond-armor-vitality} to 0
    if {box::%{_u}%::diamond-armor-static-guard} is not set:
        set {box::%{_u}%::diamond-armor-static-guard} to 0

    if {box::%{_u}%::diamond-skill-points} is not set:
        set {box::%{_u}%::diamond-skill-points} to 0
    if {box::%{_u}%::diamond-skill-points-earned} is not set:
        set {box::%{_u}%::diamond-skill-points-earned} to 0
    if {box::%{_u}%::diamond-skill-point-fraction} is not set:
        set {box::%{_u}%::diamond-skill-point-fraction} to 0

    # Stage 6 Diamond skill tree
    if {box::%{_u}%::diamond-skill::conductive-chain} is not set:
        set {box::%{_u}%::diamond-skill::conductive-chain} to 0
    if {box::%{_u}%::diamond-skill::voltage-bank} is not set:
        set {box::%{_u}%::diamond-skill::voltage-bank} to 0
    if {box::%{_u}%::diamond-skill::oxidation} is not set:
        set {box::%{_u}%::diamond-skill::oxidation} to 0
    if {box::%{_u}%::diamond-skill::essence-conductor} is not set:
        set {box::%{_u}%::diamond-skill::essence-conductor} to 0
    if {box::%{_u}%::diamond-skill::ore-magnet} is not set:
        set {box::%{_u}%::diamond-skill::ore-magnet} to 0
    if {box::%{_u}%::diamond-skill::power-grid} is not set:
        set {box::%{_u}%::diamond-skill::power-grid} to 0
    if {box::%{_u}%::diamond-skill::crystal-burst} is not set:
        set {box::%{_u}%::diamond-skill::crystal-burst} to 0
    if {box::%{_u}%::diamond-skill::deep-focus} is not set:
