function diamondFortuneDrillItem(p: player) :: item:
    set {_u} to uuid of {_p}
    set {_level} to {box::%{_u}%::diamond-fortune-drill}
    if {_level} is not set:
        set {_level} to 0

    set {_item} to diamond pickaxe named "&b&lPRISMATIC FORTUNE"

    if {_level} >= 5:
        set lore of {_item} to "&7Permanent Diamond Pickaxe upgrade.", "&7Higher levels increase the chance", "&7of a powerful resource proc.", "", "&7Current: &aLevel V", "&7Proc Chance: &f14 percent", "", "&6&lPROC REWARDS", "&7Diamond Ore: &f+5 Ore", "&7Diamond Block: &f+3 Diamonds", "&7Bonus resources also award", "&amatching Money &7and &bBox XP&7.", "", "&8Bonus resources never count as", "&8physical stage progress.", "", "&aMAX LEVEL"
        return {_item}

    set {_next} to {_level} + 1
    set {_cost} to diamondFortuneDrillCost({_next})
    set {_chance} to diamondFortuneDrillChance({_next})

    set lore of {_item} to "&7Permanent Diamond Pickaxe upgrade.", "&7Higher levels increase the chance", "&7of a powerful resource proc.", "", "&7Current: &f%{_level}% &8/ &f5", "&7Next Proc Chance: &a%{_chance}% percent", "", "&6&lPROC REWARDS", "&7Diamond Ore: &f+5 Ore", "&7Diamond Block: &f+3 Diamonds", "&7Bonus resources also award", "&amatching Money &7and &bBox XP&7.", "", "&6Cost: &a$%{_cost}%", "", "&8Bonus resources never count as", "&8physical stage progress.", "", "&eClick to upgrade."
    return {_item}


function diamondSwordKnockbackCost(level: number) :: number:
    if {_level} is 1:
        return {@sword-knockback-1-cost}
    if {_level} is 2:
        return {@sword-knockback-2-cost}
    return 0


function diamondSwordKnockbackCap(tier: number) :: number:
    if {_tier} <= 1:
        return 0
    if {_tier} <= 3:
        return 1
    return 2


function diamondSwordKnockbackItem(p: player) :: item:
    set {_u} to uuid of {_p}
    set {_tier} to {box::%{_u}%::diamond-sword-tier}
    set {_level} to {box::%{_u}%::diamond-sword-knockback}
    set {_cap} to diamondSwordKnockbackCap({_tier})
    set {_item} to sugar named "&a&lKING'S TEMPO"

    if {_tier} <= 0:
        set lore of {_item} to "&7Adds a chance on player hit to gain", "&7a short burst of royal Speed.", "", "&c✖ Purchase a Diamond Sword first."
        return {_item}

    if {_level} >= 2:
        set lore of {_item} to "&7Adds a chance on player hit to gain", "&7a short burst of royal Speed.", "", "&7Current: &aDiamond Tempo II", "", "&a✔ MAX LEVEL"
        return {_item}

    if {_level} >= {_cap}:
        set lore of {_item} to "&7Adds a chance on player hit to gain", "&7a short burst of royal Speed.", "", "&7Current: &f%{_level}% &8/ &f2", "&7Current Sword Tier cap: &f%{_cap}%", "", "&cUpgrade your Diamond Sword tier", "&cto unlock the next level."
        return {_item}

    set {_next} to {_level} + 1
    set {_cost} to diamondSwordKnockbackCost({_next})
    set lore of {_item} to "&7Adds a chance on player hit to gain", "&7a short burst of royal Speed.", "", "&7Current: &f%{_level}% &8/ &f2", "&7Next: &aDiamond Tempo %{_next}%", "", "&6Cost: &a$%{_cost}%", "", "&e▶ Click to upgrade permanently."
    return {_item}


