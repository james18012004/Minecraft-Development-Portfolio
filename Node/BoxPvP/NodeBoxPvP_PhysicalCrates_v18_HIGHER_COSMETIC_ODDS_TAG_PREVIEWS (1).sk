        else if {_roll} <= 9730:
            nodeCrateGiveKey({_p}, "sovereign", 1)
            set {_reward} to "&6&l1x Sovereign Key"
            set {_jackpot} to true
        else if {_roll} <= 9800:
            if {minion::%uuid of {_p}%::owned} is true:
                nodeCrateGiveMoney({_p}, 3000000)
                set {_reward} to "&6&l$3,000,000 KOTH JACKPOT &7(&dMinion already owned&7)"
            else:
                execute console command "giveminingminion %{_p}%"
                set {_reward} to "&d&l✦ MINING MINION ✦"
                set {_minionWin} to true
            set {_jackpot} to true
        else if {_roll} <= 9950:
            boxGiveMoneyMultiplier({_p}, 2.0, 2700)
            boxGiveXpMultiplier({_p}, 2.0, 2700)
            boxGiveSkillMultiplier({_p}, 2.0, 2700)
            set {_reward} to "&6&lALL BOOSTERS &7• &f2.0x for 45m"
            set {_jackpot} to true
        else:
            nodeCrateGiveMoney({_p}, 3000000)
            set {_reward} to "&6&l$3,000,000 KOTH JACKPOT"
            set {_jackpot} to true

    set {_display} to nodeCrateDisplay({_crate})

    if name of {_p}'s current inventory contains "Opening":
        set slot 13 of {_p}'s current inventory to nether star named "%{_reward}%" with lore "&7Reward selected!", "", "&7From: %{_display}%"

    nodeCratePersonalReward({_p}, {_crate}, {_reward})
    play sound "ui.toast.challenge_complete" with volume 1 and pitch 1.15 to {_p}
    nodeCrateFirework({_p}, {_crate}, {_jackpot})

    if {_minionWin} is true:
        nodeCrateMinionCelebration({_p}, {_crate})
    else:
        if {_crate} is "koth":
            nodeCrateStartGG({_p}, {_crate}, {_reward})
        else if {_crate} is "multiplier":
            nodeCrateStartGG({_p}, {_crate}, {_reward})
        else if {_jackpot} is true:
            nodeCrateStartGG({_p}, {_crate}, {_reward})

# ============================================================
# PHYSICAL CRATE INTERACTION
# ============================================================

on right click:
    if clicked block is not set:
        stop

    set {_loc} to location of clicked block
    set {_crate} to "invalid"

    if {nodecrate::location::rift} is set:
        if {_loc} is {nodecrate::location::rift}:
            set {_crate} to "rift"

    if {nodecrate::location::vortex} is set:
        if {_loc} is {nodecrate::location::vortex}:
            set {_crate} to "vortex"

    if {nodecrate::location::ascendant} is set:
        if {_loc} is {nodecrate::location::ascendant}:
            set {_crate} to "ascendant"

    if {nodecrate::location::sovereign} is set:
        if {_loc} is {nodecrate::location::sovereign}:
            set {_crate} to "sovereign"

    if {nodecrate::location::multiplier} is set:
        if {_loc} is {nodecrate::location::multiplier}:
            set {_crate} to "multiplier"

    if {nodecrate::location::koth} is set:
        if {_loc} is {nodecrate::location::koth}:
            set {_crate} to "koth"

    if {_crate} is "invalid":
        stop

    cancel event

    if player is sneaking:
        nodeCratePreview(player, {_crate})
        stop

    nodeCrateStartOpening(player, {_crate})

on break:
    set {_loc} to location of event-block

    if {nodecrate::location::rift} is set:
        if {_loc} is {nodecrate::location::rift}:
            cancel event
            send "{@crates-prefix} &cThat physical crate is protected." to player
            stop

    if {nodecrate::location::vortex} is set:
        if {_loc} is {nodecrate::location::vortex}:
            cancel event
            send "{@crates-prefix} &cThat physical crate is protected." to player
            stop

    if {nodecrate::location::ascendant} is set:
        if {_loc} is {nodecrate::location::ascendant}:
            cancel event
            send "{@crates-prefix} &cThat physical crate is protected." to player
            stop

    if {nodecrate::location::sovereign} is set:
        if {_loc} is {nodecrate::location::sovereign}:
            cancel event
            send "{@crates-prefix} &cThat physical crate is protected." to player
            stop

    if {nodecrate::location::multiplier} is set:
        if {_loc} is {nodecrate::location::multiplier}:
            cancel event
            send "{@crates-prefix} &cThat physical crate is protected." to player
            stop

    if {nodecrate::location::koth} is set:
        if {_loc} is {nodecrate::location::koth}:
            cancel event
            send "{@crates-prefix} &cThat physical crate is protected." to player
            stop

# ============================================================
# GUI PROTECTION / NAVIGATION
# ============================================================

on inventory click:
    set {_title} to name of player's current inventory

    if {_title} is "{@crates-menu-title}":
        cancel event
        if event-item is air:
            stop

        if clicked slot is 19:
            nodeCratePreview(player, "rift")
            stop
        if clicked slot is 21:
            nodeCratePreview(player, "vortex")
            stop
        if clicked slot is 23:
            nodeCratePreview(player, "ascendant")
            stop
        if clicked slot is 25:
            nodeCratePreview(player, "sovereign")
            stop
        if clicked slot is 30:
            nodeCratePreview(player, "multiplier")
            stop
        if clicked slot is 32:
            nodeCratePreview(player, "koth")
            stop

        if clicked slot is 40:
            if {nodecrate::warp} is not set:
                send "{@crates-prefix} &cThe crate warp has not been set yet." to player
                stop
            if {box::%player's uuid%::combat} is set:
                if {box::%player's uuid%::combat} > 0:
                    send "{@crates-prefix} &cYou cannot teleport to crates while in combat." to player
                    stop
            close player's inventory
            teleport player to {nodecrate::warp}
            play sound "entity.enderman.teleport" with volume 1 and pitch 1.2 to player
            stop

        if clicked slot is 49:
            close player's inventory
            stop

    if {_title} contains "Preview":
        cancel event
        if event-item is air:
            stop
        if clicked slot is 39:
            nodeCrateOpenMain(player)
            stop
        if clicked slot is 41:
            close player's inventory
            stop

    if {_title} contains "Opening":
        cancel event
        stop

on inventory drag:
    set {_title} to name of player's current inventory

    if {_title} is "{@crates-menu-title}":
        cancel event

    if {_title} contains "Preview":
        cancel event

    if {_title} contains "Opening":
        cancel event

# ============================================================
# ADMIN COMMANDS
# ============================================================

command /cratekey <player> <text> <integer>:
    permission: op
    permission message: &cYou do not have permission.
    trigger:
        if arg-3 <= 0:
            send "{@crates-prefix} &cAmount must be at least 1." to player
            stop

        set {_crate} to nodeCrateType(arg-2)
        if {_crate} is "invalid":
            send "{@crates-prefix} &cUnknown crate. Use Rift, Vortex, Ascendant, Sovereign, Multiplier or KOTH." to player
            stop

        nodeCrateGiveKey(arg-1, {_crate}, arg-3)
        set {_display} to nodeCrateDisplay({_crate})

        send "{@crates-prefix} &aGave &f%arg-3%x %{_display}% &fKey&a to &f%arg-1%&a." to player
        send "{@crates-prefix} &7You received &f%arg-3%x %{_display}% &fKey&7." to arg-1
        play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.25 to arg-1

command /cratekeyall <text> <integer>:
    permission: op
    permission message: &cYou do not have permission.
    trigger:
        if arg-2 <= 0:
            send "{@crates-prefix} &cAmount must be at least 1." to player
            stop

        set {_crate} to nodeCrateType(arg-1)
        if {_crate} is "invalid":
            send "{@crates-prefix} &cUnknown crate. Use Rift, Vortex, Ascendant, Sovereign, Multiplier or KOTH." to player
            stop

        loop all players:
            nodeCrateGiveKey(loop-player, {_crate}, arg-2)
            play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.25 to loop-player

        set {_display} to nodeCrateDisplay({_crate})
        broadcast "&6&lKEYALL &8» &fEveryone &7received &f%arg-2%x %{_display}% &fKey&7!"

command /crateadmin <text> [<text>]:
    permission: op
    permission message: &cYou do not have permission.
    trigger:
        if arg-1 is "setwarp":
            set {nodecrate::warp} to location of player
            send "{@crates-prefix} &aCrate section warp set to your location." to player
            stop

        if arg-1 is "cleanupholograms":
            set {_removed} to nodeCrateCleanupLegacyHolograms()
            send "{@crates-prefix} &aRemoved old/orphaned crate holograms. &7Legacy stands found: &f%{_removed}%&7." to player
            stop

        if arg-1 is "refreshholograms":
            nodeCrateRefreshAllHolograms()
            send "{@crates-prefix} &aAll crate holograms refreshed." to player
            stop

        if arg-1 is "set":
            if arg-2 is not set:
                send "{@crates-prefix} &cUse /crateadmin set <crate> while looking at the crate block." to player
                stop

            set {_crate} to nodeCrateType(arg-2)
            if {_crate} is "invalid":
                send "{@crates-prefix} &cUnknown crate. Use Rift, Vortex, Ascendant, Sovereign, Multiplier or KOTH." to player
                stop

            set {_block} to targeted block of player
            if {_block} is air:
                send "{@crates-prefix} &cLook directly at the physical block you want to use." to player
                stop

            set {nodecrate::location::%{_crate}%} to location of {_block}

            set block at {nodecrate::location::%{_crate}%} to beacon

            nodeCrateRefreshHologram({_crate})

            set {_display} to nodeCrateDisplay({_crate})
            send "{@crates-prefix} &aPhysical %{_display}% &aset successfully." to player
            stop

        if arg-1 is "remove":
            if arg-2 is not set:
                send "{@crates-prefix} &cUse /crateadmin remove <crate>." to player
                stop

            set {_crate} to nodeCrateType(arg-2)
            if {_crate} is "invalid":
                send "{@crates-prefix} &cUnknown crate." to player
                stop

            set {_oldLoc} to {nodecrate::location::%{_crate}%}

            nodeCrateClearHologram({_crate})

            if {_oldLoc} is set:
                execute console command "execute positioned %x-coordinate of {_oldLoc}% %y-coordinate of {_oldLoc}% %z-coordinate of {_oldLoc}% run kill @e[type=minecraft:armor_stand,tag=nodecrate_hologram,distance=..4]"

            delete {nodecrate::location::%{_crate}%}
            delete {nodecrate::hologram::%{_crate}%::*}
            delete {nodecrate::hologramtitle::%{_crate}%}

            set {_display} to nodeCrateDisplay({_crate})
            send "{@crates-prefix} &cRemoved physical %{_display}%&c and cleared its hologram." to player
            stop

        send ""
        send "&6&lNODE CRATES ADMIN"
        send "&f/crateadmin set <crate> &8- &7Set looked-at physical crate"
        send "&f/crateadmin remove <crate> &8- &7Remove physical crate"
        send "&f/crateadmin setwarp &8- &7Set /crates teleport location"
        send "&f/crateadmin refreshholograms &8- &7Refresh every hologram"
        send "&f/crateadmin cleanupholograms &8- &7Remove stuck/orphaned crate holograms"
        send ""
        send "&f/cratekey <player> <crate> <amount>"
        send "&f/cratekeyall <crate> <amount>"
        send ""
        send "&7Crates: Rift, Vortex, Ascendant, Sovereign, Multiplier, KOTH"
        send ""
