
options:
    crates-prefix: &6&lCRATES &8»
    crates-menu-title: &5&l✦ NODE CRATES ✦

# ============================================================
# BASIC HELPERS
# ============================================================

function nodeCrateType(raw: text) :: text:
    set {_t} to lowercase {_raw}

    if {_t} is "rift":
        return "rift"
    if {_t} is "vortex":
        return "vortex"
    if {_t} is "ascendant":
        return "ascendant"
    if {_t} is "sovereign":
        return "sovereign"
    if {_t} is "multiplier":
        return "multiplier"
    if {_t} is "multipliers":
        return "multiplier"
    if {_t} is "koth":
        return "koth"

    return "invalid"

function nodeCrateDisplay(crate: text) :: text:
    if {_crate} is "rift":
        return "<##7C3AED>&lR<##8640EF>&lI<##9145F2>&lF<##9C4AF5>&lT <##A855F7>&lCRATE"
    if {_crate} is "vortex":
        return "<##06B6D4>&lV<##0CB4DF>&lO<##12B2E9>&lR<##1EAEF2>&lT<##2BA9FA>&lE<##38A3FF>&lX <##4D9CFF>&lCRATE"
    if {_crate} is "ascendant":
        return "<##67E8F9>&lA<##76E9F7>&lS<##85EAF4>&lC<##94EBF1>&lE<##A3ECEE>&lN<##B2EDEB>&lD<##C1EEE8>&lA<##D0EFE5>&lN<##DFF0E2>&lT <##EEF2FF>&lCRATE"
    if {_crate} is "sovereign":
        return "<##F59E0B>&lS<##F7A817>&lO<##F8B224>&lV<##F9BC30>&lE<##FBC63C>&lR<##FCD048>&lE<##FDD954>&lI<##FEE260>&lG<##FFEA6C>&lN <##FFF3A3>&lCRATE"
    if {_crate} is "multiplier":
        return "<##C026D3>&lM<##C936DC>&lU<##D246E5>&lL<##DB56EE>&lT<##E466F7>&lI<##E976F7>&lP<##E986EF>&lL<##E996E7>&lI<##E9A6DF>&lE<##E9B6D7>&lR <##67E8F9>&lCRATE"
    if {_crate} is "koth":
        return "<##EF4444>&lK<##F1533D>&lO<##F36236>&lT<##F5712F>&lH <##F59E0B>&lCRATE"
    return "&7&lUNKNOWN CRATE"

function nodeCrateShortColour(crate: text) :: text:
    if {_crate} is "rift":
        return "&5"
    if {_crate} is "vortex":
        return "&3"
    if {_crate} is "ascendant":
        return "&b"
    if {_crate} is "sovereign":
        return "&6"
    if {_crate} is "multiplier":
        return "&d"
    if {_crate} is "koth":
        return "&c"
    return "&7"

function nodeCrateKey(crate: text) :: item:
    set {_display} to nodeCrateDisplay({_crate})
    set {_key} to tripwire hook named "%{_display}% &fKey"
    set lore of {_key} to "&8Node BoxPvP Crate Key", "", "&7Use this key at the", "%{_display}%&7.", "", "&eRight-click the physical crate", "&eto open it."
    return {_key}

function nodeCrateHasKey(p: player, crate: text) :: boolean:
    set {_key} to nodeCrateKey({_crate})
    if {_p}'s inventory contains {_key}:
        return true
    return false

function nodeCrateTakeKey(p: player, crate: text):
    set {_key} to nodeCrateKey({_crate})
    remove 1 of {_key} from {_p}'s inventory

function nodeCrateGiveKey(p: player, crate: text, amount: number):
    set {_key} to nodeCrateKey({_crate})
    give {_amount} of {_key} to {_p}

function nodeCrateGiveMoney(p: player, amount: number):
    add {_amount} to balance of {_p}

function nodeCrateGiveBoxXp(p: player, amount: number):
    execute console command "giveboxxp %{_p}% %{_amount}%"

# ============================================================
# CRATE COSMETIC REWARD HELPER
# Uses the existing Cosmetics LuckPerms permissions.
# Duplicate cosmetic rolls become cash instead.
# ============================================================

function nodeCrateGiveCosmetic(p: player, perm: text, display: text, fallback: number) :: text:
    if {_p} has permission "%{_perm}%":
        nodeCrateGiveMoney({_p}, {_fallback})
        send "{@crates-prefix} &7You already own %{_display}%&7, so you received &a$%{_fallback}% &7instead." to {_p}
        return "&a$%{_fallback}% &7(&dDuplicate Cosmetic&7)"

    set {_u} to uuid of {_p}
    execute console command "lp user %{_u}% permission set %{_perm}% true"
    send "" to {_p}
    send "&d&l✦ COSMETIC UNLOCKED ✦" to {_p}
    send "&7You permanently unlocked %{_display}%&7!" to {_p}
    send "&7Equip it from &f/cosmetics&7." to {_p}
    send "" to {_p}
    send action bar "&dCOSMETIC UNLOCKED &8• %{_display}%" to {_p}
    play sound "ui.toast.challenge_complete" with volume 1 and pitch 1.2 to {_p}
    return "%{_display}%"

function nodeCrateBroadcastTop(p: player, crate: text, reward: text):
    set {_crateDisplay} to nodeCrateDisplay({_crate})
    broadcast "&6&l✦ CRATE JACKPOT ✦ &8» &f%{_p}% &7won %{_reward}% &7from %{_crateDisplay}%&7!"

function nodeCratePersonalReward(p: player, crate: text, reward: text):
    set {_crateDisplay} to nodeCrateDisplay({_crate})
    send "{@crates-prefix} &7You opened %{_crateDisplay}% &7and won %{_reward}%&7!" to {_p}
    send action bar "&6CRATE REWARD &8• %{_reward}%" to {_p}

function nodeCrateFirework(p: player, crate: text, jackpot: boolean):
    if {_crate} is "rift":
        launch flickering trailing burst firework colored purple and white at {_p}'s location with duration 1
    if {_crate} is "vortex":
        launch flickering trailing burst firework colored aqua and blue at {_p}'s location with duration 1
    if {_crate} is "ascendant":
        launch flickering trailing star firework colored aqua and white at {_p}'s location with duration 1
    if {_crate} is "sovereign":
        launch flickering trailing star firework colored yellow and white at {_p}'s location with duration 1
    if {_crate} is "multiplier":
        launch flickering trailing burst firework colored purple and aqua at {_p}'s location with duration 1
    if {_crate} is "koth":
        launch flickering trailing burst firework colored red and yellow at {_p}'s location with duration 1

    if {_jackpot} is true:
        wait 5 ticks
        if {_crate} is "rift":
            launch trailing ball firework colored purple at {_p}'s location with duration 1
        if {_crate} is "vortex":
            launch trailing ball firework colored blue at {_p}'s location with duration 1
        if {_crate} is "ascendant":
            launch trailing star firework colored aqua at {_p}'s location with duration 1
        if {_crate} is "sovereign":
            launch trailing star firework colored yellow at {_p}'s location with duration 1
        if {_crate} is "multiplier":
            launch trailing burst firework colored purple and pink at {_p}'s location with duration 1
        if {_crate} is "koth":
            launch trailing star firework colored red and yellow at {_p}'s location with duration 1


function nodeCrateGiveWarBow(p: player):
    set {_bow} to bow named "&c&lNODE WAR BOW"
    enchant {_bow} with power 5
    enchant {_bow} with unbreaking 3
    enchant {_bow} with punch 2
    enchant {_bow} with flame 1
    set lore of {_bow} to "&8Crate PvP Reward", "", "&7Power V", "&7Unbreaking III", "&7Punch II", "&7Flame I"
    give {_bow} to {_p}

function nodeCrateGiveFlightPack(p: player, rockets: number):
    give 1 elytra to {_p}
    give {_rockets} of firework rocket to {_p}

# ============================================================
# HOLOGRAMS
# ============================================================

function nodeCrateClearHologram(crate: text):
    loop {nodecrate::hologram::%{_crate}%::*}:
        if loop-value is set:
            kill loop-value

    if {nodecrate::location::%{_crate}%} is set:
        set {_loc} to {nodecrate::location::%{_crate}%}
        execute console command "execute positioned %x-coordinate of {_loc}% %y-coordinate of {_loc}% %z-coordinate of {_loc}% run kill @e[type=minecraft:armor_stand,tag=nodecrate_hologram,distance=..4]"

    delete {nodecrate::hologram::%{_crate}%::*}
    delete {nodecrate::hologramtitle::%{_crate}%}

function nodeCrateCleanupLegacyHolograms() :: number:
    set {_removed} to 0

    loop all entities:
        if loop-entity is armor stand:
            set {_rawName} to name of loop-entity

            if {_rawName} is set:
                set {_n} to uncolored {_rawName}
                set {_remove} to false

                if {_n} contains "RIFT":
                    if {_n} contains "CRATE":
                        set {_remove} to true

                if {_n} contains "VORTEX":
                    if {_n} contains "CRATE":
                        set {_remove} to true

                if {_n} contains "ASCENDANT":
                    if {_n} contains "CRATE":
                        set {_remove} to true

                if {_n} contains "SOVEREIGN":
                    if {_n} contains "CRATE":
                        set {_remove} to true

                if {_n} contains "MULTIPLIER":
                    if {_n} contains "CRATE":
                        set {_remove} to true

                if {_n} contains "KOTH":
                    if {_n} contains "CRATE":
                        set {_remove} to true

                # Catch any old crate title once RGB/legacy colours are stripped.
                if {_n} contains "CRATE":
                    if {_n} contains "RIFT":
                        set {_remove} to true
                    if {_n} contains "VORTEX":
                        set {_remove} to true
                    if {_n} contains "ASCENDANT":
                        set {_remove} to true
                    if {_n} contains "SOVEREIGN":
                        set {_remove} to true
                    if {_n} contains "MULTIPLIER":
                        set {_remove} to true
                    if {_n} contains "KOTH":
                        set {_remove} to true

                if {_n} contains "RIGHT-CLICK":
                    set {_remove} to true

                if {_n} contains "SHIFT-RIGHT-CLICK":
                    set {_remove} to true

                if {_n} contains "★":
                    set {_remove} to true

                if {_remove} is true:
                    kill loop-entity
                    add 1 to {_removed}

    execute console command "kill @e[type=minecraft:armor_stand,tag=nodecrate_hologram]"

    delete {nodecrate::hologram::*}
    delete {nodecrate::hologramtitle::*}

    return {_removed}

function nodeCrateSpawnHoloLine(crate: text, loc: location, text: text, titleLine: boolean):
    spawn armor stand at {_loc}
    set {_stand} to last spawned entity
    set name of {_stand} to colored {_text}
    execute console command "data merge entity %uuid of {_stand}% {Invisible:1b,Marker:1b,NoGravity:1b,CustomNameVisible:1b}"
    execute console command "tag %uuid of {_stand}% add nodecrate_hologram"
    add {_stand} to {nodecrate::hologram::%{_crate}%::*}

    if {_titleLine} is true:
        set {nodecrate::hologramtitle::%{_crate}%} to {_stand}

function nodeCrateStars(crate: text) :: text:
    if {_crate} is "rift":
        return "&e★&8★★★★"
    if {_crate} is "vortex":
        return "&e★★&8★★★"
    if {_crate} is "ascendant":
        return "&e★★★&8★★"
    if {_crate} is "sovereign":
        return "&e★★★★&8★"
    if {_crate} is "multiplier":
        return "&d★★★★★"
    if {_crate} is "koth":
        return "&6★★★★★"
    return "&8★★★★★"

function nodeCrateRefreshHologram(crate: text):
    nodeCrateClearHologram({_crate})

    if {nodecrate::location::%{_crate}%} is not set:
        stop

    set {_base} to {nodecrate::location::%{_crate}%}

    set {_line1} to {_base}
    add 2.20 to y-coordinate of {_line1}
    set {_line2} to {_base}
    add 1.90 to y-coordinate of {_line2}
    set {_line3} to {_base}
    add 1.60 to y-coordinate of {_line3}
    set {_line4} to {_base}
    add 1.30 to y-coordinate of {_line4}

    set {_display} to nodeCrateDisplay({_crate})
    set {_stars} to nodeCrateStars({_crate})

    nodeCrateSpawnHoloLine({_crate}, {_line1}, "%{_display}%", true)
    nodeCrateSpawnHoloLine({_crate}, {_line2}, "%{_stars}%", false)
    nodeCrateSpawnHoloLine({_crate}, {_line3}, "&f&lRIGHT-CLICK &8• &7Open Crate", false)
    nodeCrateSpawnHoloLine({_crate}, {_line4}, "&e&lSHIFT-RIGHT-CLICK &8• &7Preview Rewards", false)

function nodeCrateRefreshAllHolograms():
    nodeCrateRefreshHologram("rift")
    nodeCrateRefreshHologram("vortex")
    nodeCrateRefreshHologram("ascendant")
    nodeCrateRefreshHologram("sovereign")
    nodeCrateRefreshHologram("multiplier")
    nodeCrateRefreshHologram("koth")

on load:
    wait 20 ticks
    nodeCrateRefreshAllHolograms()

# ============================================================
# PARTICLE ORBITS
# Tight moving particles around each physical crate.
# ============================================================

function nodeCrateOrbit(crate: text):
    if {nodecrate::location::%{_crate}%} is not set:
        stop

    set {_base} to {nodecrate::location::%{_crate}%}

    if {nodecrate::particlephase} is not set:
        set {nodecrate::particlephase} to 1

    set {_phase} to {nodecrate::particlephase}

    set {_a} to {_base}
    set {_b} to {_base}
    set {_c} to {_base}
    set {_d} to {_base}

    add 0.18 to y-coordinate of {_a}
    add 0.18 to y-coordinate of {_b}
    add 0.72 to y-coordinate of {_c}
    add 0.72 to y-coordinate of {_d}

    if {_phase} is 1:
        add 0.70 to x-coordinate of {_a}
        remove 0.70 from x-coordinate of {_b}
        add 0.70 to z-coordinate of {_c}
        remove 0.70 from z-coordinate of {_d}

    if {_phase} is 2:
        add 0.50 to x-coordinate of {_a}
        add 0.50 to z-coordinate of {_a}
        remove 0.50 from x-coordinate of {_b}
        remove 0.50 from z-coordinate of {_b}
        remove 0.50 from x-coordinate of {_c}
        add 0.50 to z-coordinate of {_c}
        add 0.50 to x-coordinate of {_d}
        remove 0.50 from z-coordinate of {_d}

    if {_phase} is 3:
        add 0.70 to z-coordinate of {_a}
        remove 0.70 from z-coordinate of {_b}
        remove 0.70 from x-coordinate of {_c}
        add 0.70 to x-coordinate of {_d}

    if {_phase} is 4:
        remove 0.50 from x-coordinate of {_a}
        add 0.50 to z-coordinate of {_a}
        add 0.50 to x-coordinate of {_b}
        remove 0.50 from z-coordinate of {_b}
        remove 0.50 from x-coordinate of {_c}
        remove 0.50 from z-coordinate of {_c}
        add 0.50 to x-coordinate of {_d}
        add 0.50 to z-coordinate of {_d}

    if {_phase} is 5:
        remove 0.70 from x-coordinate of {_a}
        add 0.70 to x-coordinate of {_b}
        remove 0.70 from z-coordinate of {_c}
        add 0.70 to z-coordinate of {_d}

    if {_phase} is 6:
        remove 0.50 from x-coordinate of {_a}
        remove 0.50 from z-coordinate of {_a}
        add 0.50 to x-coordinate of {_b}
        add 0.50 to z-coordinate of {_b}
        add 0.50 to x-coordinate of {_c}
        remove 0.50 from z-coordinate of {_c}
        remove 0.50 from x-coordinate of {_d}
        add 0.50 to z-coordinate of {_d}

    if {_phase} is 7:
        remove 0.70 from z-coordinate of {_a}
        add 0.70 to z-coordinate of {_b}
        add 0.70 to x-coordinate of {_c}
        remove 0.70 from x-coordinate of {_d}

    if {_phase} is 8:
        add 0.50 to x-coordinate of {_a}
        remove 0.50 from z-coordinate of {_a}
        remove 0.50 from x-coordinate of {_b}
        add 0.50 to z-coordinate of {_b}
        add 0.50 to x-coordinate of {_c}
        add 0.50 to z-coordinate of {_c}
        remove 0.50 from x-coordinate of {_d}
        remove 0.50 from z-coordinate of {_d}

    loop all players:
        if {_crate} is "rift":
            draw 1 enchant particle at {_a} for loop-player
            draw 1 enchant particle at {_b} for loop-player

        if {_crate} is "vortex":
            draw 1 electric spark particle at {_a} for loop-player
            draw 1 electric spark particle at {_b} for loop-player
            draw 1 electric spark particle at {_c} for loop-player

        if {_crate} is "ascendant":
            draw 1 wax on particle at {_a} for loop-player
            draw 1 wax off particle at {_b} for loop-player
            draw 1 wax on particle at {_c} for loop-player

        if {_crate} is "sovereign":
            draw 1 wax on particle at {_a} for loop-player
            draw 1 wax on particle at {_b} for loop-player
            draw 1 crit particle at {_c} for loop-player
            draw 1 crit particle at {_d} for loop-player

        if {_crate} is "multiplier":
            draw 1 enchant particle at {_a} for loop-player
            draw 1 electric spark particle at {_b} for loop-player
            draw 1 wax on particle at {_c} for loop-player
            draw 1 wax off particle at {_d} for loop-player

        if {_crate} is "koth":
            draw 2 crit particle at {_a} for loop-player
            draw 2 crit particle at {_b} for loop-player
            draw 1 electric spark particle at {_c} for loop-player
            draw 1 electric spark particle at {_d} for loop-player

every 5 ticks:
    add 1 to {nodecrate::particlephase}
    if {nodecrate::particlephase} > 8:
        set {nodecrate::particlephase} to 1

    nodeCrateOrbit("rift")
    nodeCrateOrbit("vortex")
    nodeCrateOrbit("ascendant")
    nodeCrateOrbit("sovereign")
    nodeCrateOrbit("multiplier")
    nodeCrateOrbit("koth")


# ============================================================
# SPECIAL CRATE HOLOGRAM ANIMATION
# Only Multiplier and KOTH animate.
# ============================================================

every 10 ticks:
    add 1 to {nodecrate::textphase}
    if {nodecrate::textphase} > 4:
        set {nodecrate::textphase} to 1

    if {nodecrate::hologramtitle::multiplier} is set:
        set {_m} to {nodecrate::hologramtitle::multiplier}
        if {_m} is alive:
            if {nodecrate::textphase} is 1:
                set name of {_m} to colored "<##C026D3>&lMULTIPLIER <##67E8F9>&lCRATE"
            if {nodecrate::textphase} is 2:
                set name of {_m} to colored "<##D946EF>&lMULTIPLIER <##38BDF8>&lCRATE"
            if {nodecrate::textphase} is 3:
                set name of {_m} to colored "<##A855F7>&lMULTIPLIER <##22D3EE>&lCRATE"
            if {nodecrate::textphase} is 4:
                set name of {_m} to colored "<##E879F9>&lMULTIPLIER <##7DD3FC>&lCRATE"

    if {nodecrate::hologramtitle::koth} is set:
        set {_k} to {nodecrate::hologramtitle::koth}
        if {_k} is alive:
            if {nodecrate::textphase} is 1:
                set name of {_k} to colored "<##EF4444>&lKOTH <##F59E0B>&lCRATE"
            if {nodecrate::textphase} is 2:
                set name of {_k} to colored "<##F97316>&lKOTH <##FACC15>&lCRATE"
            if {nodecrate::textphase} is 3:
                set name of {_k} to colored "<##DC2626>&lKOTH <##FB923C>&lCRATE"
            if {nodecrate::textphase} is 4:
                set name of {_k} to colored "<##F43F5E>&lKOTH <##FBBF24>&lCRATE"

# ============================================================
# MAIN /CRATES GUI
# ============================================================

function nodeCrateOpenMain(p: player):
    set {_gui} to chest inventory with 6 rows named "{@crates-menu-title}"

    loop 54 times:
        set slot (loop-number - 1) of {_gui} to black stained glass pane named " "

    set slot 0 of {_gui} to purple stained glass pane named " "
    set slot 1 of {_gui} to magenta stained glass pane named " "
    set slot 7 of {_gui} to magenta stained glass pane named " "
    set slot 8 of {_gui} to purple stained glass pane named " "
    set slot 45 of {_gui} to purple stained glass pane named " "
    set slot 46 of {_gui} to magenta stained glass pane named " "
    set slot 52 of {_gui} to magenta stained glass pane named " "
    set slot 53 of {_gui} to purple stained glass pane named " "

    set {_info} to nether star named "&d&lNODE CRATES"
    set lore of {_info} to "&8Physical BoxPvP Crates", "", "&7Every crate has its own:", "&f• Physical location", "&f• Animated particles", "&f• Hologram", "&f• Preview percentages", "&f• Reward pool", "&f• Jackpot rewards", "", "&7Click a crate below to preview it."
    set slot 4 of {_gui} to {_info}

    set {_crateGuiItem1} to ender chest named "&5&lRIFT CRATE"
    set lore of {_crateGuiItem1} to "&8Entry Crate", "", "&7Money, Box XP and smaller", "&7temporary boosters.", "", "&eClick to preview."
    set slot 19 of {_gui} to {_crateGuiItem1}
    set {_crateGuiItem2} to ender chest named "&3&lVORTEX CRATE"
    set lore of {_crateGuiItem2} to "&8Advanced Crate", "", "&7Better Money, XP and", "&7stronger booster chances.", "", "&eClick to preview."
    set slot 21 of {_gui} to {_crateGuiItem2}
    set {_crateGuiItem3} to ender chest named "&b&lASCENDANT CRATE"
    set lore of {_crateGuiItem3} to "&8High-Tier Crate", "", "&7Large rewards and strong", "&7temporary multipliers.", "", "&eClick to preview."
    set slot 23 of {_gui} to {_crateGuiItem3}
    set {_crateGuiItem4} to ender chest named "&6&lSOVEREIGN CRATE"
    set lore of {_crateGuiItem4} to "&8Elite Crate", "", "&7The strongest regular crate.", "&7Contains a &dvery rare Mining Minion&7.", "", "&eClick to preview."
    set slot 25 of {_gui} to {_crateGuiItem4}

    set {_crateGuiItem5} to amethyst block named "&d&lMULTIPLIER CRATE"
    set lore of {_crateGuiItem5} to "&8Booster-Only Crate", "", "&7Every reward is a temporary", "&7Money, XP or Skills multiplier.", "", "&eClick to preview."
    set slot 30 of {_gui} to {_crateGuiItem5}
    set {_crateGuiItem6} to redstone block named "&c&lKOTH CRATE"
    set lore of {_crateGuiItem6} to "&8Competitive Event Crate", "", "&7Exclusive high-value rewards", "&7for KOTH competition.", "&7Contains a &drare Mining Minion&7.", "", "&eClick to preview."
    set slot 32 of {_gui} to {_crateGuiItem6}

    set {_tp} to compass named "&a&lTELEPORT TO CRATES"
    set lore of {_tp} to "&7Teleport to the physical", "&7crate section.", "", "&eClick to teleport."
    set slot 40 of {_gui} to {_tp}

    set slot 49 of {_gui} to barrier named "&c&lCLOSE"

    open {_gui} to {_p}

command /crates:
    trigger:
        # Hard combat lock: /crates can NEVER be used while combat-tagged.
        if {box::%player's uuid%::combat} is set:
            if {box::%player's uuid%::combat} > 0:
                send "{@crates-prefix} &cYou cannot use /crates while in combat." to player
                play sound "entity.villager.no" with volume 1 and pitch 1 to player
                stop

        if {nodecrate::warp} is not set:
            send "{@crates-prefix} &cThe crate area has not been set yet." to player
            stop

        teleport player to {nodecrate::warp}
        play sound "entity.enderman.teleport" with volume 1 and pitch 1.2 to player
        send action bar "&dCRATES &8• &fTeleported to the crate area" to player

command /cratemenu:
    trigger:
        nodeCrateOpenMain(player)

command /cratepreview <text>:
    trigger:
        set {_crate} to nodeCrateType(arg-1)
        if {_crate} is "invalid":
            send "{@crates-prefix} &cUnknown crate. Use Rift, Vortex, Ascendant, Sovereign, Multiplier or KOTH." to player
            stop
        nodeCratePreview(player, {_crate})

# ============================================================
# PREVIEW GUI
# ============================================================

function nodeCratePreview(p: player, crate: text):
    set {_display} to nodeCrateDisplay({_crate})
    set {_gui} to chest inventory with 5 rows named "&8Preview • %{_display}%"

    loop 45 times:
        set slot (loop-number - 1) of {_gui} to black stained glass pane named " "

    set slot 0 of {_gui} to purple stained glass pane named " "
    set slot 1 of {_gui} to magenta stained glass pane named " "
    set slot 7 of {_gui} to magenta stained glass pane named " "
    set slot 8 of {_gui} to purple stained glass pane named " "
    set slot 36 of {_gui} to purple stained glass pane named " "
    set slot 37 of {_gui} to magenta stained glass pane named " "
    set slot 43 of {_gui} to magenta stained glass pane named " "
    set slot 44 of {_gui} to purple stained glass pane named " "

    set {_header} to beacon named "%{_display}%"
    set lore of {_header} to "&8Reward Preview", "", "&7Every reward below shows its", "&7exact selection chance.", "", "&fPreviewing never requires a key."
    set slot 4 of {_gui} to {_header}

    # ========================================================
    # RIFT - 13 rewards / 100%
    # ========================================================
    if {_crate} is "rift":
        set {_i} to gold nugget named "&a&l$20,000"
        set lore of {_i} to "&7Chance: &e18%%"
        set slot 10 of {_gui} to {_i}

        set {_i} to gold ingot named "&a&l$35,000"
        set lore of {_i} to "&7Chance: &e17%%"
        set slot 11 of {_gui} to {_i}

        set {_i} to gold ingot named "&a&l$60,000"
        set lore of {_i} to "&7Chance: &e12%%"
        set slot 12 of {_gui} to {_i}

        set {_i} to experience bottle named "&b&l400 BOX XP"
        set lore of {_i} to "&7Chance: &e16%%"
        set slot 13 of {_gui} to {_i}

        set {_i} to experience bottle named "&b&l800 BOX XP"
        set lore of {_i} to "&7Chance: &e13%%"
        set slot 14 of {_gui} to {_i}

        set {_i} to experience bottle named "&b&l1,500 BOX XP"
        set lore of {_i} to "&7Chance: &e8%%"
        set slot 15 of {_gui} to {_i}

        set {_i} to emerald named "&a&l1.25x MONEY"
        set lore of {_i} to "&7Chance: &e5%%", "&7Duration: &f15 minutes"
        set slot 16 of {_gui} to {_i}

        set {_i} to lapis lazuli named "&b&l1.25x XP"
        set lore of {_i} to "&7Chance: &e4%%", "&7Duration: &f15 minutes"
        set slot 19 of {_gui} to {_i}

        set {_i} to amethyst shard named "&d&l1.25x SKILLS"
        set lore of {_i} to "&7Chance: &e3%%", "&7Duration: &f15 minutes"
        set slot 20 of {_gui} to {_i}

        set {_i} to firework rocket named "&c&l32 FLIGHT ROCKETS"
        set lore of {_i} to "&7Chance: &e1%%"
        set slot 21 of {_gui} to {_i}

        set {_i} to name tag named "&8[<##581C87>&l✦ <##6D28D9>&lR<##7C3AED>&lI<##9333EA>&lF<##A855F7>&lT <##C084FC>&l✦&8]"
        set lore of {_i} to "&7Chance: &d2%%", "", "&7Tag Preview:", "&8[<##581C87>&l✦ <##6D28D9>&lR<##7C3AED>&lI<##9333EA>&lF<##A855F7>&lT <##C084FC>&l✦&8]", "", "&d&lPERMANENT COSMETIC", "&7Unlocks the Rift chat tag.", "&7Duplicate: &a$100,000"
        set slot 22 of {_gui} to {_i}

        set {_i} to tripwire hook named "&3&lVORTEX KEY"
        set lore of {_i} to "&7Chance: &e0.5%%", "", "&6&lTOP REWARD"
        set slot 23 of {_gui} to {_i}

