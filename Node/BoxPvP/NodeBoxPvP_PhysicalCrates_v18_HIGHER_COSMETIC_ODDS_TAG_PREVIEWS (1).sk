        else if {_roll} <= 9420:
            give 1 totem of undying to {_p}
            set {_reward} to "&e&lTotem of Undying"
        else if {_roll} <= 9520:
            set {_reward} to nodeCrateGiveCosmetic({_p}, "box.cosmetic.tag.victor", "&e&l★ VICTOR TAG", 1000000)
        else if {_roll} <= 9600:
