    set {_back} to arrow named "&e&lBACK"
    set lore of {_back} to "&7Return to the crate browser."
    set slot 39 of {_gui} to {_back}

    set {_info} to tripwire hook named "&a&lHOW TO OPEN"
    set lore of {_info} to "&7Get the matching physical key,", "&7then right-click the Beacon.", "", "&fPreviewing never requires a key."
    set slot 40 of {_gui} to {_info}

    set slot 41 of {_gui} to barrier named "&c&lCLOSE"

    open {_gui} to {_p}

# ============================================================
# OPENING ANIMATION
# ============================================================

function nodeCrateAnimationItem(crate: text, step: number) :: item:
    if {_step} is 1:
        return gold ingot named "&6&lROLLING..."
    if {_step} is 2:
        return experience bottle named "&b&lROLLING..."
    if {_step} is 3:
        return emerald named "&a&lROLLING..."
    if {_step} is 4:
        return tripwire hook named "&e&lROLLING..."
    if {_step} is 5:
        return amethyst shard named "&d&lROLLING..."
    if {_step} is 6:
        return gold block named "&6&lROLLING..."
    return nether star named "&f&lSELECTING REWARD..."

function nodeCrateStartOpening(p: player, crate: text):
    set {_u} to uuid of {_p}

    if {nodecrate::opening::%{_u}%} is true:
        send "{@crates-prefix} &cYou are already opening a crate." to {_p}
        stop

    if nodeCrateHasKey({_p}, {_crate}) is false:
        set {_neededDisplay} to nodeCrateDisplay({_crate})
        send "{@crates-prefix} &cYou need a %{_neededDisplay}% &cKey to open this crate." to {_p}
        play sound "entity.villager.no" with volume 1 and pitch 1 to {_p}
        stop

    set {nodecrate::opening::%{_u}%} to true
    nodeCrateTakeKey({_p}, {_crate})

    set {_title} to nodeCrateDisplay({_crate})
    set {_gui} to chest inventory with 3 rows named "&8Opening • %{_title}%"

    loop 27 times:
        set slot (loop-number - 1) of {_gui} to black stained glass pane named " "

    set {_header} to beacon named "%{_title}%"
    set lore of {_header} to "&7Rewards are rolling across the lane...", "", "&eThe winning reward lands in the middle."
    set slot 4 of {_gui} to {_header}

    # 9-slot reward reel across the full middle row.
    loop 9 times:
        set {_slot} to loop-number + 8
        set slot {_slot} of {_gui} to nodeCrateAnimationItem({_crate}, random integer between 1 and 6)

    set slot 13 of {_gui} to nether star named "&e&l▼ WINNER ▼" with lore "&7The final reward stops here."
    open {_gui} to {_p}

    play sound "block.note_block.pling" with volume 1 and pitch 0.8 to {_p}

    set {_spin} to 0
    while {_spin} < 34:
        wait 2 ticks

        if {_p} is not online:
            delete {nodecrate::opening::%{_u}%}
            stop

        if name of {_p}'s current inventory does not contain "Opening":
            delete {nodecrate::opening::%{_u}%}
            stop

        # Shift every visible reward one slot left.
        set {_i10} to slot 10 of {_p}'s current inventory
        set {_i11} to slot 11 of {_p}'s current inventory
        set {_i12} to slot 12 of {_p}'s current inventory
        set {_i13} to slot 13 of {_p}'s current inventory
        set {_i14} to slot 14 of {_p}'s current inventory
        set {_i15} to slot 15 of {_p}'s current inventory
        set {_i16} to slot 16 of {_p}'s current inventory
        set {_i17} to slot 17 of {_p}'s current inventory

        set slot 9 of {_p}'s current inventory to {_i10}
        set slot 10 of {_p}'s current inventory to {_i11}
        set slot 11 of {_p}'s current inventory to {_i12}
        set slot 12 of {_p}'s current inventory to {_i13}
        set slot 13 of {_p}'s current inventory to {_i14}
        set slot 14 of {_p}'s current inventory to {_i15}
        set slot 15 of {_p}'s current inventory to {_i16}
        set slot 16 of {_p}'s current inventory to {_i17}

        set {_step} to random integer between 1 and 6
        set slot 17 of {_p}'s current inventory to nodeCrateAnimationItem({_crate}, {_step})

        add 1 to {_spin}

        if {_spin} <= 14:
            play sound "block.note_block.hat" with volume 0.65 and pitch 1.6 to {_p}
            wait 1 tick
        else if {_spin} <= 24:
            play sound "block.note_block.hat" with volume 0.7 and pitch 1.4 to {_p}
            wait 2 ticks
        else if {_spin} <= 30:
            play sound "block.note_block.hat" with volume 0.8 and pitch 1.2 to {_p}
            wait 4 ticks
        else:
            play sound "block.note_block.hat" with volume 0.9 and pitch 1.0 to {_p}
            wait 6 ticks

    if {_p} is not online:
        delete {nodecrate::opening::%{_u}%}
        stop

    if name of {_p}'s current inventory does not contain "Opening":
        delete {nodecrate::opening::%{_u}%}
        stop

    # Clear surrounding reel slots before revealing the real reward.
    set slot 9 of {_p}'s current inventory to black stained glass pane named " "
    set slot 10 of {_p}'s current inventory to black stained glass pane named " "
    set slot 11 of {_p}'s current inventory to black stained glass pane named " "
    set slot 12 of {_p}'s current inventory to yellow stained glass pane named "&e&l▶"
    set slot 14 of {_p}'s current inventory to yellow stained glass pane named "&e&l◀"
    set slot 15 of {_p}'s current inventory to black stained glass pane named " "
    set slot 16 of {_p}'s current inventory to black stained glass pane named " "
    set slot 17 of {_p}'s current inventory to black stained glass pane named " "

    nodeCrateRoll({_p}, {_crate})
    delete {nodecrate::opening::%{_u}%}

# ============================================================
# MINING MINION ULTRA-RARE CELEBRATION
# Used only when the player ACTUALLY wins their first Mining Minion.
# ============================================================

function nodeCrateMinionCelebration(p: player, crate: text):
    set {_display} to nodeCrateDisplay({_crate})

    broadcast ""
    broadcast "&d&l✦✦✦ &6&lULTRA RARE CRATE WIN &d&l✦✦✦"
    broadcast "&f%{_p}% &7has won the &d&l✦ MINING MINION ✦ &7from %{_display}%&7!"
    broadcast "&eA one-per-player, Soulbound automated miner has been unlocked!"
    broadcast "&d&l✦✦✦ &6&lULTRA RARE CRATE WIN &d&l✦✦✦"
    broadcast ""

    loop all players:
        send action bar "&d&l✦ MINING MINION WON ✦ &8• &f%{_p}% &7from %{_display}%" to loop-player
        play sound "ui.toast.challenge_complete" with volume 1 and pitch 1.15 to loop-player

    # Large staged firework celebration around the winner.
    launch flickering trailing star firework colored purple and white at {_p}'s location with duration 1
    wait 4 ticks
    launch flickering trailing burst firework colored yellow and white at {_p}'s location with duration 1
    wait 4 ticks
    launch flickering trailing ball firework colored aqua and purple at {_p}'s location with duration 1
    wait 4 ticks
    launch flickering trailing star firework colored red and yellow at {_p}'s location with duration 1
    wait 4 ticks
    launch flickering trailing burst firework colored purple and pink at {_p}'s location with duration 1
    wait 4 ticks
    launch trailing star firework colored yellow and aqua at {_p}'s location with duration 1

    send "" to {_p}
    send "&d&l✦ MINING MINION UNLOCKED ✦" to {_p}
    send "&fThis is an &dULTRA RARE &fcrate reward." to {_p}
    send "&7Your Minion is Soulbound, one-per-player and permanently yours." to {_p}
    send "&7Use &f/minion &7to view your Minion information." to {_p}
    send "" to {_p}


# ============================================================
# CRATE GG CELEBRATION
# High-tier crate wins can start a short server-wide GG event.
# Each player can claim 1 Essence once by typing exactly "gg".
# ============================================================

function nodeCrateStartGG(p: player, crate: text, reward: text):
    set {_display} to nodeCrateDisplay({_crate})

    # Replace any older celebration cleanly.
    add 1 to {nodecrate::gg::id}
    set {_id} to {nodecrate::gg::id}

    set {nodecrate::gg::active} to true
    delete {nodecrate::gg::claimed::*}

    broadcast ""
    broadcast "&d&l✦ &b&lCRATE WIN &d&l✦ &8» &f%{_p}% &7won %{_reward}% &7from %{_display}%&7!"
    broadcast "&cG&6G&e! &aType &f&lGG &ain chat within &f10 seconds &ato receive &d+1 Essence&a!"
    broadcast ""

    # Bigger celebration on the winning player.
    launch flickering trailing burst firework colored purple and white at {_p}'s location with duration 1
    wait 4 ticks
    launch flickering trailing star firework colored yellow and white at {_p}'s location with duration 1
    wait 4 ticks
    launch flickering trailing ball firework colored aqua and purple at {_p}'s location with duration 1
    wait 4 ticks
    launch flickering trailing burst firework colored red and yellow at {_p}'s location with duration 1

    wait 188 ticks

    if {nodecrate::gg::active} is true:
        if {nodecrate::gg::id} is {_id}:
            set {nodecrate::gg::active} to false
            broadcast "&8[&dCrates&8] &7The &cG&6G&e! &7reward window has ended."
            delete {nodecrate::gg::claimed::*}

# ============================================================
# REWARD ROLLS
# Integer roll 1-100 = exact whole percent chances.
# ============================================================

function nodeCrateRoll(p: player, crate: text):
    set {_roll} to random integer between 1 and 10000
    set {_reward} to "&fUnknown Reward"
    set {_jackpot} to false
    set {_minionWin} to false

    # ---------------- RIFT ----------------
    if {_crate} is "rift":
        if {_roll} <= 1800:
            nodeCrateGiveMoney({_p}, 20000)
            set {_reward} to "&a$20,000"
        else if {_roll} <= 3500:
            nodeCrateGiveMoney({_p}, 35000)
            set {_reward} to "&a$35,000"
        else if {_roll} <= 4700:
            nodeCrateGiveMoney({_p}, 60000)
            set {_reward} to "&a$60,000"
        else if {_roll} <= 6300:
            nodeCrateGiveBoxXp({_p}, 400)
            set {_reward} to "&b400 Box XP"
        else if {_roll} <= 7600:
            nodeCrateGiveBoxXp({_p}, 800)
            set {_reward} to "&b800 Box XP"
        else if {_roll} <= 8400:
            nodeCrateGiveBoxXp({_p}, 1500)
            set {_reward} to "&b1,500 Box XP"
        else if {_roll} <= 8900:
            boxGiveMoneyMultiplier({_p}, 1.25, 900)
            set {_reward} to "&a1.25x Money &7for &f15m"
        else if {_roll} <= 9300:
            boxGiveXpMultiplier({_p}, 1.25, 900)
            set {_reward} to "&b1.25x XP &7for &f15m"
        else if {_roll} <= 9600:
            boxGiveSkillMultiplier({_p}, 1.25, 900)
            set {_reward} to "&d1.25x Skills &7for &f15m"
        else if {_roll} <= 9700:
            give 32 of firework rocket to {_p}
            set {_reward} to "&c32 Flight Rockets"
        else if {_roll} <= 9900:
            set {_reward} to nodeCrateGiveCosmetic({_p}, "box.cosmetic.tag.rift", "&5&l✦ RIFT TAG", 100000)
        else if {_roll} <= 9950:
            nodeCrateGiveKey({_p}, "vortex", 1)
            set {_reward} to "&3&l1x Vortex Key"
            set {_jackpot} to true
        else:
            nodeCrateGiveMoney({_p}, 250000)
